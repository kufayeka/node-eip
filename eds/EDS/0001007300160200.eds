$ Electronic Data Sheet for 9/Series Machine Tool Builder Panel (8520-MTBD)

[File]
DescText = "8520-MTBD 9/Series DeviceNet MTB Panel";
CreateDate = 05-19-1999;
CreateTime = 12:00:00;
ModDate = 07-12-1999;
ModTime = 12:00:00;
Revision = 1.0;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 115;
ProdTypeStr = "Miscellaneous";
ProdCode = 22;
MajRev = 2;
MinRev = 1;
ProdName = "8520-MTBD";
Catalog = "8520-MTBD";

[IO_Info]
Default = 0x0001; 	$ The default I/O type is Polled. Strobed, COS and Cyclic Supported.

PollInfo =
0x000F,			$ Polled, Strobed, COS and Cyclic data supported.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

StrobeInfo =
0x000F,			$ Polled, Strobed, COS and Cyclic data supported.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

COSInfo =
0x000F,			$ Polled, Strobed, COS and Cyclic data supported.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

CyclicInfo =
0x000F,			$ Polled, Strobed, COS and Cyclic data supported.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

$ Input Connections

Input1 =
8,			$ The size in bytes that this connection produces.
64,			$ All bits of this connection are significant
0x000F,			$ Polled, Strobed, and COS, data supported.
"8520_MTBD",  		$ Name of Connection.
6,			$ Path length.
"20 7D 24 01 30 0A", 	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains input data in words 1 thru 3.";
			
$ Output Connections

Output1 =
6,			$ The size in bytes that this connection consumes.
48,			$ All bits of this connection are segnificant.
0x000F,			$ Polled, Strobed, and COS, data supported.
"8520-MTBD",  		$ Name of Connection.
6,			$ Path length.
"20 7D 24 04 30 0C", 	$ Path to I/O Consumption Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains output data for words 4 thru 6.";
			 
[ParamClass]
MaxInst = 27;		$ 9 non-configurable, and 18 configurable parameters.
Descriptor = 0x0F; 	$ Supports Full Parameters in Non-volitile Memory
			$ Must do save to Non-volitile Memory
CfgAssembly = 0;

