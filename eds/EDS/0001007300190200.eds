	Param34 = 0,
		6,"20 0B 24 01 30 7C",	$ Link Path Size, Link Path
		0x0032,	 $ Descriptor
		4, 1,	$ Data Type, Data Size
		"Bad Cal Status #0",
		"",
		"This bit shows the current status of calibration for this channel.\n'Good Calibration' means the data stored in EEPROM is within tollerances.\n'Calibration Fault' means the module is not calibrated and is using default values.\n\nNote:  While in Calibration Mode, the status will be 'Bad Calibration.'",
		0,1,0,
