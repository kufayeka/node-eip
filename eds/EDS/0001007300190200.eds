		"FAULT";
	Param5 =
 		"Normal Operation",
		"FAULT";
	Param6 =
 		"4mA to 20mA",
		"0 V to 10 V (Invalid)",
		"0mA to 20mA",
		"-10 V to 10 V (Invalid)",
		"0 V to  5 V (Invalid)",
		"-5 V to  5 V (Invalid)",
		"1 V to  5 V (Invalid)",
		"-15mV to 75mV (Invalid)",
		"-15mV to 30mV (Invalid)",
		"0mA to 50mA (Invalid)";
