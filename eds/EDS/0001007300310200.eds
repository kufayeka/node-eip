	Param1 = 0,
		6,"20 0A 24 01 30 03",	$ Link Path Size, Link Path
		0x0030,	 $ Descriptor
		3, 2,	$ Data Type, Data Size
		"Input Value #0",
		"",
		"Value of thermocouple input scaled to chosen units.\nIn default mode, it will return hundredths of millivolts.\n(i.e. 25mv = 2500)",
