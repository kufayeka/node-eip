$      Revision 3.xx supports 1791D-N4CV2X Analog Conbination Module

[File]
    DescText    = "1791D-0B16P EDS";
    CreateDate  = 04-18-2003;
    CreateTime  = 18:14:35;
    ModDate     = 02-02-2009;
    ModTime     = 16:25:00;
    Revision    = 3.021;
    HomeURL     = "http://www.ab.com/networks/eds/DN/0001000704370300.eds";

[Device]
    VendCode    = 0x01;                 $ Vendor Code
    VendName    = "Rockwell Automation - Allen-Bradley";
    ProdType    = 0x07;                 $ Product Type
    ProdTypeStr = "General Purpose Discrete I/O";
    ProdCode    = 1079;                 $ Product Code
    MajRev      = 0x03;                 $ Major Rev
    MinRev      = 0x02;                 $ Minor Rev
    ProdName    = "1791D-0B16P 16 Source Out";
    Catalog     = "1791D-0B16P";
    Icon        = "CompactBlk.ico";

    DNetQC      = 0b0000000000000001, 200;  $ Quick Connect supported at power up. 200ms powerup time
    1_Allow_Offline_Only_Switch_Selectors = Yes;

[Device Classification]
Class1 = DeviceNet;

[IO_Info]
1_COSetPathNotSupported = 1;   $Paths not settable.
1_COSetSizeNotSupported = 1;   $Paths not settable.

    Default     = 0x04;     $ Default I/OConnection is COS

    PollInfo    = 0x0D,     $ Cyclic and COS can be combined with
                  1,        $ Default Input  = Input1
                  1;        $ Default Output = Output1

    COSInfo     = 0x05,     $ Cyclic and POLL can be combined with
                  1,        $ Default Input  = Input1
                  1;        $ Default Output = Output1

    CyclicInfo  = 0x09,     $ COS and POLL can be combined with
                  1,        $ Default Input  = Input1
                  1;        $ Default Output = Output1

Input1 =
   0,                      $ Size from AssemN
   0,                      $ Bits determined by AssemN member list
   0x000D,                 $ Poll, COS, Cyclic
   "Input Data",           $ Name String from AssemN
   7,                      $ Path Size 
   "21 04 00 24 07 30 03", $ Input Assem Path
   "";                     $ Help string not applicable


InputExa1 =
   ,               $ Size from AssemN
   0,              $ Bits determined by AssemN member list
   0x000D,         $ Poll, COS, Cyclic
   ,               $ Name String from AssemN
   ,               $ Path Size not applicable
   VariantExa1,    $ Variant for choosing Input Assem
   "";             $ Help string not applicable

Output1 =
   2,                      $ Size from AssemN
   0,                      $ Bits determined by AssemN member list
   0x000D,                 $ Poll, COS, Cyclic
   "Output Data",          $ Name String from AssemN
   7,                      $ Path Size 
   "21 04 00 24 25 30 03", $ Output Assem Path
   "";                     $ Help string not applicable

OutputExa1 =
   ,               $ Size from AssemN
   0,              $ Bits determined by AssemN member list
   0x000D,         $ Poll, COS, Cyclic
   ,               $ Name String from AssemN
   ,               $ Path Size not applicable
   VariantExa2,    $ Variant for choosing Input Assem
   "";             $ Help string not applicable

[ParamClass]
    MaxInst     = 84;      $ max Parameters
    Descriptor  = 0x09;    $ Params support Parameter Instances and are stored in Non-Volatile strage.
    CfgAssembly = 0x0;	    $ Config assembly.		
    1_CfgAssembly = 0xA9;	$ Config assembly.

[Params]
    Param1  =                           $ Disable Autobaud
            0,                          $ reserved
            7,                          $ Link Path Size
            "21 0F 00 24 01 30 01", $ Link Path to disable autobaud attribute.
            0x0002,                     $ No support for settable path, scaling, scaling links, or
                                        $ real time update of value.  Value is gettable and 
                                        $ Settable.  Enumerated strings are supported.
            0xC1,                       $ Data Type - boolean
            1,                          $ Data Size
            "Autobaud",                 $ Parameter Name
            "",                         $ Units String
            "If Enabled, the module adjusts to the current network baud rate. If Disabled, the baud rate can be set to a fixed value. When Disabling, no power cycle is\nrequired. When Enabling, change takes effect after the next power up.",
            0,1,0,                      $ Min, Max, and Default values
            1,1,1,0,0,0,0,0,0;          $ Not Used

    Param2  =                           $ Input filter Off_to_On Delay selection
            0,                          $ reserved
            7,                          $ Link Path Size
            "21 0F 00 24 02 30 01",     $ Link Path to disable autobaud attribute.
            0x0002,                     $ No support for settable path, scaling, scaling links,
                                        $ or real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
            0xC6,                       $ Data Type - unsigned short int
            1,                          $ Data Size - (in bytes)
            "Off-to-On Delay",          $ Parameter Name
            "ms",                       $ Units String
            "The signal must be present on the input for this delay period before the module detects a change in the input state.",
            0,5,1,                      $ Min, Max, and Default values
            1,1,1,0,0,0,0,0,0;          $ Not Used

