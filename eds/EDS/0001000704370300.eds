$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param61 =		    $ Expansion Select
    0,				$ reserved
    0,				$ Link Path Size
    ,	            $ Link Path to param instance.  
    0x0002,		$ No support for settable path, scaling, scaling links,
                   $ or real time update of value.  Value is gettable and
                   $ Settable.  Enumerated strings are supported.
    0xC6,			$ Data Type - unsigned short int
    1,				$ Data Size - (in bytes)
    "Expansion Select",$ Parameter Name
    "",				$ Units String
           $$$$$$$$$$ Help string $$$$$$$$$$$
    "Select the Expansion used at this node. This selection only afffects data size for scanner and RSLogix. This parameter is not stored in the module because the module automatically detects the expansion.",
    0,2,0,			$ Min, Max (max enumeration #), and Default values
    ,,,,,,,,; 		$ Not Used

Enum61 =0,"No Expansion",1,"w/ 16 in exp",2,"w/ 16 out exp",3,"w/ analog exp";


