    Param29 =                           $ Analog Input Range (3)
            0,                          $ reserved
            7,                          $ Link Path Size
            "21 0A 00 24 04 30 07",     $ Link Path to param instance.
            0x0002,                     $ No support for settable path, scaling, scaling links,
                                        $ or real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
            0xC6,                       $ Data Type - unsigned short int
            1,                          $ Data Size - (in bytes)
            "Analog Input Range (3)",   $ Parameter Name
            "",                         $ Units String
            "Choose the range setting that you would like this input(3) to perform.\n Note! Range settings,\"-15 - 75mA\",\"-15 - 30mA\",\"-5 - 5V\" and \"1 - 5v\" are currently invalid.",
            2,8,2,                      $ Min, Max (max enumeration #), and Default values
            1,1,1,0,0,0,0,0,0;          $ Not Used
    Enum29  = 2,"0-10V",3,"4-20mA",8,"0-20mA";

    Param30 =                           $ Analog Output Range (0)
            0,                          $ reserved
            7,                          $ Link Path Size
            "21 0B 00 24 01 30 07",     $ Link Path to param instance.
            0x0002,                     $ No support for settable path, scaling, scaling links,
                                        $ or real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
            0xC6,                       $ Data Type - unsigned short int
            1,                          $ Data Size - (in bytes)
            "Analog Output Range (0)",  $ Parameter Name
            "",                         $ Units String
            "Choose the range setting that you would like this output(0) to perform.\n Note! Range settings,\"-10 - 10V\",\"0 - 5V\",\"-5 - 5V\" and \"1 - 5v\" are currently invalid.",
            0,2,1,                      $ Min, Max (max enumeration #), and Default values
            1,1,1,0,0,0,0,0,0;          $ Not Used

    Param31 =                           $ Analog Output Range (1)
            0,                          $ reserved
            7,                          $ Link Path Size
            "21 0B 00 24 02 30 07",     $ Link Path to param instance.
            0x0002,                     $ No support for settable path, scaling, scaling links,
                                        $ or real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
            0xC6,                       $ Data Type - unsigned short int
            1,                          $ Data Size - (in bytes)
            "Analog Output Range (1)",  $ Parameter Name
            "",                         $ Units String
            "Choose the range setting that you would like this output(1) to perform.\n Note! Range settings,\"-10 - 10V\",\"0 - 5V\",\"-5 - 5V\" and \"1 - 5v\" are currently invalid.",
            0,2,1,                      $ Min, Max (max enumeration #), and Default values
            1,1,1,0,0,0,0,0,0;          $ Not Used

