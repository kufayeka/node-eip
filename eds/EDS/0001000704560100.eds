$ Electronic Data Sheet for ArmorBlock MaXum I/O  (1792D-0B8D)

[File]
DescText = "1792D-0B8D ArmorBlock MaXum I/O EDS File";
CreateDate = 03-28-2000;
CreateTime = 11:16:00;
ModDate = 8-27-2001;
ModTime = 10:20:00;
Revision = 1.004;     	$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1110;
MajRev = 1;
MinRev = 1;
ProdName = "1792D-0B8D 8Output";
Catalog = "1792D-0B8D";
1_Icon = "ArmorBlkMaXum8.ico";


[IO_Info]
Default = 0x0004;   	$ The default I/O type is COS I/O.

PollInfo =
0x000D,         	$ Poll connection can be used with COS or Cyclic I/O.
1,          		$ Input1 entry is the default input connection.
1;          		$ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ COS connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,         	$ Cyclic connection can be used with Polled I/O.
1,          		$ Input1 entry is the default input connection.
1;          		$ Output1 entry is the default output connection.

Input1 =
2,          		$ The size in bytes that this connection produces.
0,          		$ All bits of this connection are significant.
0x000D,         	$ Polled, COS and Cyclic I/O device
"0B8D Production Data", $ Name of Connection.
6,          		$ Path length.
"20 04 24 73 30 03", 	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 2 bytes: Byte 1, bits 0-7=Output Faults 0-7,\nByte 2, bit 6=Output Power.";

Output1 =
1,          		$ The size in bytes that this connection consumes.
0,          		$ All bits of this connection are significant.
0x000D,         	$ Polled, COS and Cyclic I/O device
"0B8D Consumption Data",$ Name of Connection.
6,          		$ Path length.
"20 04 24 21 30 03", 	$ Path to I/O Consumption Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-7 (Outputs 0-7 respectively).";
			 
[ParamClass]
MaxInst = 24;       	$ 15 configurable and 9 read-only parameters.
Descriptor =  0x09; 	$ Stub param instances in eeprom.
CfgAssembly = 0x77; 	$ Config assembly.      

