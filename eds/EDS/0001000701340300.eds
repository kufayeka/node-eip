$ Copyright 2006 by Rockwell Automation
$ Universal version for: DeviceNet, ControlNet, and EthernetIP

$ Revision History
$ Revision	Date		Change
$	1.0	25Aug2006	Initial release
$	1.1	22Jan2007	Fixed Assem126 and ProxiedAssem4

[File]
	DescText    = "ArmorPoint 1738-IB4DM12/A";
	CreateDate  = 08-25-2006;
	CreateTime  = 15:00:00;
	ModDate     = 01-22-2007;
	ModTime     = 15:01:00;
	Revision    = 1.1;
	HomeURL    = "http://www.ab.com/networks/eds/DN/0001000701340300.eds";

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 308;                                $ Product Code

	MajRev      = 3;                                  $ Major Rev
	MinRev      = 10;                                 $ Minor Rev
	VendName    = "Rockwell Automation/Allen-Bradley";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "ArmorPoint 4pt 24Vdc Sink Input with Diagnostics";
	Catalog     = "1738-IB4DM12/A";
	Icon        = "1738-4M12BLUE.ico";
	1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
	1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
     Class1 =      DeviceNet;

[IO_Info]
	1_COSetSizeNotSupported = 1;                      $ Cnxn Obj does not support direct connection size setting

	Default =     0X0004;                             $ COS is default

	PollInfo =    0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      COSInfo =     0X0007,                             $ Compatable with all but cyclic
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      CyclicInfo =  0X000B,                             $ Compatable with all but COS
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

	Input1 =      2,                                  $ size = 2 byte
                    0,                                  $ 16 significant bits
                    0X000F,                             $ compatible with all conections
                    "Data - with Extended Status",      $ name string
                    6,                                  $ path length
                    "20 04 24 65 30 03",                $ assy obj, inst 101, attr 3
                    "Producing connection contains state of the four inputs (bits 0-3) and S.C. or O.W. faults (bits 4-7) in byte 1.  Byte 2 contains O.W.(bits 0-3) and S.C.(bits 4-7)";

	Input2 =      1,                                  $ size = 8 byte
                    0,                                  $ 8 significant bits
                    0X000F,                             $ compatible with all conections
                    "Data - with Status",               $ name string
                    6,                                  $ path length
                    "20 04 24 17 30 03",                $ assy obj, inst 101, attr 3
                    "Producing connection contains state of the four inputs (bits 0-3) and S.C. or O.W. faults (bits 4-7)";

	InputExa1 =
			  ,               			  $ Size from AssemN
			  ,               			  $ Bits determined by AssemN member list
			  0x000F,         			  $ Poll, COS, Cyclic
			  ,               			  $ Name String from AssemN
			  ,               		        $ Path Size not applicable
			  VariantExa1,    			  $ Variant for choosing Input Assem
			  ;               			  $ Help string not applicable
		 

[ParamClass]
	MaxInst     = 102;
	Descriptor  = 0x09;                               $ Bit 0: 1= parameter instances exist
                                                        $ Bit 1: 0= not full
                                                        $ Bit 2: 0= NVS command not needed
                                                        $ Bit 3: 1= Automaticly stored in EERPOM
	CfgAssembly = 0x67;                               $ the custom config assembly is 103d

[Assembly]

	VariantExa1 = "Produced IO Assembly Instance"
    		,,,,,
    		Param28,
    		0x00, Assem101,
    		0x01, Assem23;

 	Assem23 =   "Data - with Status",
            "",                                 $ Path is implied (Assy obj attr3)
            1,                                  $ total length in bytes
            0,,,                                $ no changes, ",,"= reserved
            4, Param18,                         $ # bits, Group Value of inputs
            4, Param38;                         $ # bits, Group Value of fault status

 	Assem101 =  "Data - with Extended Status",
            "",                                 $ Path is implied (Assy obj attr3)
            2,                                  $ total length in bytes
            0,,,                                $ no changes, ",,"= reserved
            4, Param18,                         $ # bits, Group Value of inputs
            4, Param38,                         $ # bits, Group Value of fault status
            4, Param23,                         $ # bits, Group Value of input status
            4, Param39;                         $ # bits, Group Value of input status

	Assem103 =  "Configuration Assembly",
      	"",                                 $ Path is implied (Assy obj attr3)
            18,                                 $ total length in bytes
            0,,,                                $ changes, ",,"= reserved
            16, Param5,                         $ # bits, Off2On Filter 0
            16, Param6,                         $ # bits, On2Off Filter 0
            16, Param7,                         $ # bits, Off2On Filter 1
        	16, Param8,                         $ # bits, On2Off Filter 1
        	16, Param9,                         $ # bits, Off2On Filter 2
            16, Param10,                        $ # bits, On2Off Filter 2
            16, Param11,                        $ # bits, Off2On Filter 3
            16, Param12,                        $ # bits, On2Off Filter 3
            1,  Param24,                        $ # bits, Open Wire Active 0
            1,  Param25,                        $ # bits, Open Wire Active 0
            1,  Param26,                        $ # bits, Open Wire Active 0
            1,  Param27,                        $ # bits, Open Wire Active 0
            3,,						$ Pad bits
		1,Param13,				  	$ AutoBaud Disable                                 
		8, Param28;				  	$ Produced Assembly
	
	Assem124 =                  $ Private config in Forward Open, Module
        	"3rd Party Private Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,,                      $ reserved
        	16,Param101,            $ configuration revision (only valid value is 1)
        	16,;                    $ reserved - zeros

$    	Assem125 =                  $ Private config in Forward Open, Module
$        	"Adapter Config Assembly",
$        	,                       $ Path
$        	,                       $ Length in bytes
$        	,                       $ descriptor
$        	,,                      $ reserved
$        	16,Param102,            $ Non-Logix Header (constant 0x7001)
$        	16,1_RackSize,          $ number of slots
$        	16,Param101,            $ configuration revision (only valid value is 1)
$        	16, ;                   $ reserved - zeros

    	Assem126 =                  $ O2T (output data)
        	"Ouput Data Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,                       $ reserved
        	;                       $ No Assembly sent to module

    	Assem127 =                  $ T2O (input data)
        	"Input Data Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,,                      $ reserved
        	32,,                    $ Fault bits
        	,Assem101;               $ Assembly passed from module


    	Assem128 =                  $ T2O (input data)
        	"Input Data Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,,                      $ reserved
        	32,,                    $ Fault bits
        	,Assem23;               $ Assembly passed from module





	$ These proxied assemblies are used for non-Logix rack connections which are not currently implemented.

      ProxiedAssem1 =
     		"DC Input Rack Configuration Assembly",
            "01 SLOT 20 04 24 78 30 03",        $ Path to Assy Obj (4) inst 120d attr 3
            ,                                   $ total length in bytes
            0x0000,                             $ descriptor
            ,,                                  $ ",,"= reserved
            16, Param17;                        $ # bits, Value for all input filters

      ProxiedAssem3 = 
            "Real Time Input Format",
            ,                                   $ No Path
            ,                                   $ Length
            0x0000,                             $ Descriptor
            ,,                                  $ ",,"= reserved
            16,Assem101;

      ProxiedAssem4 = 
            "Real Time Output Format",
            ,                                   $ No Path
            ,                                   $ Length
            0x0000,                             $ Descriptor
            ,                                   $ ",,"= reserved
            ;                                   $ Nothing

