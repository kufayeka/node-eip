[Device]
VendCode = 1;
VendName = "Rockwell Automation/Allen-Bradley";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 256;
MajRev = 3;
MinRev = 6;
Icon = "1799TTL.ico";

ProdName = "1799-D12G12GL,TTL 12in/12out + 4 PWM";
Catalog = "1799-D12G12GL";
DNetQC=0B0000000000000001, 200; $ Quick Connect supported at power up. 200ms powerup time

1_RSNetWorx_DNetTool = "LeoApp.LeoDevice";
1_RSNetWorx_DNetToolEx = "1.00.00", "LeoApp.LeoDevice", "7.00.00", "RSI.DeviceNet.EDSApplet.1";
1_DNetEDSAppletPlugIn = "7.00.00", "DeviceLogixPlugIn.EDSAppletPlugIn.1";

    
[Device Classification]
     Class1 =      DeviceNet;


[IO_Info]
1_COSetPathNotSupported = 1;   $Paths not settable.
1_COSetSizeNotSupported = 1;   $Paths not settable.

Default = 0x0004;  $ The default I/O type is COS I/O.

PollInfo =
0x000d,        $ Poll connection can be used with COS or cyclic I/O.
1,             $ Input1 entry is the default input connection.
1;             $ Output1 entry is the default output connection.

COSInfo=
0x0005,        $ COS connection can be used with Polled I/O.
1,             $ Input1 entry is the default input connection.
1;             $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,        $ Cyclic connection can be used with Polled I/O.
1,             $ Input1 entry is the default input connection.
1;             $ Output1 entry is the default output connection.
 
Input1 =
6,                         $ The size in bytes that this connection produces.
12,                        $ Twelve bits of this connection are significant.
0x000D,                    $ Polled and COS I/O device.
"Data",                    $ Name of Connection.
6,                         $ Path length.
"20 04 24 9E 30 03",       $ Path to I/O Production Assembly.
   $$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 6 bytes: Byte 1, bits 0-7=Inputs 0-7.\nByte 2, bits 0-3=Inputs 8-11, bit 6= logic enable."
"\nByte 3, bits 0-7=Outputs 0-7.\nByte 4, bits 0-7=Outputs 8-15.\nByte 5, bits 0-7=PNBs 0-7. Byte 6 , bits 0-7=PNBs 8-15.";
           
Output1 =
3,                         $ The size in bytes that this connection consumes.
24,                        $ Twenty four bits of this connection are significant. 
0x000D,                    $ Polled and COS I/O device.
"Data",                    $ Name of Connection.
6,                         $ Path length.
"20 04 24 25 30 03",       $ Path to I/O Consumption Assembly.
   $$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 3 bytes: Byte 1, bits 0-7=Outputs 0-7.\nByte 2, bits 0-7=Outputs 8-15.\nByte 3, bits 0-7=PWM Output bits 0-7.";
            
OutputExa1 =
,               $ Size from AssemN
,               $ Bits determined by AssemN member list
0x000D,         $ Poll, COS, Cyclic
,               $ Name String  from AssemN
,               $ Path Size not applicable
VariantExa1,    $ Variant for choosing Output Assem
;               $ Help string not applicable

            
[ParamClass]
MaxInst = 56;          $ parameters.
Descriptor =  0x09;    $ Stub param instances in eeprom.
CfgAssembly = 0x00;    $ The config assembly is instance #104 of assy obj.     
1_CfgAssembly = 0xA9;  $ Config assembly.

