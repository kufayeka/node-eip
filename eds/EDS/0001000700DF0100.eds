[Params]
      Param1 =
        0,          $ first field shall equal 0
        ,,          $ path size,path
        0x0002,     $ descriptor 
        0xc7,          $ data type : 16-bit Unsigned Integer
        2,          $ data size in bytes
        "Input Filter Time", $ name
        "",            $ units
        "",            $ help string
        0,7,0,         $ min,max,default data values
        0,0,0,0,    $ mult,dev,base,offset scaling not used
        0,0,0,0,    $ mult,dev,base,offset link not used
        0;          $ decimal places not used
      Enum1 =
        0,"On->Off/Off->On= 0.256 ms",
        1,"On->Off/Off->On= 0.512 ms",
        2,"On->Off/Off->On= 1 ms",
        3,"On->Off/Off->On= 2 ms",
	4,"On->Off/Off->On= 4 ms",
	5,"On->Off/Off->On= 8 ms",
	6,"On->Off/Off->On= 16 ms",
	7,"On->Off/Off->On= 32 ms";


      Param2 =
        0,          $ first field shall equal 0
        ,,          $ path size,path
        0x0010,     $ descriptor - read only
        0xc7,       $ data type : 16-bit Unsigned Integer
        2,          $ data size in bytes
        "Data",     $ name
        "",         $ units
        "",         $ help string
        0,65535,0,      $ min,max,default data values
        0,0,0,0,    $ mult,dev,base,offset scaling not used
        0,0,0,0,    $ mult,dev,base,offset link not used
        0;          $ decimal places not used
        
      Param18 =
        0,          $ first field shall equal 0
        ,,          $ path size,path
        0x0012,     $ descriptor - read only
        0xd2,       $ data type : 16-bit Word
        2,          $ data size in bytes
        "Status",     $ name
        "",         $ units
        "",         $ help string
        0,65535,0,      $ min,max,default data values
        0,0,0,0,    $ mult,dev,base,offset scaling not used
        0,0,0,0,    $ mult,dev,base,offset link not used
        0;          $ decimal places not used
      Enum18 =
      0,"ModuleError",
      1,"PowerReversed",
      2,"PowerShort",
      3,"OpenWire";
    
