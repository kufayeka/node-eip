$ Electronic Data Sheet for Armor Block I/O  (1792-OB4E-A/A)

[File]
DescText = "1792-OB4E-A/A Armor Block I/O EDS File";
CreateDate = 07-14-95;
CreateTime = 12:00:00;
ModDate = 04-06-99;
ModTime = 11:24:00;
Revision = 1.2;			$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1027;
MajRev = 1;
MinRev = 1;
ProdName = "1792-OB4E 4Output";
Catalog="1792-OB4E";
1_Icon=0001_ArmorBlk.ico;

[IO_Info]
Default = 0x0001;		$ The default I/O type is polled I/O.
PollInfo =
0x0001,					$ Polled I/O is the only I/O type present.
1,							$ Input1 entry is the default input connection.
1;							$ Output1 entry is the default output connection.

Input1 =
1,							$ The size in bytes that this connection produces.
0,							$ All bits of this connection are significant.
0x0001,					$ Only Polled I/O is compatible.
"OB4E Production Data",  $ Name of Connection.
6,							$ Path length.
"20 04 24 65 30 03",	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains status from outputs at bits 0-3.";
			
Output1 = 
1,							$ The size in bytes that this connection consumes.
4,							$ Only the four least significant bits of this 
							$ connection are used.
0x0001,					$ Only Polled I/O is compatible.
"OB4E Consumption Data",  $ Name of Connection.
6,							$ Path length.
"20 04 24 21 30 03",	$ Path to I/O Consumption Assembly.
							$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains data for four outputs.";
			 

[ParamClass]
MaxInst = 3;			$ The combo module has 5 configurable parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = x67;	$ The config assembly is instance #103 of assy obj.		

[Params]
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param1 =					$ Disable Autobaud
0,							$ reserved
6,							$ Link Path Size
"20 03 24 01 30 64",	$ Link Path to disable autobaud attribute.
0x02,						$ No support for settable path, scaling, scaling links, or
							$ real time update of value.  Value is gettable and 
							$ Settable.  Enumerated strings are supported.
4,							$ Data Type - boolean
1,							$ Data Size
"Autobaud",				$ Parameter Name (NOT "disable autobaud". That's confusing.)
"",						$ Units String
							$$$$$$$$$$ Help string $$$$$$$$$$$
"Enable takes effect after next powerup.  Disable is required to set fixed baud rate, no power cycle is required.",
0,1,0,					$ Min, Max, and Default values
1,1,1,0,0,0,0,0,0;	$ Not Used


$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param2 =					$ Fault State selection
0,							$ reserved
6,							$ Link Path Size
"20 1E 24 01 30 07",	$ Link Path to DOG object's fault state attribute.
0x02,						$ No support for settable path, scaling, scaling links, or
							$ real time update of value.  Value is gettable and 
							$ Settable.  Enumerated strings are supported.
4,							$ Data Type - boolean
1,							$ Data Size
"Fault State",			$ Parameter Name
"",						$ Units String
							$$$$$$$$$$ Help string $$$$$$$$$$$
"Defines output behavior in the event of a communication fault.",
0,1,0,					$ Min, Max (max enumeration #), and Default values
1,1,1,0,0,0,0,0,0;	$ Not Used


$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param3 = 					$ Idle State selection
0,							$ reserved
6,							$ Link Path Size
"20 1E 24 01 30 09",	$ Link Path to DOG object's idle state attribute.
0x02,						$ No support for settable path, scaling, scaling links, or
							$ real time update of value.  Value is gettable and 
							$ Settable.  Enumerated strings are supported.
4,							$ Data Type - boolean
1,							$ Data Size
"Idle State",			$ Parameter Name
"",						$ Units String
							$$$$$$$$$$ Help string $$$$$$$$$$$
"Defines output behavior during program mode.",
0,1,0,					$ Min, Max (max enumeration #), and Default values
1,1,1,0,0,0,0,0,0;	$ Not Used


[Groups]

[EnumPar]
Param1="Enable","Disable";
Param2="Reset Outputs","Hold Last State";
Param3="Reset Outputs","Hold Last State";
