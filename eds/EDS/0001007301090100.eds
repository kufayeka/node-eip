[Assembly]
        Revision = 1;

	$$ Consumed Assembly $$
        Assem1 =			$ Default Consumed Assembly
                "Data - IE/IB Output, Net Command, Network Input",
                "21 04 00 24 01 30 03", $ Assembly path
                3,						$ bytes
                0x0000,					$
                ,,
                2, Param38,             $ IE Output A/B Value
				6, ,					$ unused
				16,Param45;			    $ Network Input (0~15)



        Assem2 =						$ IE HWD output only asembly
                "Data - IE Output",
                "21 04 00 24 02 30 03",
                1,
                0x0000,
                ,,
                2, Param38;            $ IE Output A/B Value
 

        Assem3 =						$ IE NET input only assembly
                "Data - Network Input",
                "21 04 00 24 03 30 03",
                2,
                0x0000,
                ,,

				16, Param45;			$ Network Input (0~15)



	$$ Produced Assembly $$
        Assem10=						$ Default Produced Assembly
                "Data - IE/IB Input, Module Status, Network Output",
                "21 04 00 24 0A 30 03",
                7,
                0x0000,
                ,,
                8,  Param37,        $ IE Input Value (0~7)
				1,  Param1,			$ IB1-Input 0 (Aux Status)
				1,  Param4,		    $ IB1-Input 1 (Close Status)
				1,  Param7,		    $ IB1-Input 2 (Open Status)
				1,  Param2,		    $ IB2-Input 0 (Aux Status)
				1,  Param5,		    $ IB2-Input 1 (Close Status)
				1,  Param8,			$ IB2-Input 2 (Open Status)
				1,  Param3,		    $ IB3-Input 0 (Aux Status)
				1,  Param6,		    $ IB3-Input 1 (Close Status)
				1,  Param9,			$ IB3-Input 2 (Open Status)
				1,  ,		    	$ unused
				1,  ,		    	$ unused
				1,  ,				$ unused
				1,  ,		        $ unused
				1,  ,		        $ unused
				1,  ,		        $ unused
				1,  ,				$ unused
				$8,  Param209,		$ the 8 bit IE module status
				32, Param47;		$ the 32 bits Produced Network Bits




        Assem11=
                "Data - IE Input",
                "21 04 00 24 0B 30 03",
                1,
                0x0000,
                ,,
                8, Param37;           $ IE Input Value (0~7)
  


        Assem12=
                "Data - Network Output",
                "21 04 00 24 0C 30 03",
                4,
                0x0000,
                ,,
		        32, Param47;			$ the 32 bits Produced Network Bits
				
				
				
        Assem13=						
                "Data - IE/IB Input",
                "21 04 00 24 0D 30 03",
                4,
                0x0000,
                ,,
                8,  Param37,        $ IE Input Value (0~7)
				1,  Param4,		    $ IB1-Input 1 (Close Status)
				1,  Param7,		    $ IB1-Input 2 (Open Status)
				1,  Param2,		    $ IB2-Input 0 (Aux Status)
				1,  Param5,		    $ IB2-Input 1 (Close Status)
				1,  Param8,			$ IB2-Input 2 (Open Status)
				1,  Param3,		    $ IB3-Input 0 (Aux Status)
				1,  Param6,		    $ IB3-Input 1 (Close Status)
				1,  Param9,			$ IB3-Input 2 (Open Status)
				1,  ,		    	$ unused
				1,  ,		    	$ unused
				1,  ,				$ unused
				1,  ,		        $ unused
				1,  ,		        $ unused
				1,  ,		        $ unused
				1,  ,				$ unused bit
				8,  ;				$ unused byte
			
				
        VariantExa1 =
                ,,,,,
                Param61,                 $ Produced Assembly Selection
                0x0A,Assem10,
                0x0B,Assem11,
                0x0C,Assem12,
				0x0D,Assem13;


        VariantExa2 =
                ,,,,,
                Param60,                $ Consumed Assembly Selection
                0x01,Assem1,
                0x02,Assem2,
                0x03,Assem3;



