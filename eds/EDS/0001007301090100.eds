$==================================================================================================$
[IO_Info]
	Default     = 0X0001;                   $ Polled IO is the default


        PollInfo =
                0x000F,         $ Poll connection can be used with all.
                1,              $ Input1 entry is the default input connection.
                1;              $ Output1 entry is the default output connection.

        COSInfo =
                0x0005,         $ COS connection can be used with Polled I/O.
                1,              $ Input1 entry is the default input connection.
                1;              $ Output1 entry is the default output connection.

        CyclicInfo =
                0x0009,         $ Cyclic connection can be used with Polled I/O.
                1,              $ Input1 entry is the default input connection.
                1;              $ Output1 entry is the default output connection.

        StrobeInfo =  
                0X000F,         $ Compatable with all
                1,              $ Input1 entry is the default input connection.
                0;              $ No strobe connection here

             
	              
	$$$$  Input (Produced) Assemblies $$$$
		              
	Input1 =
		   7,                              $ 7 bytes
		   0,                              $ all bits are significant
           0x000F,                 	       $ Poll, COS, Cyclic, Strobe
		   "IE & IB Inputs, Status, PNB",  $ Name String
		   8,                              $ Path Size
		   "21 04 00 25 0A 00 30 03",      $ Path for Assy instance 10
		   "IE & IB Inputs, Status, PNB\n";$ Help string
	   
    InputExa1 =
              ,                       	   $ Size from AssemN
              ,                       	   $ Bits determined by AssemN member list
           0x000F,                 	       $ Poll, COS, Cyclic, Strobe
              ,                       	   $ Name String  from AssemN
              ,                       	   $ Path Size not applicable
              VariantExa1,            	   $ Variant for choosing Output Assem
              ;                       	   $ Help string not applicable

			  
	Input2 =
		   1,                              $ 1 byte
		   0,                              $ all bits are significant
		   0x000F,                         $ Poll, COS, Cyclic, Strobe
		   "IE inputs",                    $ Name String
		   8,                              $ Path Size
		   "21 04 00 25 0B 00 30 03",      $ Path for Assy instance 11
		   "IE inputs\n";                  $ Help string			  
			  
	InputExa2 =
		   1,                              $ 1 byte
		   0,                              $ all bits are significant
		   0x000F,                         $ Poll, COS, Cyclic, Strobe
		   "IE inputs",                    $ Name String
		   8,                              $ Path Size
		   "21 04 00 25 0B 00 30 03",      $ Path for Assy instance 11
		   "IE inputs\n";                  $ Help string				  
			  
			  
			  
	Input3 =
		   4,                              $ 4 bytes
		   0,                              $ all bits are significant
		   0x000F,                         $ Poll, COS, Cyclic, Strobe
		   "Produced Network Bits",        $ Name String
		   8,                              $ Path Size
		   "21 04 00 25 0C 00 30 03",      $ Path for Assy instance 12
		   "Produced Network Bits\n";      $ Help string			  
			  
	InputExa3 =
		   4,                              $ 4 bytes
		   0,                              $ all bits are significant
		   0x000F,                         $ Poll, COS, Cyclic, Strobe
		   "Produced Network Bits",        $ Name String
		   8,                              $ Path Size
		   "21 04 00 25 0C 00 30 03",      $ Path for Assy instance 12
		   "Produced Network Bits\n";      $ Help string						  
			  
			  
			  
	Input4 =
		   4,                              $ 4 bytes
		   0,                              $ all bits are significant
		   0x000F,                         $ Poll, COS, Cyclic, Strobe
		   "IE & IB Inputs",               $ Name String
		   8,                              $ Path Size
		   "21 04 00 25 0D 00 30 03",      $ Path for Assy instance 13
		   "IE & IB Inputs\n";             $ Help string			  
			  
	InputExa4 =
		   4,                              $ 4 bytes
		   0,                              $ all bits are significant
		   0x000F,                         $ Poll, COS, Cyclic, Strobe
		   "IE & IB Inputs",               $ Name String
		   8,                              $ Path Size
		   "21 04 00 25 0D 00 30 03",      $ Path for Assy instance 13
		   "IE & IB Inputs\n";             $ Help string			  
			  
			  	  
			  
			  
			  

	$$$$  Output (Consumed) Assemblies $$$$

	Output1 =
		    3,                             $ 3 bytes
		    0,                             $ all bits significant
		    0x000D,                        $ Poll, COS, Cyclic
		    "Consumed Data",               $ Name String
		    8,                             $ Path Size
		    "21 04 00 25 01 00 30 03",     $ Path for Assy instance 01
		    "This contains 5 bytes:\n";    $ Help string

    OutputExa1 =
               ,                       	   $ Size from AssemN
               ,                       	   $ Bits determined by AssemN member list
               0x000D,                 	   $ Poll, COS, Cyclic
               ,                       	   $ Name String  from AssemN
               ,                       	   $ Path Size not applicable
               VariantExa2,            	   $ Variant for choosing Output Assem
               ;                       	   $ Help string not applicable

			   
	   Output2 =
		       1,                             $ 1 byte
		       2,                             $ 2 bits significant
		       0x000D,                        $ Poll, COS, Cyclic
		       "IE Outputs",                  $ Name String
		       8,                             $ Path Size
		       "21 04 00 25 02 00 30 03",     $ Path for Assy instance 01
		       "IE Output";    				  $ Help string

    OutputExa2 =
		       1,                             $ 1 byte
		       2,                             $ 2 bits significant
		       0x000D,                        $ Poll, COS, Cyclic
		       "IE Outputs",                  $ Name String
		       8,                             $ Path Size
		       "21 04 00 25 02 00 30 03",     $ Path for Assy instance 01
		       "IE Output";    				  $ Help string 
			   
	
	   Output3 =
		       2,                             $ 2 bytes
		       0,                             $ all bits significant
		       0x000D,                        $ Poll, COS, Cyclic
		       "Consumed Ntework Bits",       $ Name String
		       8,                             $ Path Size
		       "21 04 00 25 03 00 30 03",     $ Path for Assy instance 01
		       "Consumed Ntework Bits";    	  $ Help string

    OutputExa3 =
		       2,                             $ 2 bytes
		       0,                             $ all bits significant
		       0x000D,                        $ Poll, COS, Cyclic
		       "Consumed Ntework Bits",       $ Name String
		       8,                             $ Path Size
		       "21 04 00 25 03 00 30 03",     $ Path for Assy instance 01
		       "Consumed Ntework Bits";    	  $ Help string

    1_COSetPathNotSupported = 1;          $ Paths not settable.
    1_COSetSizeNotSupported = 1;          $ Paths not settable.

