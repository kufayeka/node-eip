$=**********************************************************=$	
$===Altitude===$	
 Param63 =					
		 0,
		 8,"21 B4 00 25 01 00 30 74",
		 0x0032,						$ MO, RO, Enumerated strings are supported.
		 0xC6,1,						$ USINT, 1 byte
		 "Altitude","m",				$ Parameter Name & unit string
		 "Altitude.", 					$ Help string
		 0,5,0,							$ min, Max, Default value
		 ,,,,							$ Scaling factors
		 ,,,,							$ Scaling links
         0;								$ Decimal Places
 Enum63  =								
  	     0, "-0001 ~ 0000 M",
         1, "0001 ~ 1000 M",
         2, "1001 ~ 2000 M",
         3, "2001 ~ 3000 M",
         4, "3001 ~ 4000 M",
         5, "4001 ~ 5000 M"; 
 
 
 
$===RTC date===$	
 Param64 =						
		 0,
		 8,"21 B4 00 25 01 00 30 70",	$ link path
		 0x0000,						$ MO, Setable & Setable
		 0xCD,2,						$ Date type, 2 bytes
		 "RTC Date"," ",				$ Parameter Name & unit string
		 "The Device RTC date.",		$ Help string 
		 0,0xFFFF,0,					$ min, Max, Default value=1972/1/1
		 ,,,,							$ Scaling factors
		 ,,,,							$ Scaling links
		 0;								$ Decimal Places
 

 
