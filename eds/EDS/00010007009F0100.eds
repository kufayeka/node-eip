      Param9 =      "OFF","ON";                         $ Input value 8
      Param10 =      "OFF","ON";                        $ Input value 9
      Param11 =      "OFF","ON";                        $ Input value 10
      Param12 =      "OFF","ON";                        $ Input value 11
      Param13 =      "OFF","ON";                        $ Input value 12
      Param14 =      "OFF","ON";                        $ Input value 13
      Param15 =      "OFF","ON";                        $ Input value 14
      Param16 =      "OFF","ON";                        $ Input value 15

      Param49 =    "Enable","Disable";                  $ Autobaud

      Param50 =    "Do Nothing","Sequential Address";   $ Auto address
      Param51 =    "125 kHz","250 kHz","500 kHz";       $ baud rate
      Param52 =    "Enable","Disable";                  $ Autobaud

[Groups]
      Group1 =      "I/O", 16, 1,2,3,4,5,6,7,8,         $ input value
                    9,10,11,12,13,14,15,16;
