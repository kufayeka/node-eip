[IO_Info]
	1_COSetPathNotSupported = 1;              $ Cnxn Obj does not support direct 

	Default    = 0x0004;                      $ default is COS

	PollInfo   = 0x000F, 1, 0;

	StrobeInfo = 0x000F, 1, 0;

	COSInfo    = 0x0007, 1, 0;

	CyclicInfo = 0x000B, 1, 0;

Input1 = 
	2,                                        $ size = 2 bytes
      0,                                          $ all bits significant
      0x000F,                                     $ compatible with all conections
	"Data",                                   $ name string
	6,                                        $ path length
      "20 04 24 05 30 03",                        $ assy obj, inst 05, attr 3
	"16 bits input points of the 1734D-IB16";


