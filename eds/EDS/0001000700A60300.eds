8, Param50,                $ 8 output values (byte 0)
8, Param50;                $ 8 output values (byte 0)


Assem169 =             $0xA9
"Configuration Data",  $ Name of Connection.
,                      $ Path to Assembly.
4,                     $ The size in bytes.
0, , ,                 $ Not editable, not modular.
1,Param1,              $ Autobaud                  (byte 0 bit 0)
1,Param43,             $ Quick Connect             (byte 0 bit 1)
1,Param11,             $ Net Overide               (byte 0 bit 2)
1,Param12,             $ Com Overide               (byte 0 bit 3)
1,Param6,              $ Fault State               (byte 0 bit 4)
1,Param7,              $ Fault Value               (byte 0 bit 5)
1,Param8,              $ Idle State 0              (byte 0 bit 6)
1,Param9,              $ Idle Value 0              (byte 0 bit 7)
8,Param2,              $ Off to On Input filter    (byte 1,2)
8,Param3,              $ On to Off Input filter    (byte 3,4)
4,,
4,Param10;             $ Consumed I/O assembly selection


 
VariantExa1 =
    ,,,,,
    Param10,
    0x00, Assem37,
    0x01, Assem160,
    0x02, Assem161,
    0x03, Assem162,
    0x04, Assem163,
    0x05, Assem164;


