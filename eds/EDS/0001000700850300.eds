$ Electronic Data Sheet for Point I/O  (1734-OB2E/C)
$ Copyright 2006 by Rockwell Automation
$ Universal version for: DeviceNet, ControlNet, and EthernetIP

$ Revision History
$ Revision	Date		Change
$	1.5	03Jul2002	Added 1_RSNetWorx_DNetTool so RSNet DNet knows to run the DeviceNet applet
$	1.6	22Jul2002	PDT added 1_RSNetWorx_NoAutoEnter = "Yes"
$	2.1	06Aug2002	Changed revision to 2.1 (EDS Rev)
$				ExID rev to ...0302
$				Put file name in HomeURL
$	2.2	07Aug2002	Removed 'DoNotDisplayBit' in rack assembly Param(s)
$	2.3	22Aug2002	Changed ProxyConnects to Connects
$				Added Assem125,126,127
$				Added Param101,102,103,104
$				Deleted ProxiedAssem2, ProxiedParam1,2,3
$				Temporary commented out [Groups] bug in RSNetC
$	2.4	30Sep2002	Returned [Groups] section (RSNetworx is fixed)
$	2.5	29Jan2003	Fix up for RSNetworx4.11 - 'Display Only' Logix connections
$	2.6	30Jan2003	Removed Header in Assem126/127 and Param103/104
$	3.1	22Dec2003	PLC/SLC support for CNet and ENet.  Changes to
$				Assem125,125,127, Connection3&43
$	3.2	11Jan2004	Updated Device Revision to 3.10
$	4.1	30Nov2004	Added Assem124 - Changed CNXNs for 3rd Party
$	5.1	01Feb2006	Update to new DeviceNet Premier Integration EDS Guidelines
$				Removed Assem124 from Listen Only Connection
$	5.2	18Mar2006	Added pading to IO assems

[File]
	DescText =    "PointIO 1734-OB2E/C";                   
	CreateDate  = 01-30-2002;
	CreateTime  = 15:00:00;
	ModDate     = 03-18-2006;
	ModTime     = 15:00:00;
	Revision =    5.2;
	HomeURL     = "http://www.ab.com/networks/eds/DN/0001000700850300.eds";

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 133;                                $ Product Code

	MajRev      = 3;                                  $ Major Rev
	MinRev      = 10;                                 $ Minor Rev
	VendName    = "Rockwell Automation/Allen-Bradley";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "PointIO 2pt 24Vdc Source Output Enhanced";
	Catalog     = "1734-OB2E/C";
	Icon        = "1734green.ico";
	1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
	1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
     Class1 =      DeviceNet;

[IO_Info]
	1_COSetPathNotSupported = 1;                      $ Cnxn Obj does not support direct path setting

	Default     = 0X0004;

	PollInfo    = 0X000F,                             $ compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      COSInfo =     0X0007,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      CyclicInfo =  0X000B,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

	Input1 =      1,                                  $ size = 1 byte
                    2,                                  $ 2 significant bits
                    0X000F,                             $ compatible with all conections
                    "Status",                           $ name string
                    6,                                  $ path length
                    "20 04 24 2A 30 03",                $ assy obj, inst 42d, attr 3
                    "Producing connection contains the status of the outputs";

	Output1 =     1,                                  $ size = 1 byte
                    2,                                  $ 2 significant bits
                    0X000D,                             $ compatible with polled connection
                    "Data",                             $ name string
                    6,                                  $ path length
                    "20 04 24 20 30 03",                $ assy obj, inst 32d(0x20), attr 3
                    "Consuming connection contains state of the two outputs";

[ParamClass]
	MaxInst =     102;
	Descriptor  = 0x09;                               $ Bit 0: 1= parameter instances exist
                                                        $ Bit 1: 0= not full
                                                        $ Bit 2: 0= NVS command not needed
                                                        $ Bit 3: 1= Automaticly stored in EERPOM                                                          

	CfgAssembly = 0x7B;                               $ the custom config assembly is 123d

[Assembly]
        Assem32=    "Data",
                    "",                                 $ Path is implied (Assy obj attr3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    2, Param39,                         $ # bits, Group Value for Output
                    6,;                                 $ Pad bits

        Assem42=    "Status",
                    "",                                 $ Path is implied (Assy obj attr3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    2, Param40,                         $ # bits, Group Status of Output
                    6,;                                 $ Pad bits

        Assem123 =  "1734-OB2E Configuration Assembly",
                    "",                                 $ Path is implied (Assy obj attr3)
                    8,                                  $ total length in bytes
                    0,,,                                $ descriptor, ",,"= reserved
                    1,Param13,                          $ # bits, Fault State selection for output 0
                    1,Param15,                          $ # bits, Fault State selection for output 1
                    6,,                                 $ pad bits
                    1,Param14,                          $ # bits, Fault Value selection for output 0
                    1,Param16,                          $ # bits, Fault Value selection for output 1
                    6,,                                 $ pad bits
                    1,Param17,                          $ # bits, Idle State selection for output 0
                    1,Param19,                          $ # bits, Idle State selection for output 1
                    6,,                                 $ pad bits
                    1,Param18,                          $ # bits, Idle Value selection for output 0
                    1,Param20,                          $ # bits, Idle Value selection for output 1
                    6,,                                 $ pad bits
                    1,Param23,                          $ # bits, Enable No Load for output 0
                    1,Param24,                          $ # bits, Enable No Load for output 1
                    6,,                                 $ pad bits
                    1,Param25,                          $ # bits, Reset Mode for output 0
                    1,Param26,                          $ # bits, Reset Mode for output 1
                    6,,                                 $ pad bits
                    1,Param21,                          $ # bits, Enable Latched Alarms for output 0
                    1,Param22,                          $ # bits, Enable Latched Alarms for output 1
                    6,,                                 $ pad bits
                    8,;                                 $ pad byte (for word boundary)

    Assem124 =                  $ Private config in Forward Open, Module
        "3rd Party Private Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param101,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem125 =                  $ Private config in Forward Open, Module
        "Adapter Config Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param102,            $ Non-Logix Header (constant 0x7001)
        16,1_RackSize,          $ number of slots
        16,Param101,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem126 =                  $ O2T (output data)
        "Ouput Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        ,Assem32;               $ Assembly sent to module

    Assem127 =                  $ T2O (input data)
        "Input Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        32,,                    $ Fault bits
        ,Assem42;               $ Assembly passed from module

      ProxiedAssem1 =
                    "DC Output Rack Configuration Assembly",
                    "01 SLOT 20 04 24 78 30 03",        $ Path to Assy Obj (4) inst 120d attr 3
                    ,                                   $ total length in bytes
                    0x0000,                             $ descriptor
                    ,,                                  $ ",,"= reserved
                    1,Param32,                          $ Group Fault Action
                    1,Param33,                          $ Group Fault Value
                    1,Param34,                          $ Group Idle Action
                    1,Param35,                          $ Group Idle Value
                    1,Param36,                          $ Group No Load Enable
                    1,Param37,                          $ Group Reset Mode
                    1,Param38,                          $ Group Latch Alarms
                    1,;                                 $ Pad bit

      ProxiedAssem3 = 
                    "Real Time Input Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem42;

      ProxiedAssem4 = 
                    "Real Time Output Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem32;


[Params]
$ Output state
      Param1 =      $ Value for Output #0
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 01 30 03",                $ Link Path to DOP object's value attribute.
                    0x0022,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable and Settable.
                    0xC1,                               $ Data Type - boolean
                    1,                                  $ Data Size
                    "Output Value #0",                  $ Parameter Name
                    "",                                 $ Units String
                    "Value of output point.  'ON' or 'OFF'\nNOT SETTABLE when I/O conection is established.",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

	Enum1 =       0,"OFF", 1,"ON";

      Param2 =      $ Value for Output #1
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 02 30 03",                $ Link Path to DOP object's value attribute.
                    0x0022,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable and Settable.
                    0xC1,                               $ Data Type - boolean
                    1,                                  $ Data Size
                    "Output Value #1",                  $ Parameter Name
                    "",                                 $ Units String
                    "Value of output point.  'ON' or 'OFF'\nNOT SETTABLE when I/O conection is established.",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

	Enum2 =       0,"OFF", 1,"ON";

$ Output status
      Param3 =      $ Status of Output 0
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 01 30 04",                $ Link Path to DOP object's status attribute.
                    0x0032,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable only.
                    0xC1,                               $ Data Type - boolean
                    1,                                  $ Data Size
                    "Status of Output #0",              $ Parameter Name
                    "",                                 $ Units String
                    "This Status bit is the OR of all possible faults for this channel.\n\nPossible Faults:\n - open load\n - short circuit\n - over current\n - no field power\n\nNote: Status could be 'latched' in fault state.",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Enum3 =       0,"No Fault", 1,"FAULT";

      Param4 =      $ Status of Output 1
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 02 30 04",                $ Link Path to DOP object's status attribute.
                    0x0032,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable only.
                    0xC1,                               $ Data Type - boolean
                    1,                                  $ Data Size
                    "Status of Output #1",              $ Parameter Name
                    "",                                 $ Units String
                    "This Status bit is the OR of all possible faults for this channel.\n\nPossible Faults:\n - open load\n - short circuit\n - over current\n - no field power\n\nNote: Status could be 'latched' in fault state.",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Enum4 =       0,"No Fault", 1,"FAULT";

$ No Load Diagnostic
      Param5 =      $ No load status of 0
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 01 30 6B",                $ Link Path to DOP object's No Load attribute.
                    0x0032,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable only.
                    0xC1,                               $ Data Type - boolean
                    1,                                  $ Data Size
                    "No Load Status #0",                $ Parameter Name
                    "",                                 $ Units String
                    "No Load or Open Wire status bit.\nNo load can only be detected when the channel is in the OFF state.\nField power is required to detect Open Load.\nNo Load status must be enabled.",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Enum5 =       0,"No Fault", 1,"No Load Detected";

      Param6  =     $ No load status of 1
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 02 30 6B",                $ Link Path to DOP object's No Load attribute.
                    0x0032,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable only.
                    0xC1,                               $ Data Type - boolean
                    1,                                  $ Data Size
                    "No Load Status #1",                $ Parameter Name
                    "",                                 $ Units String
                    "No Load or Open Wire status bit.\nNo load can only be detected when the channel is in the OFF state.\nField power is required to detect Open Load.\nNo Load status must be enabled.",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Enum6 =       0,"No Fault", 1,"No Load Detected";

$ Short/Overload Diagnostic
      Param7  =     $ Short/Overload status of 0
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 01 30 70",                $ Link Path to DOP object's Short attribute.
                    0x0032,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable only.
                    0xC1,                               $ Data Type - boolean
                    1,                                  $ Data Size
                    "Short/Overload Status #0",         $ Parameter Name
                    "",                                 $ Units String
                    "Short circuit or Overload status bit.\nError only detected in the ON state.\n\nPossible faults:\n - short circuit (0 ohm load)\n - too much current (greater than rated output current)\n - no field power\n\nError may be latched by Reset Mode ('latched off') or latching of alarms",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Enum7 =       0,"No Fault", 1,"Short/Overload Fault";

