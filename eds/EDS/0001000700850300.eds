                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 09 24 02 30 70",                $ Link Path to DOP object's Short attribute.
                    0x0032,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable only.
