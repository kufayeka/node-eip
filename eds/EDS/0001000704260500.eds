[Device]
    VendCode = 1;
    VendName = "Allen-Bradley Company, Inc.";
    ProdType = 7;
    ProdTypeStr = "General Purpose Discrete I/O";
    ProdCode = 1062;
    MajRev = 5;
    MinRev = 1;
    ProdName = "DSA 4/2 (100-DNY42R) 5.001";
    Catalog = "100-DNY42R";
    Icon = "DSA_225.ico";

    1_RSNetWorx_DNetTool = "LeoApp.LeoDevice";
    1_RSNetWorx_DNetToolEx = "1.00.00", "LeoApp.LeoDevice",
			"7.00","RSI.DeviceNet.EDSApplet.1";
    1_DNetEDSAppletPlugIn = "7.00.00", "DeviceLogixPlugIn.EDSAppletPlugIn.1";

[IO_Info]

    1_COSetSizeNotSupported = 1;
    
    Default = 0x0001;         $ The default I/O type is polled I/O.

    PollInfo =
      0x000D,                 $ OK to combine Poll and COS or Poll and Cyclic.
      1,                      $ Input1 entry is the default input connection.
      1;                      $ Output1 entry is the default output connection.

    COSInfo =
      0x0005,                 $ OK to combine Poll and COS.
      1,                      $ Input1 entry is the default input connection.
      1;                      $ Output1 entry is the default output connection.

    CyclicInfo =
      0x0009,                 $ OK to combine Poll and Cyclic.
      1,                      $ Input1 entry is the default input connection.
      1;                      $ Output1 entry is the default output connection.

    Input1 =
      1,                      $ The size in bytes that this connection produces.
      0,                      $ All bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Status",               $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 69 30 03", $ Path to Assembly 105.
                              $ Help string follows
     "Contains input data at bits 0-3, output status at bits 4-5, and sensor source voltage status at bit 7.";

    InputExa1 =
      ,                       $ Size from AssemN.
      ,                       $ Bits determined by AssemN member list
      0x000D,                 $ OK for Poll, COS or Cyclic.
      ,                       $ Name String from AssemN.
      ,                       $ Path Size not applicable
      VariantExa1,            $ Variant for choosing Input Assem
      ;                       $ Help string not applicable

    Input2 =
      1,                      $ The size in bytes that this connection produces.
      4,                      $ First 4 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "ODVA Status",          $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 03 30 03", $ Path to Assembly 3.
                              $ Help string follows
      "Contains hardware input data at bits 0-3";

    InputExa2 =
      1,                      $ The size in bytes that this connection produces.
      4,                      $ First 4 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "ODVA Status",          $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 03 30 03", $ Path to Assembly 3.
                              $ Help string follows
      "Contains hardware input data at bits 0-3";

    Input3 =
      8,                      $ 8 bytes
      64,                     $ 64 bits are significant
      0x000D,                 $ Poll, COS, Cyclic
      "Parameter Based",      $ Name String
      7,                      $ Path Size
      "21 04 00 24 64 30 03", $ Path to Assembly 100.
                              $ Help string follows
      "Contents determined by params 15-18";

    InputExa3 =
      8,                      $ 8 bytes
      64,                     $ 64 bits are significant
      0x000D,                 $ Poll, COS, Cyclic
      "Parameter Based",      $ Name String
      7,                      $ Path Size
      "21 04 00 24 64 30 03", $ Path to Assembly 100.
                              $ Help string follows
      "Contents determined by params 15-18";

    Input4 =
      2,                      $ The size in bytes that this connection produces.
      4,                      $ First 4 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Hdw Inputs",           $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B4 30 03", $ Path to Assembly 180.
                              $ Help string follows
      "Contains hardware input data at bits 0-3";

    InputExa4 =
      2,                      $ The size in bytes that this connection produces.
      4,                      $ First 4 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Hdw Inputs",           $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B4 30 03", $ Path to Assembly 180.
                              $ Help string follows
