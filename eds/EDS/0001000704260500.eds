    Output1 =
      1,                      $ The size in bytes that this connection consumes.
      2,                      $ Only the two least significant bits of this connection are used.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Command",              $ Name of Connection.
      7,                      $ Path length.
      "21 04 00 24 20 30 03", $ Path to Assembly 32.
                              $ Help string follows
      "Contains data for two hardware outputs.";

     OutputExa1 =
      ,                       $ Size from AssemN
