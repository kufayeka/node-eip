   "in the third two bytes of the Customizable Produced Assembly\n"
   "(Assembly 100).\n"
   "Valid values are:\n"
   "0:\tProduce no data from this and following positions\n"
   "1:\tHardware In States\n"
   "2:\tHardware Out States\n"
   "3:\tI/O Fault Status\n"
   "4:\tNetwork Inputs\n"
   "5:\tNetwork Outputs\n"
   "6:\tModule Status\n"
   "7:\tFunction Blocks 1-16\n"
   "8:\tFunction Blocks 17-32\n"
   "9:\tFunction Blocks 33-42\n",
   0,9,                       $ Min, Max values
   5,                         $ Default value
   1,1,1,0,                   $ Scaling factors
   0,0,0,0,                   $ Scaling links
   0;                         $ Decimal Places

