      0x000D,                 $ OK for Poll, COS or Cyclic.
      "IO Flt Status",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B6 30 03", $ Path to Assembly 182.
                              $ Help string follows
      "Contains input fault status at bits 0, output A fault status at bit 1, output B status at bit 2";

