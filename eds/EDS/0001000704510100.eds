		4, 1,				$ Data Type and Size - (Boolean)
		"Off-Delay/One-shot Timebase",	$ Name
		" ",				$ Units (Not Used)
		"Select a timebase of 1 ms or 10 ms for Off-Delay/One-Shot Timer",		 $ Help 
		0,1,0,		      		$ min, max, default values
		1,1,1,0,			$ mult, div, base, offset scaling (Not Used)
		1,1,1,0,			$ mult, div, base, offset links (Not Used)
