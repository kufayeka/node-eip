		0x02,				$ Descriptor - (Support Enumerated Strings) 
		8, 1,				$ Data Type and Size - (USINT)
		"Off-Delay/One-shot Type",	$ Name
		" ",				$ Units (Not Used)
		"Select type of Off-Delay/One-Shot Timer",		 $ Help 
		0,3,0,		       		$ min, max, default values
		1,1,1,0,			$ mult, div, base, offset scaling (Not Used)
		1,1,1,0,			$ mult, div, base, offset links (Not Used)
		0;				$ decimal places

	Param7 = 				$ Off-Delay/One-Shot Timer Timebase
		0,				$ Data Placeholder
		6, "20 ed 24 02 30 08",	$ Path size and Path to timebase Attribute
