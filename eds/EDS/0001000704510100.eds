$ DeviceNet Pendant Station
$ Description: 	The following file is the EDS for the Allen-Bradley 
$		 DeviceNet Pendant Station
$ Author:	Lou Smet
$ Date:	 	03-20-2000
$
$ Edit History:	LS	12/17/99	Created

[File]
	DescText = "800E-PND2 Pendant Station";

	CreateDate = 03-20-2000;
	CreateTime = 12:00:00;
	Revision = 1.2;

[Device]
	VendCode = 1;
	ProdType = 7;
	ProdCode = 1105;

	MajRev = 1;
	MinRev = 1;

	VendName = "Allen-Bradley";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName = "800E-PND2 Pendant Station";

	Catalog ="800E-PND2";

[IO_Info]

	Default = 0x04;			$ The default I/O type is COS

	PollInfo = 0x01, 0, 0;		$ Not supported

	COSInfo = 0x04, 1, 1;		$ Use Input1 and Output1

	StrobeInfo = 0x02, 2, 2;	$ Use Input2 and Output2

	Input1 =
		1,				$ 1 byte
		8,				$ 8 bits used
		0x0004,				$ COS only
		" Output ",			$ Name
		6,				$ Path size
		"20 04 24 01 30 03",   			$ Path to ID value attribute
		"Input and Status from IO_block."; 	$ Help string

	Output1 =
		1,				$ 1 byte
		1,				$ 1 bit used
		0x0004,				$ COS only
		"",				$ Name
		6,				$ Path size
		"20 04 24 22 30 03",   		$ Path to ID value attribute
		"";				$ Help string

	Input2 =
		1,				$ 1 byte
		8,				$ 8 bits used
		0x0002,				$ Strobe only
		" Output ",			$ Name
		6,				$ Path size
		"20 04 24 01 30 03",   			$ Path to ID value attribute
		"Input and Status from IO_block."; 	$ Help string

	Output2 =
		0,				$ 0 bytes
		0,				$ 0 bits used
		0x0002,				$ Strobe only
		"",				$ Name
		6,				$ Path size
		"20 04 24 22 30 03",   		$ Path to ID value attribute
		"";				$ Help string

[ParamClass]
	MaxInst = 16;
	Descriptor = 0x09;
	CfgAssembly = 0x00;

[Params]
	Param1 = 				$ Input
		0,				$ Data Placeholder
		6, "20 08 24 01 30 03",		$ Path size and Path to Output Attribute
		0x12,				$ Descriptor - (Support Enumerated Strings, Read-only)
		4, 1,				$ Data Type and Size - (Boolean)
		"Input",			$ Name
		"",				$ Units (Not Used)
		"The Input state. This includes the effects of Timers.", 	$ Help
		0,1,0,				$ min, max, default values
		1,1,1,0,			$ mult, div, base, offset scaling (Not Used)
		1,1,1,0,			$ mult, div, base, offset links (Not Used)
		0;				$ decimal places

	Param2 = 				$ On-Delay Timer Elapsed Time
		0,				$ Data Placeholder
		6, "20 ed 24 01 30 07",		$ Path size and Path to Elapsed Time Attribute
		0x10,				$ Descriptor - (Read-only)
		2, 2,				$ Data Type and Size - (UINT)
		"On-Delay Elapsed Time",	$ Name
		" ",				$ Units (Not Used)
		"Current On-Delay Timer value",	$ Help 
		0,65535,0,		   	$ min, max, default values
		1,1,1,0,		      	$ mult, div, base, offset scaling (Not Used)
		1,1,1,0,		      	$ mult, div, base, offset links (Not Used)
		0;				$ decimal places

