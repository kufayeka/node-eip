		6, "20 09 24 01 30 06",		$ Path size and Path to Operate Mode Attribute
		0x02,				$ Descriptor - (Support Enumerated Strings)
		4, 1,				$ Data Type and Size - (Boolean)
		"Output Fault Value",		$ Name
		" ",				$ Units (Not Used)
		"Value for use with Output Fault Action attribute (see Parameter 11).\n"
		"If FAULT VALUE in Parameter 11 was chosen, this forces OUTPUT to ON or OFF in a fault state.\n"
