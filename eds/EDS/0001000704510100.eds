[EnumPar]
	Param1 =			$ Input Enumerated Strings
		"Input OFF",		$ For value = 0
		"Input ON";			$ For value = 1

	Param4 =			$ On-Delay Timer Timebase
		" 1 ms",		$ For value = 0
		"10 ms";		$ For value = 1

	Param6 =			$ Off-Delay/One-Shot Timer  type
		"Disabled",		$ For value = 0
		"One-Shot",		$ For value = 1
		"Not supported",	$ For value = 2
		"Off-Delay";		$ For value = 3

	Param7 =			$ Off-Delay/One-Shot Timer Timebase
		"1 ms",			$ For value = 0
		"10 ms";		$ For value = 1

	Param9 =					$ Output Value
		"Output OFF",			$ For value = 0
		"Output ON";			$ For value = 1
	
