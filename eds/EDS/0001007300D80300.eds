      Param101 =                    $ Revision of Configuration Assembly
        0,                          $ first field shall equal 0
        ,,                          $ path size,path
        0x0210,                     $ descriptor (readonly, no display)
        0xC7,                       $ data type : 16-bit Unsigned Integer
        2,                          $ data size in bytes
        "Configuration revision",   $ name
        "",                         $ units
        "",                         $ help string
        1,1,1,                      $ min,max,default data values
        0,0,0,0,                    $ mult,dev,base,offset scaling not used
        0,0,0,0,                    $ mult,dev,base,offset link not used
        0;                          $ decimal places not used

      Param102 =                    $ non-Logix header
        0,                          $ first field shall equal 0
        ,,                          $ path size,path
        0x0210,                     $ descriptor (readonly, no display)
        0xC7,                       $ data type : 16-bit Unsigned Integer
        2,                          $ data size in bytes
        "Non-Logix Header",         $ name
        "",                         $ units
        "",                         $ help string
        0x7001,0x7001,0x7001,       $ min,max,default data values
        0,0,0,0,                    $ mult,dev,base,offset scaling not used
        0,0,0,0,                    $ mult,dev,base,offset link not used
        0;                          $ decimal places not used

[Assembly]
	Revision = 2;

	Assem101 = "Status","",
		,,,,
		8,Param52,
		8,Param53,
		8,Param89,
		8,Param90;

	Assem102 = "Data","",
		,0x0000,,,
		16,Param47,
		16,Param48,
		16,Param87,
		16,Param88;

	Assem123 = "1738-OE4C Configuration Assembly","",
		,0x0000,,,				$18 bytes *4 = 72bytes
			
		16,Param14,	$Fault Value #0
		16,Param16,	$Idle Value #0
		16,Param18,	$Low Scaling #0
		16,Param20,	$High Scaling #0
		16,Param22,	$Low Clamp #0
		16,Param24,	$High Clamp #0
		8,Param6,	$Output Range #0
		8,Param10,	$Fault State #0
		8,Param12,	$Idle State #0			
		8,Param26,	$Enable Alarm Latch #0
		8,Param28,	$Disable Alarms #0
		8,,
		16,Param15,	$Fault Value #1
		16,Param17,	$Idle Value #1
		16,Param19,	$Low Scaling #1
		16,Param21,	$High Scaling #1
		16,Param23,	$Low Clamp #1
		16,Param25,	$High Clamp #1
		8,Param7,	$Output Range #1
		8,Param11,	$Fault State #1
		8,Param13,	$Idle State #1
		8,Param27,	$Enable Alarm Latch #1
		8,Param29,	$Disable Alarms #1
		8,,		
		16,Param65,	$Fault Value #2
		16,Param67,	$Idle Value #2
		16,Param69,	$Low Scaling #2
		16,Param71,	$High Scaling #2
		16,Param73,	$Low Clamp #2
		16,Param75,	$High Clamp #2
		8,Param57,	$Output Range #2
		8,Param61,	$Fault State #2
		8,Param63,	$Idle State #2
		8,Param77,	$Enable Alarm Latch #2
		8,Param79,	$Disable Alarms #2
		8,,
		16,Param66,	$Fault Value #3
		16,Param68,	$Idle Value #3
		16,Param70,	$Low Scaling #3
		16,Param72,	$High Scaling #3
		16,Param74,	$Low Clamp #3
		16,Param76,	$High Clamp #
		8,Param58,	$Output Range #3
		8,Param62,	$Fault State #3
		8,Param64,	$Idle State #3
		8,Param78,	$Enable Alarm Latch #3
		8,Param80,	$Disable Alarms #3
		8,;
    Assem124 =                  $ Private config in Forward Open, Module
        "3rd Party Private Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param101,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem125 =                  $ Private config in Forward Open, Module
        "Adapter Config Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param102,            $ Non-Logix Header (constant 0x7001)
        16,1_RackSize,          $ number of slots
        16,Param101,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem126 =                  $ O2T (output data)
        "Ouput Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        ,Assem102;              $ Assembly sent to module

    Assem127 =                  $ T2O (input data)
        "Input Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        32,,                    $ Fault bits
        ,Assem101;              $ Assembly passed from module

[ParamClass]
	MaxInst = 102;
	Descriptor  = 0x09;       $ Bit 0: 1= parameter instances exist
                                $ Bit 1: 0= not full
                                $ Bit 2: 0= NVS command not needed
                                $ Bit 3: 1= Automaticly stored in EERPOM
	CfgAssembly = 123;

[Groups]
	Group1 = "I/O - Output Values", 4,
		2,3,54,91;
	Group2 = "I/O - Output Status", 13,
		4,5,55,56,30,31,81,82,32,33,83,84,43;
	Group3 = "Configuration", 50,
		1,6,7,57,58,8,9,59,60,10,11,61,62,12,13,63,64,14,15,65,66,16,17,67,68,18,19,69,70,20,21,71,72,22,23,73,74,24,25,75,76,26,27,77,78,28,29,79,80,36;
	Group4 = "Calibration", 14,
		34,35,85,86,37,38,39,40,41,92,93,94,95,96;
	Group5 = "PointBus", 3,
		44,45,46;

[IO_Info]
	1_COSetPathNotSupported = 1;                      $ Cnxn Obj does not support direct path setting

	Default = 0x4;

	PollInfo = 0xF,
		1,
		1;

	StrobeInfo = 0xF,
		1,
		0;

	COSInfo = 0x7,
		1,
		1;

	CyclicInfo = 0xB,
		1,
		1;

	Input1 = 4,
		0, 
		0xF, 
		"Status",
		6,
		"20 04 24 65 30 03",
		"Producing connection contains status of the four outputs.";

	Output1 = 8,
		0, 
		0xD, 
		"Data",
		6,
		"20 04 24 66 30 03",
		"Consume connection contains value of the four outputs.";

[Connection Manager]
    Connection7 =       $ Exclusive Owner (Direct to Module)
                        $ Catalogs        1738-OE4C, OE4V	
                        $ Config Assem    123	
                        $ Consume Assem   102	
                        $ Produce Assem   101	
        0x04030002,     $ trigger & transport
        0x44240405,     $ point/multicast & priority & realtime format
        ,,Assem126,     $ O=>T default,description
        ,,Assem127,     $ T=>O default,description
        ,Assem124,      $ config part 1
        ,Assem123,      $ config part 2
        "Direct Exclusive Owner",  $ connection name
        "Direct Exclusive Owner Connection - Output data controls the state (analog level) of each of the outputs. Input data contains status of each of the outputs.",   $ Help string
        "20 04 24 7B 2C 66 2C 65";

$   Connection27 =      $ No Input Only Connection

    Connection47 =      $ Listen Only (non-Logix Direct to Module)
                        $ Catalogs        1738-OE4C, OE4V	
                        $ Config Assem    123	
                        $ Consume Assem   0xBF (Listen Only)	
                        $ Produce Assem   101	
        0x01030002,     $ trigger & transport
        0x44240305,     $ point/multicast & priority & realtime format
        ,0,,            $ O=>T default,description
        ,,Assem127,     $ T=>O default,description
        ,,              $ config part 1
        ,,              $ config part 2
        "Direct Listen Only",  $ connection name
        "Direct Listen Only Connection - Input data contains the STATUS of each of the outputs. There is NO output data.",   $ Help string
        "20 04 24 7B 2C BF 2C 65";

[Port]
      Port1 =       DeviceNet,                          $ or maybe 1_Virtual_Backplane
                    "PointIO Backplane",                $ Name of backplane
                    "20 03 24 01",                      $ Path to DeviceNet Object Instance 1
                    1;                                  $ Port number 1

