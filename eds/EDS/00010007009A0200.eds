1, Param50,                    $ Connector G Input Short Circuit (byte 1)
1, Param51,                    $ Connector H Input Short Circuit (byte 1)
1, Param44,                    $ Connector A Input Open Wire (byte 2)
1, Param45,                    $ Connector B Input Open Wire (byte 2)
1, Param46,                    $ Connector C Input Open Wire (byte 2)
1, Param47,                    $ Connector D Input Open Wire (byte 2)
1, Param52,                    $ Connector E Input Open Wire (byte 2)
1, Param53,                    $ Connector F Input Open Wire (byte 2)
1, Param54,                    $ Connector G Input Open Wire (byte 2)
1, Param55;                    $ Connector H Input Open Wire (byte 2)

 Assem4 = 
"Input Only",                  $ Name of Connection.
"20 04 24 04 30 03",           $ Path to I/O Production Assembly.
1,                             $ The size in bytes that this connection produces.
0, , ,                         $ Not editable, not modular.
8, Param4;                     $ 8 input values (byte 0)


Assem152 = 
"Data - DeviceLogix",          $ Name of Connection.
"20 04 24 98 30 03",           $ Path to I/O Production Assembly.
5,                             $ The size in bytes that this connection produces.
0, , ,                         $ Not editable, not modular.
8, Param4,                     $ 8 input values (byte 0)
1, Param40,                    $ Connector A Input Short Circuit (byte 1)
1, Param41,                    $ Connector B Input Short Circuit (byte 1)
1, Param42,                    $ Connector C Input Short Circuit (byte 1)
1, Param43,                    $ Connector D Input Short Circuit (byte 1)
1, Param48,                    $ Connector E Input Short Circuit (byte 1)
1, Param49,                    $ Connector F Input Short Circuit (byte 1)
1, Param50,                    $ Connector G Input Short Circuit (byte 1)
1, Param51,                    $ Connector H Input Short Circuit (byte 1)
1, Param44,                    $ Connector A Input Open Wire (byte 2)
1, Param45,                    $ Connector B Input Open Wire (byte 2)
1, Param46,                    $ Connector C Input Open Wire (byte 2)
1, Param47,                    $ Connector D Input Open Wire (byte 2)
1, Param52,                    $ Connector E Input Open Wire (byte 2)
1, Param53,                    $ Connector F Input Open Wire (byte 2)
1, Param54,                    $ Connector G Input Open Wire (byte 2)
1, Param55,                    $ Connector H Input Open Wire (byte 2)
5, ,                        
1, Param59,                    $ DeviceLogix Enabled
2, ,                       
8, Param60;                    $ Produced DeviceLogix Data


Assem199 =                 $0x0
"No Data",                 $ Name of Connection.
"",                        $ Path to I/O Consume Assembly.
0,                         $ The size in bytes that this connection consumes.
0, , ,                     $ Not editable, not modular.
0, ;

Assem160 =              $0xA0
"No Consumed",          $ Name of Connection.
"20 04 24 A0 30 03",    $ Path to I/O Consume Assembly.
0,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
0,;                     $ 8 output values (byte 0)
Assem161 =              $0xA1
"1 byte Consumed",      $ Name of Connection.
"20 04 24 A1 30 03",    $ Path to I/O Consume Assembly.
1,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
8, Param62;                        $ 8 output values (byte 0)
Assem162 =              $0xA2
"2 bytes Consumed",     $ Name of Connection.
"20 04 24 A2 30 03",    $ Path to I/O Consume Assembly.
2,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
8, Param62,             $ 8 output values (byte 0)
8, Param62;             $ 8 output values (byte 1)
Assem163 =              $0xA3
"3 bytes Consumed",     $ Name of Connection.
"20 04 24 A3 30 03",    $ Path to I/O Consume Assembly.
3,                      $ The size in bytes that this connection produces.
0, , ,                  $ Not editable, not modular.
8, Param62,             $ 8 output values (byte 0)
8, Param62,             $ 8 output values (byte 0)
8, Param62;             $ 8 output values (byte 0)
Assem164 =              $0xA4
"4 bytes Consumed",     $ Name of Connection.
"20 04 24 A4 30 03",    $ Path to I/O Consume Assembly.
4,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
8, Param62,             $ 8 output values (byte 0)
