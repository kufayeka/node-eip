Param61 =                  $ Enable Quick Start
0,                         $ reserved
7,                         $ Link Path Size
"21 03 00 24 01 30 66",    $ Link Path to enable Quick Start attribute.
0x0002,                    $ No support for settable path, scaling, scaling links, or
                           $ real time update of value.  Value is gettable and 
                           $ Settable.  Enumerated strings are supported.
0xC1,                      $ Data Type - boolean
1,                         $ Data Size
"Quick Connect",           $ Parameter Name
"",                        $ Units String
   $$$$$$$$$$ Help string $$$$$$$$$$$
"Setting this parameter Enabled disables Autobaud and LED test in the block. The change occurs at the next power up."
" Baud rate remains at the present value. Default is Disabled.",
0,1,0,                     $ Min, Max, and Default values
,,,,,,,,;                  $ Not Used

Enum61 =       0,"Disabled", 1,"Enabled";


