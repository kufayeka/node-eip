8, Param62,             $ 8 output values (byte 0)
8, Param62;             $ 8 output values (byte 0)

Assem166 =             $0xA6
"Configuration",       $ Name of Connection.
,                      $ Path to Assembly.
5,                     $ The size in bytes.
0, , ,                 $ Not editable, not modular.
1,Param1,              $ Autobaud                  (byte 0 bit 0)
1,Param61,             $ Quick Connect             (byte 0 bit 1)
6, ,                   $ 6 pad bits                (byte 0 bit 2)
8,Param2,              $ Off to On Input filter    (byte 1)
8,Param3,              $ On to Off Input filter    (byte 2)
1,Param13,             $ OW Enable In A            (byte 5 bit 0)
1,Param14,             $ OW Enable In B            (byte 5 bit 1)
1,Param15,             $ OW Enable In C            (byte 5 bit 2)
1,Param16,             $ OW Enable In D            (byte 5 bit 3)
1,Param17,             $ OW Enable In E            (byte 5 bit 4)
1,Param18,             $ OW Enable In F            (byte 5 bit 5)
1,Param19,             $ OW Enable In G            (byte 5 bit 6)
1,Param20,             $ OW Enable In H            (byte 5 bit 7)
4,Param22,             $ produced I/O Assembly
4,Param21;             $ Consumed I/O Assembly

VariantExa1 =
    ,,,,,
    Param22,
    0x00, Assem151,
    0x01, Assem4,
    0x02, Assem152;
 
