[Port]
        Port1 =
                TCP,
                "EthernetIP Port",
                "20 F5 24 01",
                2;

[Capacity]
        ConnOverhead = .0;
        MaxIOConnections = 5;
        MaxMsgConnections = 5;
        MaxConsumersPerMcast = 5;
        TSpec1 = Tx, 8, 2000;
        TSpec2 = Rx, 2, 2000;


