[Connection Manager]
        1_Display_Only_Connection1 =
                0x04030002,             $ trigger & transport
                                        $   0-15  = supported transport classes (class 1)
                                        $ 	16    = cyclic (1 = supported)
                                        $ 	17    = change of state (1 = supported)
                                        $   18    = app triggered
                                        $ 	19-23 = reserved (must be zero)
                                        $ 	24-27 = exclusive owner
                                        $           24 Listen Only
                                        $           25 Input Only
                                        $           26 Exclusive Owner
                                        $           27 Redundant Owner
                                        $ 	28-30 = reserved (must be zero)
                                        $ 	31    = client 0 (don't care for classes 0 and 1)
                0x44640405,             $ point/multicast & priority & realtime format
                                        $   0     = O=>T fixed
                                        $   1     = O=>T variable
                                        $   2     = T=>O fixed
                                        $   3     = T=>O variable
                                        $   4-5   = Resv
                                        $   6-7   = Resv
                                        $   8-11  = O=>T header
                                        $           0 None
                                        $           1 Zero length equal idle
                                        $           2 Resv
                                        $           3 Heartbeat
                                        $           4 32bit run/idle
                                        $           5 Safety
                                        $   12-15 = T=>O header
                                        $           0 None
                                        $           1 Zero length equal idle
                                        $           2 Resv
                                        $           3 Heartbeat
                                        $           4 32bit run/idle
                                        $           5 Safety
                                        $   16-19 = O=>T Connection type
                                        $           16 Null
                                        $           17 Multicast
                                        $           18 Point 2 Point
                                        $ 	20-23 = T=>O multicast, point 2 point
                                        $           20 Null
                                        $           21 Multicast
                                        $           22 Point 2 Point
                                        $ 	24-27 = O=>T scheduled
                                        $           24 Low
                                        $           25 High
                                        $           26 Scheduled
                                        $ 	28-31 = T=>O scheduled
                                        $           28 Low
                                        $           29 High
                                        $           30 Scheduled
                ,408,,                  $ O=>T RPI,Size,Format
                ,176,,                  $ T=>O RPI,Size,Format
                ,,                      $ config part 1
                ,,                      $ config part 2 (not used)
                "Data - Scheduled Per Point",    $ connection name
                "",                     $ Help string
                "20 04 24 68 2C A7 2C 87";    $ Path

        1_Display_Only_Connection2 =
                0x04030002,             $ trigger & transport
                0x44640405,             $ point/multicast & priority & realtime format
                ,192,,                  $ O=>T RPI,Size,Format
