[File]
	DescText    = "ArmorPoint 1738-IB16DM12/A";
	CreateDate  = 08-25-2006;
	CreateTime  = 15:00:00;
	ModDate     = 08-25-2006;
	ModTime     = 15:01:00;
	Revision    = 1.0;
	HomeURL    = "http://www.ab.com/networks/eds/DN/0001000701390300.eds";

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 313;                                $ Product Code

	MajRev      = 3;                                  $ Major Rev
	MinRev      = 10;                                 $ Minor Rev
	VendName    = "Allen-Bradley Company, Inc.";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "1738-IB16DM12 16pt DC Input";
	Catalog     = "1738-IB16DM12/A";
	Icon        = "1738-8M12BLUE_16.ico";
	1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
	1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
     Class1 =      DeviceNet;

[IO_Info]
	1_COSetSizeNotSupported = 1;                    $ Cnxn Obj does not support direct connection size setting

	Default =     0X0004;                           $ COS is default

	PollInfo =    0X000F,                           $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      COSInfo =     0X0007,                             $ Compatable with all but cyclic
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      CyclicInfo =  0X000B,                             $ Compatable with all but COS
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

	Input1 =    3,                                  $ size = 3 bytes
                    0,                                 $ 24 significant bits
                    0X000F,                             $ compatible with all conections
                    "Data - with Status",               $ name string
                    6,                                  $ path length
                    "20 04 24 65 30 03",                $ assy obj, inst 101, attr 3
                    "Producing connection contains state of the sixteen inputs (bits 0-15) in bytes 1 and 2. Diagnostics are contained in byte 3";

	Input2 =    2,                                  $ size = 2 bytes
                    0,                                 $ 16 significant bits
                    0X000F,                             $ compatible with all conections
                    "Data - without Status",            $ name string
                    6,                                  $ path length
                    "20 04 24 05 30 03",                $ assy obj, inst 101, attr 3
                    "Producing connection contains state of the sixteen inputs (bits 0-15) in bytes 1 and 2";

	InputExa1 =
			  ,               		$ Size from AssemN
			  ,               		$ Bits determined by AssemN member list
			  0x000D,         		$ Poll, COS, Cyclic
			  ,               		$ Name String from AssemN
			  ,               		$ Path Size not applicable
			  VariantExa1,    		$ Variant for choosing Input Assem
			  ;               		$ Help string not applicable
		 
	 

[ParamClass]
	MaxInst     = 102;
	Descriptor  = 0x09;                      $ Bit 0: 1= parameter instances exist
                                                 $ Bit 1: 0= not full
                                                 $ Bit 2: 0= NVS command not needed
                                                 $ Bit 3: 1= Automaticly stored in EERPOM
	CfgAssembly = 0x67;                      $ the custom config assembly is 103d

[Assembly]

	VariantExa1 = "Produced IO Assembly Instance"
    		,,,,,
    		Param28,
    		0x00, Assem101,
    		0x01, Assem5;

 	Assem5 =   "Data - without Status",
            "",                                 $ Path is implied (Assy obj attr3)
            2,                                  $ total length in bytes
            0,,,                                $ no changes, ",,"= reserved
            1, Param1,                          $ Input 0 value
            1, Param2,                          $ Input 1 value
            1, Param3,                          $ Input 2 value
            1, Param4,                          $ Input 3 value
            1, Param5,                          $ Input 4 value
            1, Param6,                          $ Input 5 value
            1, Param7,                          $ Input 6 value
            1, Param8,                          $ Input 7 value
            1, Param9,                          $ Input 8 value
            1, Param10,                         $ Input 9 value
            1, Param11,                         $ Input 10 value
            1, Param12,                         $ Input 11 value
            1, Param13,                         $ Input 12 value
            1, Param14,                         $ Input 13 value
            1, Param15,                         $ Input 14 value
            1, Param16;                         $ Input 15 value


 	Assem101 =  "Data - with Status",
            "",                                 $ Path is implied (Assy obj attr3)
            3,                                  $ total length in bytes
            0,,,                                $ no changes, ",,"= reserved
            1, Param1,                          $ Input 0 value
            1, Param2,                          $ Input 1 value
            1, Param3,                          $ Input 2 value
            1, Param4,                          $ Input 3 value
            1, Param5,                          $ Input 4 value
            1, Param6,                          $ Input 5 value
            1, Param7,                          $ Input 6 value
            1, Param8,                          $ Input 7 value
            1, Param9,                          $ Input 8 value
            1, Param10,                         $ Input 9 value
            1, Param11,                         $ Input 10 value
            1, Param12,                         $ Input 11 value
            1, Param13,                         $ Input 12 value
            1, Param14,                         $ Input 13 value
            1, Param15,                         $ Input 14 value
            1, Param16,                         $ Input 15 value
            1, Param17,                 	$ SSV status 0-3
            1, Param18,                 	$ SSV status 4-7
            1, Param19,                         $ SSV status 8-11
            1, Param20,                         $ SSV Status 12-15
            1, Param21,                         $ Fault LED State
            1,,                         	$ Not Used
            1,,                         	$ Not Used
            1,,                         	$ Not Used
            0,;                                 $ Pad bits

	Assem103 =  "Configuration Assembly",
      	"",                                 $ Path is implied (Assy obj attr3)
            6,                              $ total length in bytes
            0,,,                            $ changes, ",,"= reserved
            16,	Param30,                    $ # bits, Off2On Filter 0_15
            16,	Param31,                    $ # bits, On2Off Filter 0_15
	     8, Param28,		    $ Produced Assembly
	     8,;			    $ Pad bits
	
	Assem124 =                  $ Private config in Forward Open, Module
        	"3rd Party Private Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,,                      $ reserved
        	16,Param101,            $ configuration revision (only valid value is 1)
        	16,;                    $ reserved - zeros

    	Assem125 =                  $ Private config in Forward Open, Module
        	"Adapter Config Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,,                      $ reserved
        	16,Param102,            $ Non-Logix Header (constant 0x7001)
        	16,1_RackSize,          $ number of slots
        	16,Param101,            $ configuration revision (only valid value is 1)
        	16, ;                   $ reserved - zeros

    	Assem126 =                  $ O2T (output data)
        	"Ouput Data Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,                       $ reserved
        	;                       $ No Assembly sent to module

    	Assem127 =                  $ T2O (input data)
        	"Input Data Assembly",
        	,                       $ Path
        	,                       $ Length in bytes
        	,                       $ descriptor
        	,,                      $ reserved
        	32,,                    $ Fault bits
        	,Assem101;              $ Assembly passed from module


      ProxiedAssem3 = 
            "Real Time Input Format",
            ,                                   $ No Path
            ,                                   $ Length
            0x0000,                             $ Descriptor
            ,,                                  $ ",,"= reserved
            24,Assem101;

      ProxiedAssem4 = 
            "Real Time Output Format",
            ,                                   $ No Path
            ,                                   $ Length
            0x0000,                             $ Descriptor
            ,                                   $ ",,"= reserved
            ;                                   $ Nothing

