Group2="Monitoring",2,4,5;


[EnumPar]
Param1="AutoBaud Active","AutoBaud Inactive";
Param2="0 ms","2 ms","4 ms","8 ms","16 ms";
Param3="0 ms","2 ms","4 ms","8 ms","16 ms";
Param6="Use Fault Value","Hold Last State";
Param7="Reset Outputs","Turn Outputs On";
Param8="Use Idle Value","Hold Last State";
Param9="Reset Outputs","Turn Outputs On";
Param10="Quick Connect Disabled","Quick Connect Enabled";
