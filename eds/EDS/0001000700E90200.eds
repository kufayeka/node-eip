$ Electronic Data Sheet for Embedded I/O (1799-D16U16V)

[File]
DescText = "1799-D16U16V Embedded  I/O EDS File";
CreateDate = 03-5-2004;
CreateTime = 12:00:00;
ModDate = 05-25-2006;
ModTime = 13:00:00;
Revision = 1.04;		$ EDS revision.
HomeURL    = "http://www.ab.com/networks/eds/DN/0001000700E90200.eds";

[Device]
VendCode = 1;
VendName = "Rockwell Automation/Allen-Bradley";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 233;
MajRev = 2;
MinRev = 2;
Icon = "36pt_Omni.ico";

ProdName = "1799-D16U16V 16 IN / 16 SNK OUT";
Catalog = "1799-D16U16V";
DNetQC=0B0000000000000001, 200; $ Quick Connect supported at power up. 200ms powerup time

[Device Classification]
Class1 = DeviceNet;

[IO_Info]
1_COSetPathNotSupported = 1;	$Paths not settable.
1_COSetSizeNotSupported = 1;	$Paths not settable.

Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x000d,		$ Poll connection can be used with COS or cyclic I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

COSInfo=
0x0005,		$ COS connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

CyclicInfo=
0x0009,		$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.
 
Input1 =
2,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x000D,		$ Polled and COS I/O device.
"Data",     $ Name of Connection.
7,			$ Path length.
"21 04 00 24 07 30 03",	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 3 bytes: Byte 1, bits 0-7=Inputs 0-7.\nByte 2, bits 0-7=Inputs 8-15\nByte 3.";
			
Output1 =
2,			$ The size in bytes that this connection consumes.
0,			$ All bits of this connection are significant. 
0x000D,		$ Polled and COS I/O device.
"Data",     $ Name of Connection.
7,			$ Path length.
"21 04 00 24 25 30 03",	$ Path to I/O Consumption Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 2 bytes: Byte 1, bits 0-7=Outputs 0-7.\nByte 2, bits 0-7=Outputs 8-15.";
			 
[ParamClass]
MaxInst = 59;		    $ parameters.
Descriptor =  0x09;		$ Stub param instances in eeprom.
CfgAssembly = 0x00;	    $ The config assembly is instance #104 of assy obj.		
1_CfgAssembly = 0xA9;	$ Config assembly.

[Params]
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param1 =		    	$ Disable Autobaud
0,			            $ reserved
7,		            	$ Link Path Size
"21 03 00 24 01 30 64",	$ Link Path to disable autobaud attribute.
0x0002,		        	$ No support for settable path, scaling, scaling links, or
			            $ real time update of value.  Value is gettable and 
		            	$ Settable.  Enumerated strings are supported.
0xC1,		    		$ Data Type - boolean
1,		            	$ Data Size
"Autobaud",		        $ Parameter Name
"",		            	$ Units String
	$$$$$$$$$$ Help string $$$$$$$$$$$
"Setting this parameter ON disables the Autobaud feature in the block. The\nchange occures after the next power up. Default is Enabled.",
0,1,0,		        	$ Min, Max, and Default values
,,,,,,,,;				$ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
