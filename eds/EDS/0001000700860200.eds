[File]
	DescText =    "PointIO 1734-OB4E/B";                   
	CreateDate =  06-15-1999;                            
	CreateTime =  14:25:38;                         
	ModDate     = 03-15-2006;
	ModTime     = 06:50:00;                            
	Revision =    2.5;                              

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 134;                                $ Product Code

	MajRev      = 2;                                  $ Major Rev
	MinRev      = 2;                                  $ Minor Rev
	VendName    = "Allen-Bradley Company, Inc.";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "PointIO 4pt 24Vdc Source Output Enhanced";
	Catalog     = "1734-OB4E/B";
      Icon		= "1734green.ico";

[IO_Info]
	Default =     0X0004;                             $ COS is default

	PollInfo    = 0X000F,                             $ compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ No strobe connection here

      COSInfo =     0X0007,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      CyclicInfo =  0X000B,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

	Input1 =      1,                                  $ size = 1 byte
                    4,                                  $ 4 significant bits
                    0X000F,                             $ compatible with all conections
                    "1734-OB4E Produce Connection",     $ name string
                    6,                                  $ path length
                    "20 04 24 2B 30 03",                $ assy obj, inst 43d, attr 3
                    "Producing connection contains the status of the outputs";

	Output1 =     1,                                  $ size = 1 byte
                    4,                                  $ 4 significant bits
                    0X000D,                             $ compatible with polled connection
                    "1734-OB4E Consuming Connection",   $ name string
                    6,                                  $ path length
                    "20 04 24 21 30 03",                $ assy obj, inst 33d(0x21), attr 3
                    "Consuming connection contains state of the four outputs";

[ParamClass]
	MaxInst =     55;
	Descriptor =  0x09;                               $ Individual parameters are setable
                                                        $ Automaticly stored in EERPOM
	CfgAssembly = 0x7B;                               $ the custom config assembly is 123d

[Assembly]
        Assem33=    "1734-OB4E Consume Assembly",
                    "",                                 $ Path is implied (Assy obj attr3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    1, Param1,                          $ # bits, Value for Output #0
                    1, Param2,                          $ # bits, Value for Output #1
                    1, Param3,                          $ # bits, Value for Output #2
                    1, Param4,                          $ # bits, Value for Output #3
                    4,;                                 $ Pad bits

        Assem43=    "1734-OB4E Produce Assembly",
                    "",                                 $ Path is implied (Assy obj attr3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    1, Param5,                          $ # bits, Status of Output 0
                    1, Param6,                          $ # bits, Status of Output 1
                    1, Param7,                          $ # bits, Status of Output 2
                    1, Param8,                          $ # bits, Status of Output 4
                    4,;                                 $ Pad bits

