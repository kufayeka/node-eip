$ Electronic Data Sheet for Armor Block I/O  (1792-IB16LP)

[File]
DescText = "1792-IB16LP Armor Block I/O EDS File";
CreateDate = 06-27-1997;
CreateTime = 12:00:00;
ModDate = 12-21-1999;
ModTime = 16:41:00;
Revision = 1.3;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1048;
MajRev = 2;
MinRev = 5;
ProdName = "1792-IB16LP 16Input";
Catalog="1792-IB16LP";
1_Icon=0001_Armorlp.ico;

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x0007,		        $ Polled, Strobed and COS I/O device.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

StrobeInfo=
0x0007,                 $ Polled, Strobed and COS I/O device.
1,                      $ Input1 entry is the default input connection.
0;                      $ There is no consuming connection.

COSInfo=
0x0007,                 $ Polled, Strobed and COS I/O device.
1,                      $ Input1 entry is the default input connection.
0;                      $ There is no consuming connection.

Input1 =
3,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x0007,			$ Polled, Strobed and COS I/O device.
"IB16LP Production Data",$ Name of Connection.
6,			$ Path length.
"20 04 24 0F 30 03",	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains input data in bytes 0 and 1 and sensor source voltage status at bit 7 of byte 2.";

[ParamClass]
MaxInst = 17;		$ 17 read-only and no configurable parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x00;	$ The config assembly is not supported.		

