                    "20 0F 24 02 30 01",                $ Link Path to Cal Service attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    8,                                  $ Data Type - byte
                    1,                                  $ Data Size
                    "Calibration Command",              $ Parameter Name
                    "",                                 $ Units String
                    "This command puts the module in different calibration modes.\n\nBegin Calibration - Initializes the module for calibration.\nAccept Low Calibration - The value on the input is a stable 4 mA.\nAccept High Calibration - The value on the input is a stable 20 mA.\nAbort Calibration - Immeadately terminates calibration process and uses previous calibration.\n\nNote: Module must be stand-alone or in Idle/Program mode.\nFurther Note: Once the 'Accept Low' and 'Accept High' Commands have been sent, the module will exit calibration mode.",
                    0,4,0,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

