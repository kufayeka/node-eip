$ Electronic Data Sheet for Point I/O  (1734-IE2C)

[File]
	DescText    = "PointIO 1734-IE2C";                    
	CreateDate  = 06-30-1999;                            
	CreateTime  = 16:09:35;                         
	ModDate     = 03-15-2006;                               
	ModTime     = 06:50:00;                            
	Revision    = 1.3;                              

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 115;                                $ Product Type
	ProdCode    = 24;                                 $ Product Code

	MajRev      = 1;                                  $ Major Rev
	MinRev      = 2;                                  $ Minor Rev
	VendName    = "Allen-Bradley Company, Inc.";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "PointIO 2pt Analog Current Input";
	Catalog     = "1734-IE2C";

[IO_Info]
	Default =     0X0001;                             $ Poll is default

	PollInfo =    0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      COSInfo =     0X0007,                             $ Compatable with all but Cyclic
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      CyclicInfo =  0X000B,                             $ Compatable with all but COS
                    1,                                  $ input 1
                    0;                                  $ no consumed connection


	Input1 =      6,                                  $ size = 6 bytes
                    0,                                  $ All significant bits
                    0X000F,                             $ compatible with all connections
                    "1734-IE2C Produce Connection",     $ name string
                    6,                                  $ path length
                    "20 04 24 65 30 03",                $ assy obj, inst 101d, attr 3
                    "Producing connection contains state of the two inputs and their status";

[ParamClass]
	MaxInst     = 49;
	Descriptor  = 0x09;                               $ Individual parameters are setable
                                                        $ Automaticly stored in EERPOM
	CfgAssembly = 0x67;                               $ the custom config assembly is 103d

[Params]
$ Group Notch Filter
      Param1 =      $ Update Rate
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 20 24 01 30 6E",                $ Link Path to Update Rate attribute.
                    0x0000,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and Settable.
                    2,                                  $ Data Type - Unsigned Int
                    2,                                  $ Data Size
                    "Update Rate",                      $ Parameter Name
                    "ms",                               $ Units String
                    "The Update Rate is used to assign the rate at which the inputs are sampled.\nValid values are from 0 to 10,000 ms.\n\nThe Notch Filter parameter is used to select the fastest rate possible.\nThe Update Rate will add delay to meet system needs.",
                    0,10000,100,                        $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

$ Group Notch Filter
      Param2 =      $ Notch Filter Select
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 20 24 01 30 6D",                $ Link Path to Notch filter attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    8,                                  $ Data Type - Unsigned Short Int
                    1,                                  $ Data Size
                    "Notch Filter",                     $ Parameter Name
                    "",                                 $ Units String
                    "Select notch filter for both inputs.\n\nValid settings:\n - 50 Hz   (120 ms update rate)\n - 60 Hz   (100 ms)\n - 250 Hz  (24 ms)\n - 500 Hz  (12 ms)\n\nThe update rate changes for each filter setting.\nThe rate shown is the fastest time to update both channels.\nThe trade-off must be made between noise rejection and speed.",
                    0,6,2,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

