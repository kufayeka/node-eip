      Param24 =     "No Fault","Low Low Alarm FAULT";   $ low low alarm 1
      Param25 =     "No Fault","High High Alarm FAULT"; $ high high alarm 0
      Param26 =     "No Fault","High High Alarm FAULT"; $ high high alarm 1
