[Connection Manager] 
   1_Display_Only_Connection1 =
      0x04030002,    $ trigger & transport 
                  $  0-15  = supported transport classes (class 1)
                  $  16 = cyclic (1 = supported)
                  $  17 = change of state (1 = supported)
                  $  18 = on demand (0 = not supported)
                  $  19-23 = reserved (must be zero)
                  $  24-27 = exclusive owner
                  $  28-30 = reserved (must be zero)
                  $  31 = client 0 (don't care for classes 0 and 1)
      0x44240455,    $ point/multicast & priority & realtime format
                        $   0     = O=>T fixed (1 = supported)
                        $   1     = O=>T variable (0 = not supported)
                        $   2     = T=>O fixed (1 = supported)
                        $   3     = T=>O variable (0 = not supported)
                  $  4-5   = obsolete - value not changed for backwards compatibility
                  $  6-7   = obsolete - value not changed for backwards compatibility
                  $  8-10  = O=>T header (4 byte run/idle header)
                  $  11  = reserved (must be zero)
                  $  12-14 = T=>O header (pure data)
                  $  15  = reserved (must be zero)
                  $  16-19 = O=>T point-to-point
                  $  20-23 = T=>O multicast
                  $  24-27 = O=>T scheduled
                  $  28-31 = T=>O scheduled
      , 4,,       $ O=>T RPI range,default,description (sizes in bytes)
      ,32,,       $ T=>O RPI range,default,description (sizes in bytes)
      ,,          $ config part 1 (private configuration)
      ,,          $ config part 2 (module configuration)
      "CST Timestamped Fuse Data - Output Data",   $ Connection name
      "CST Timestamped Output connection w/fuse.", $ Help string
      "20 04 24 13 2C C2 2C 87";        $ Path

   1_Display_Only_Connection2 =
      0x04030002,    $ trigger & transport 
      0x44240455,    $ point/multicast & priority & realtime format
      ,12,,       $ O=>T RPI range,default,description (sizes in bytes)
      ,32,,       $ T=>O RPI range,default,description (sizes in bytes)
      ,,          $ config part 1 (private configuration)
      ,,          $ config part 2 (module configuration)
      "CST Timestamped Fuse Data - Scheduled Output Data",        $ Connection name
      "CST Timestamped scheduled output data connection w/fuse.", $ Help string
      "20 04 24 13 2C C3 2C 87";                                  $ Path

   1_Display_Only_Connection3 =
      0x01030002,    $ trigger & transport 
                  $  0-15  = supported transport classes (class 1)
                  $  16 = cyclic (1 = supported)
                  $  17 = change of state (1 = supported)
                  $  18 = on demand (0 = not supported)
                  $  19-23 = reserved (must be zero)
                  $  24-27 = listen-only
                  $  28-30 = reserved (must be zero)
                  $  31 = client 0 (don't care for classes 0 and 1)
      0x44240355,    $ point/multicast & priority & realtime format
                        $   0     = O=>T fixed (1 = supported)
                        $   1     = O=>T variable (0 = not supported)
                        $   2     = T=>O fixed (1 = supported)
                        $   3     = T=>O variable (0 = not supported)
                  $  4-5   = obsolete - value not changed for backwards compatibility
                  $  6-7   = obsolete - value not changed for backwards compatibility
                  $  8-10  = O=>T header (heartbeat)
                  $  11  = reserved (must be zero)
                  $  12-14 = T=>O header (pure data)
                  $  15  = reserved (must be zero)
                  $  16-19 = O=>T point-to-point
                  $  20-23 = T=>O multicast
                  $  24-27 = O=>T scheduled
                  $  28-31 = T=>O scheduled
      , 0,,       $ O=>T RPI range,default,description (sizes in bytes)
      ,32,,       $ T=>O RPI range,default,description (sizes in bytes)
      0,,         $ config part 1 (private configuration)
      ,,          $ config part 2 (module configuration)
      "Listen Only - CST Timestamped Fuse Data - Output Data", $ Connection name
      "CST Timestamped output listen only connection w/fuse.", $ Help string
      "20 04 24 02 2C C6 2C 87";                               $ Path
