        $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
        Param100 =                      $ DeviceLogix Fault Override
                0,                      $ reserved
                7,                      $ Link Path Size
                "",                     $ Link Path to param instance.
                0x0002,                 $ No support for settable path, scaling, scaling links,
                                        $ or real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
                0xC1,                   $ Data Type - boolean
                1,                      $ Data Size - bytes
                "DLX Fault Override",   $ Parameter Name
                "",                     $ Units String
                                        $ $$$$$$$$$ Help string $$$$$$$$$$$
                "Enabling this parameter allows local logic to override normal output behavior "
                "in the event of either communications or network fault.  Default is Disabled.",
                0,1,0,                  $ Min, Max (max enumeration #), and Default values
                ,,,,
                ,,,,
                0;                      $ Not Used

        Enum100 =
                0,"Override Disabled",
                1,"Override Enabled";


        $ The following ParamN definitions are for Invisible Parameters
        $ that do not exist in the device.  They are here to provide
        $ names for Assembly members in this EDS whose corresponding
        $ on-line member names are encoded in Symbolic EPATHs.
        $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
