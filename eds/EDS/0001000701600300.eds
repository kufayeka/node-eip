$                1,                      $ Data Size - (in bytes)
$                "Produced I/O Assembly",$ Parameter Name
$                "",                     $ Units String
$                           $$$$$$$$$$ Help string $$$$$$$$$$$
$                "Choose the I/O assembly that you would like this module to produce.  "
$                "The assemblies are defined in the module's documentation. Note!  "
$                "You must change the scanner's consumed (Rx) data size for this module "
$                "to match the assembly that you have chosen.  This can be done by "
$                "selecting 'Edit I/O parameters' from the scanner's scanlist tab.",
$                0,3,0,                  $ Min, Max (max enumeration #), and Default values
$                ,,,,,,,,;               $ Not Used
$
$       Enum5=
$                0,"20-byte Produced (Default)",
$                1,"1-byte Produced",
$                2,"20-byte Produced",
$                3,"8-byte Produced";
$
        $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$        Param10 =                       $ Consumed I/O assembly selection
$                0,                      $ reserved
$                0,                      $ Link Path Size
$                "",                     $ Link Path to param instance.
$                0x0002,                 $ No support for settable path, scaling, scaling links,
$                                        $ or real time update of value.  Value is gettable and
$                                        $ Settable.  Enumerated strings are supported.
$                0xC6,                   $ Data Type - unsigned short int
$                1,                      $ Data Size - (in bytes)
$                "Consumed I/O Assembly",$ Parameter Name
