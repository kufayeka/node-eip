[Assembly]
        Revision = 1;

        Assem4=     "1-byte Produced",
                    "21 04 00 24 04 30 03",             $ Path is (assy obj.(4), inst 4d, attr 3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param4;                          $ # bits, Group Value for Input


        Assem34=    "1-byte Consumed",
                    "21 04 00 24 22 30 03",             $ Path is (assy obj.(4), inst 34d, attr 3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param4;                          $ # bits, Group Value for Output


        Assem101=   "20-byte Produced",
                    "21 04 00 24 65 30 03",             $ Path is (assy obj.(4), inst 101d, attr 3)
                    20,                                 $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param4,                          $ # bits, Group Value for Input
                    8, Param11,                         $ # bits, Group Value for Produced Network Bits
                    1, Param96,                         $ # bit,  DeviceLogix run status
                    1, Param97,                         $ # bit,  Connection owned status
                    6,,
                    8, Param98,
                    16,Param13,                         $ # bits, Produce Analog Word 0
                    16,Param14,                         $ # bits, Produce Analog Word 1
                    16,Param15,                         $ # bits, Produce Analog Word 2
                    16,Param16,                         $ # bits, Produce Analog Word 3
                    16,Param17,                         $ # bits, Produce Analog Word 4
                    16,Param18,                         $ # bits, Produce Analog Word 5
                    16,Param19,                         $ # bits, Produce Analog Word 6
                    16,Param20;                         $ # bits, Produce Analog Word 7

        Assem102=   "20-byte Consumed",
                    "21 04 00 24 66 30 03",             $ Path is (assy obj.(4), inst 102d, attr 3)
                    20,                                 $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param4,                          $ # bits, Group Value for Output
                    8, Param12,                         $ # bits, Group Value for Consumed Network Bits
                    8,,                                 $ rsvd
                    8,,                                 $ rsvd
                    16,Param21,                         $ # bits, Consume Analog Word 0
                    16,Param22,                         $ # bits, Consume Analog Word 1
                    16,Param23,                         $ # bits, Consume Analog Word 2
                    16,Param24,                         $ # bits, Consume Analog Word 3
                    16,Param25,                         $ # bits, Consume Analog Word 4
                    16,Param26,                         $ # bits, Consume Analog Word 5
                    16,Param27,                         $ # bits, Consume Analog Word 6
                    16,Param28;                         $ # bits, Consume Analog Word 7

        Assem111=   "8-byte Produced",
                    "21 04 00 24 6F 30 03",             $ Path is (assy obj.(4), inst 111d, attr 3)
                    8,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param4,                          $ # bits, Group Value for Input
                    8, Param11,                         $ # bits, Group Value for Produced Network Bits
                    1, Param96,                         $ # bit,  DeviceLogix run status
                    1, Param97,                         $ # bit,  Connection owned status
                    6,,
                    8, Param98,
                    16,Param13,                         $ # bits, Produce Analog Word 0
                    16,Param14;                         $ # bits, Produce Analog Word 1


        Assem112=   "8-byte Consumed",
                    "",            				  $ Path is (assy obj.(4), inst 112d, attr 3)
                    8,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param4,                          $ # bits, Group Value for Output
                    8, Param12,                         $ # bits, Group Value for Consumed Network Bits
                    8,,                                 $ rsvd
                    8,,                                 $ rsvd
                    16,Param21,                         $ # bits, Consume Analog Word 0
                    16,Param22;                         $ # bits, Consume Analog Word 1


        Assem123 =  "Configuration Assembly",
                    "21 04 00 24 7B 30 03",             $ Path is (assy obj.(4) inst 123d(0x7B), attr 3)
                    48,                                 $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    16,Param2,                          $ # bits, Group Off2On Filter
                    16,Param3,                          $ # bits, Group On2Off Filter
                    8,Param6,                           $ # bits, Fault State selection for output
                    8,Param7,                           $ # bits, Fault Value selection for output
                    8,Param8,                           $ # bits, Idle  State selection for output
                    8,Param9,                           $ # bits, Idle  Value selection for output
                    1,Param74,                          $ # bits, Zone Auto Produce
                    1,Param78,                          $ # bits, Dependent Mode
                    1,Param100,                         $ # bits, Fault Override
                    1,Param90,                          $ # bits, Rack Connection
                    4,,
                    8,,                                 $ Reserved
                    16,Param99,                         $ Auto produce assembly selection
                    16,Param75,                         $ # bits, Zone Produce EPR
                    16,Param76,                         $ # bits, Zone Produce PIT
                    8, Param31,                         $ Slot/ID of Peer 0
                    8, Param39,                         $ Size of Peer 0
                    16,Param65,                         $ EPR of Peer 0
                    8, Param32,                         $ Slot/ID of Peer 1
                    8, Param40,                         $ Size of Peer 1
                    16,Param66,                         $ EPR of Peer 1
                    8, Param33,                         $ Slot/ID of Peer 2
                    8, Param41,                         $ Size of Peer 2
                    16,Param67,                         $ EPR of Peer 2
                    8, Param34,                         $ Slot/ID of Peer 3
                    8, Param42,                         $ Size of Peer 3
                    16,Param68,                         $ EPR of Peer 3
                    8, Param35,                         $ Slot/ID of Peer 4
                    8, Param43,                         $ Size of Peer 4
                    16,Param69,                         $ EPR of Peer 4
                    8, Param36,                         $ Slot/ID of Peer 5
                    8, Param44,                         $ Size of Peer 5
                    16,Param70,                         $ EPR of Peer 5
                    8, Param37,                         $ Slot/ID of Peer 6
                    8, Param45,                         $ Size of Peer 6
                    16,Param71,                         $ EPR of Peer 6
                    8, Param38,                         $ Slot/ID of Peer 7
                    8, Param46,                         $ Size of Peer 7
                    16,Param72;                         $ EPR of Peer 7


        VariantExa1 =
                ,,,,,
                Param99,
                0,Assem101,
                4,Assem4,
                101,Assem101,
                111,Assem111;

        VariantExa2 =
                ,,,,,
                Param90,
                0x00,Assem102,
                0x01,Assem34;


