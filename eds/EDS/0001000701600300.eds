$ Electronic Data Sheet for ArmorPoint (1738-8CFGDLXM8) with Zone Interlocking Parameters

[File]
	DescText    = "ArmorPoint 1738-8CFGDLXM8/A";
	CreateDate  = 01-01-2008;
	CreateTime  = 12:00:00;
	ModDate     = 17-07-2012;
	ModTime     = 18:00:00;
	Revision    = 3.4;
	HomeURL     = "http://www.ab.com/networks/eds/DN/0001000701600300.eds";

[Device]
    VendCode = 1;                       $ Vendor Code
    ProdType = 7;                       $ Product Type
    ProdCode = 352;                     $ Product Code (0x0160)

    MajRev = 3;                         $ Major Rev
    MinRev = 4;                         $ Minor Rev

    VendName    = "Rockwell Automation/Allen-Bradley";
    ProdTypeStr = "General Purpose Discrete I/O";
    ProdName    = "ArmorPoint 24V 8pt Config DLX M8";
    Catalog     = "1738-8CFGDLXM8/A";
    Icon        = "1738-8M8BlueGreen.ico";

    1_RSNetWorx_NoAutoEnter = "Yes";
    1_RSNetWorx_DNetTool    = "LeoApp.LeoDevice";
    1_RSNetWorx_DNetToolEx  = "1.00.00", "LeoApp.LeoDevice", "7.00.00", "RSI.DeviceNet.EDSApplet.1";
    1_DNetEDSAppletPlugIn   = "7.00.00", "DeviceLogixPlugIn.EDSAppletPlugIn.1";

[Device Classification]
    Class1 = DeviceNet;

[IO_Info]

    Default  =  0x0004;                	$ The default I/O type is COS I/O.

    PollInfo =  0x000F,                	$ Poll connection can be used with all connection.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.

    StrobeInfo = 0x000F,               	$ Strobe connection can be used with all connection.
                1,                      $ Input1 entry is the default input connection.
                0;                      $ No strobe connection here

    COSInfo  =  0x0007,                	$ COS connection can be used with Polled I/O & Strobe I/O.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.

    CyclicInfo =0x000B,                	$ Cyclic connection can be used with Polled I/O & Strobe I/O.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.


    Input1 =    20,                     $ The size in bytes that this connection produces.
                160,                    $ 160 bits of this connection are significant.
                0x000F,                 $ Compatible with all conections
                "Data",                 $ Name of Connection.
                7,                      $ Path length.
                "21 04 00 24 65 30 03", $ Assy obj(4), inst 101d(0x65), attr 3
                "Producing connection contains the status of the eight inputs, eight produced network"
                " bits, one connection owned status bit, one logic enabled bit, eight peer connection"
                " status bits and eight produced network words.";


    Output1 =   20,                     $ The size in bytes that this connection consumes.
                160,                    $ 160 bits of this connection are significant.
                0x000D,                 $ Compatible with Polled and COS I/O connection
                "Data",                 $ Name of Connection.
                7,                      $ Path length.
                "21 04 00 24 66 30 03", $ Assy obj(4), inst 102d(0x66), attr 3
                "Consuming connection contains state of the eight outputs, eight consumed network bits,"
                " and eight consumed network words.";

    InputExa1 =
                ,                       $ Size from AssemN
                0,                      $ Bits determined by AssemN member list
                0x000F,                 $ Poll, COS, Cyclic, Strobe
                ,                       $ Name String from AssemN
                ,                       $ Path Size not applicable
                VariantExa1,            $ Variant for choosing Input Assem
                ;                       $ Help string not applicable

    OutputExa1 =
                ,                       $ Size from AssemN
                ,                       $ Bits determined by AssemN member list
                0x000D,                 $ Poll, COS, Cyclic
                ,                       $ Name String  from AssemN
                ,                       $ Path Size not applicable
                VariantExa2,            $ Variant for choosing Output Assem
                ;                       $ Help string not applicable

    $
    $ This section will need to be changed to add additional assemblies
    $
	1_COSetPathNotSupported = 1;        $ Cnxn Obj does not support direct path setting
    1_COSetSizeNotSupported = 1;        $ Cnxn Obj does not support direct size setting



[ParamClass]
    MaxInst             = 64;           $ Max number of parameters.
    Descriptor          = 0x0009;       $ Individual parameters are settable,Automaticly stored in EERPOM
    CfgAssembly         = 0;            $
    1_CfgAssembly       = 0x7B;         $ The custom config assembly is 123d(0x7B)

