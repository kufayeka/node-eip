$ Electronic Data Sheet for Armor Block I/O  (1792-IB8)

[File]
DescText = "1792-IB8 Armor Block I/O EDS File";
CreateDate = 04-18-96;
CreateTime = 12:00:00;
ModDate = 04-23-97;
ModTime = 12:00:00;
Revision = 2.4;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1025;
MajRev = 2;
MinRev = 1;
ProdName = "1792-IB8 8Input";
Catalog="1792-IB8";
1_Icon=0001_ArmorBlk.ico;

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x0005,			$ Polled and COS I/O device.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

COSInfo=
0x0005,                 $ Polled and COS I/O device.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

Input1 =
2,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x0005,			$ Polled and COS I/O device.
"IB8 Production Data",	$ Name of Connection.
6,			$ Path length.
"20 04 24 0E 30 03",	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains data from inputs in byte 0 and sensor source voltage status at bit 7 of byte 1.";

[ParamClass]
MaxInst = 12;		$ 3 configurable and 9 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x66;	$ The config assembly is instance #102 of assy obj.		

