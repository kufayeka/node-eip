		0xC6, 1,			$ Type: USINT, size: 1 byte
		"Input Assy. (POLL)",
		"",
		"The type of input data that is sent for the Polling I/O connections. \n"
		"Position = 4 bytes, \n"
		"Position + Cam State = 5 bytes, \n"
		"Position + Flags = 5 bytes, \n"
		"Position + Velocity = 8 bytes. \n"
		"Update time: Velocity 50 mS, other modes 0.3 mS.",
		1, 4, 1,			$ min, max, default
		1,1,1,0,
		0,0,0,0,
		0;
