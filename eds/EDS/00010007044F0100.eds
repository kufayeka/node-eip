$ Electronic Data Sheet for High Current 8X8 Block I/O  (1792D-88HC)

[File]
DescText = "1792D-88HC High Current 8X8 Block I/O EDS File";
CreateDate = 08-11-1999;
CreateTime = 08:00:00;
ModDate = 03-14-2000;
ModTime = 08:31:00;
Revision = 1.2;     	$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1103;
MajRev = 1;
MinRev = 1;
ProdName = "1792D-88HC 8Input/8Output";
Catalog="1792D-88HC";
1_Icon=0001_ArmorBlk.ico;

[IO_Info]
Default = 0x0004;   	$ The default I/O type is COS I/O.

PollInfo =
0x000D,           	$ Poll connection can be used with COS or Cyclic I/O.
1,          	   	$ Input1 entry is the default input connection.
1;         	    	$ Output1 entry is the default output connection.

COSInfo=
0x0005,     	    	$ COS connection can be used with Polled I/O.
1,         	    	$ Input1 entry is the default input connection.
1;         	    	$ Output1 entry is the default output connection.

CyclicInfo=
0x0009,     	    	$ Cyclic connection can be used with Polled I/O.
1,         	   	$ Input1 entry is the default input connection.
1;         	   	$ Output1 entry is the default output connection.

Input1 =
3,          	    	$ The size in bytes that this connection produces.
0,         	   	$ All bits of this connection are significant.
0x000D,    	    	$ Polled, COS and Cyclic I/O device.
"88HC Production Data", $ Name of Connection.
6,          	    	$ Path length.
"20 04 24 81 30 03", 	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 3 bytes: Byte 1, bits 0-7=Output OverLoads.\nByte 2, bits 0-7=Output No Loads.\nByte 3, bits 0-7=Inputs 0-7.";
            
Output1 = 
1,         	    	$ The size in bytes that this connection consumes.
0,          		$ All bits of this connection are significant.
0x000D,       		$ Polled, COS and Cyclic I/O device.
"88HC Consumption Data",$ Name of Connection.
6,          		$ Path length.
"20 04 24 22 30 03",    $ Path to I/O Consumption Assembly.
    			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains output data in bits 0-7 (Outputs 0-7 respectively).";
             
[ParamClass]
MaxInst = 16;        	$ 11 configurable and 5 read-only parameters.
Descriptor =  0x09; 	$ Stub param instances in eeprom.
CfgAssembly = 0x82; 	$ Config assembly.     

[Params]
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param1 =        	$ Disable Autobaud
0,          		$ reserved
6,         		$ Link Path Size
"20 03 24 01 30 64",    $ Link Path to disable autobaud attribute.
0x0002,         	$ No support for settable path, scaling, scaling links, or
            		$ real time update of value.  Value is gettable and 
            		$ Settable.  Enumerated strings are supported.
4,          		$ Data Type - boolean
1,          		$ Data Size
"Autobaud",     	$ Parameter Name
"",         		$ Units String
    			$$$$$$$$$$ Help string $$$$$$$$$$$
"Selecting 'Autobaud Inactive' deactivates the Autobaud feature in the block.\nThe change occures after the next power up. The default is 'Autobaud\nActive'.",
0,1,0,          	$ Min, Max, and Default values
1,1,1,0,0,0,0,0,0;      $ Not Used

