                                $  Bit 0 = Poll
                                $  Bit 1 = Strobe
                                $  Bit 2 = Change of State
                                $  Bit 3 = Cyclic

        PollInfo =
                0x000D,         $ Cyclic, COS, and Poll
                1,              $ Default Input = Input1
                1;              $ Default Output = Output1


        COSInfo =
                0x0005,         $ COS connection can be used with Polled I/O.
                1,              $ Default Input = Input1
                1;              $ Default Output = Output1

        CyclicInfo =
                0x0009,         $ Cyclic connection can be used with Polled I/O
                1,              $ Default Input = Input1
                1;              $ Default Output = Output1



