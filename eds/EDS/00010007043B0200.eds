$ Electronic Data Sheet for ArmorBlock MaXum I/O with Local Logic  (1792D-4BVT4D)

[File]
DescText = "1792D-4BVT4D MaXum ArmorBlock I/O";
CreateDate = 10-19-1998;
CreateTime = 12:00:00;
ModDate  = 01-22-2007;
ModTime  = 10:00:00;
Revision = 2.32;   $ EDS revision.
HomeURL  = "http://www.ab.com/networks/eds/DN/00010007043B0200.eds";

[Device]
VendCode = 1;
VendName = "Rockwell Automation/Allen-Bradley";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1083;
MajRev = 2;
MinRev = 1;
ProdName = "1792D-4BVT4D 4Input/4Output";
Catalog = "X1792D-4BVT4D";
Icon = "ArmorBlkMaXum4.ico";
DNetQC=0B0000000000000001, 200; $ Quick Connect supported at power up. 200ms powerup time

1_RSNetWorx_DNetTool = "LeoApp.LeoDevice";
1_RSNetWorx_DNetToolEx = "1.00.00", "LeoApp.LeoDevice", "7.00.00", "RSI.DeviceNet.EDSApplet.1";
1_DNetEDSAppletPlugIn = "7.00.00", "DeviceLogixPlugIn.EDSAppletPlugIn.1";
   

[Device Classification]
Class1 = DeviceNet;

[IO_Info]
1_COSetPathNotSupported = 1;   $Paths not settable.
1_COSetSizeNotSupported = 1;   $Paths not settable.

Default = 0x0004;  $ The default I/O type is COS I/O.

PollInfo =
0x000D,        $ Poll connection can be used with COS or Cyclic I/O.
1,             $ Input1 entry is the default input connection.
1;             $ Output1 entry is the default output connection.

COSInfo=
0x0005,        $ COS connection can be used with Polled I/O.
1,             $ Input1 entry is the default input connection.
1;             $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,        $ Cyclic connection can be used with Polled I/O.
1,             $ Input1 entry is the default input connection.
1;             $ Output1 entry is the default output connection.

Input1 =
3,                         $ The size in bytes that this connection produces.
0,                         $ All bits of this connection are significant.
0x000D,                    $ Polled, COS and Cyclic I/O device.
"Data - with Status",      $ Name of Connection.
6,                         $ Path length.
"20 04 24 6C 30 03",       $ Path to I/O Production Assembly.
       $$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 2 bytes: Byte 1, bits 0-3=Inputs 0-3.\nBits 4&5=Input Short Circuit; Connectors A&B.\nBits 6&7=Off Wire Detect; Connectors A&B.\nByte 2, bits 0-3=Output Faults 0-3, bit 6=Output Power.";
           
InputExa1 =
,               $ Size from AssemN
0,              $ Bits determined by AssemN member list
0x000D,         $ Poll, COS, Cyclic
,               $ Name String from AssemN
,               $ Path Size not applicable
VariantExa1,    $ Variant for choosing Input Assem
;               $ Help string not applicable


           
Output1 =
1,                         $ The size in bytes that this connection consumes.
4,                         $ Only the least 4 significant bits of this connection are used.
                           $ connection are used.
0x000D,                    $ Polled, COS and Cyclic I/O device.
"Data",                    $ Name of Connection.
7,                         $ Path length.
"21 04 00 24 21 30 03",    $ Path to I/O Consumption Assembly.
           $$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-3 (Outputs 0-3 respectively).";
            
OutputExa1 =
,               $ Size from AssemN
0,              $ Bits determined by AssemN member list
0x000D,         $ Poll, COS, Cyclic
,               $ Name String  from AssemN
,               $ Path Size not applicable
VariantExa2,    $ Variant for choosing Output Assem
;               $ Help string not applicable


            
[ParamClass]
MaxInst = 59;              $ parameters.
Descriptor =  0x09;        $ Stub param instances in eeprom.
CfgAssembly = 0x00;        $ Config assembly
1_CfgAssembly = 0xA8;      $ Config assembly.


