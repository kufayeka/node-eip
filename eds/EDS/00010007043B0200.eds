[Assembly]
Revision = 1;

Assem108 = 
"Input - with Status",         $ Name of Connection.
"20 04 24 6C 30 03",           $ Path to I/O Production Assembly.
2,                             $ The size in bytes that this connection produces.
0, , ,                         $ Not editable, not modular.
4, Param4,                     $ 4 input values (byte 0)
1, Param40,                    $ Connector A Input Short Circuit (byte 1)
1, Param41,                    $ Connector B Input Short Circuit (byte 1)
1, Param44,                    $ Connector A Input Open Wire (byte 1)
1, Param45,                    $ Connector B Input Open Wire (byte 1)
1, Param13,                    $ Output 0 Fault Status
1, Param14,                    $ Output 1 Fault Status
1, Param15,                    $ Output 2 Fault Status
1, Param16,                    $ Output 3 Fault Status
2, ,                           $ 
1, Param23,                    $ Auxiliary Power Status
1, ;                           $

Assem3 = 
"Input Only",                  $ Name of Connection.
"20 04 24 03 30 03",           $ Path to I/O Production Assembly.
1,                             $ The size in bytes that this connection produces.
0, , ,                         $ Not editable, not modular.
4, Param4,                     $ 4 input values (byte 0)
4, ;

Assem133 = 
"Data - DeviceLogix",          $ Name of Connection.
"20 04 24 85 30 03",           $ Path to I/O Production Assembly.
4,                             $ The size in bytes that this connection produces.
0, , ,                         $ Not editable, not modular.
4, Param4,                     $ 4 input values (byte 0)
1, Param40,                    $ Connector A Input Short Circuit (byte 1)
1, Param41,                    $ Connector B Input Short Circuit (byte 1)
1, Param44,                    $ Connector A Input Open Wire (byte 1)
1, Param45,                    $ Connector B Input Open Wire (byte 1)
1, Param17,                    $ Output 0 Fault Status
1, Param18,                    $ Output 1 Fault Status
1, Param19,                    $ Output 2 Fault Status
1, Param20,                    $ Output 3 Fault Status
1, ,                           $ 
1, Param57,                    $ DeviceLogix Enabled
1, Param23,                    $ Auxiliary Power Status
1, ,                           $
4, Param49,                    $ Output data
4, ,
8, Param58;                    $ Produced DeviceLogix Data


Assem33 =               $0x21
"Default Consumed",     $ Name of Connection.
"20 04 24 21 30 03",    $ Path to I/O Assembly.
1,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
4, Param49,             $ 4 output values (byte 0)
4, ;

Assem160 =              $0xA0
"No Consumed",          $ Name of Connection.
"20 04 24 A0 30 03",    $ Path to I/O Consume Assembly.
0,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
0,;                     $ 8 output values (byte 0)
Assem161 =              $0xA1
"1 byte Consumed",      $ Name of Connection.
"20 04 24 A1 30 03",    $ Path to I/O Consume Assembly.
1,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
8, Param48;             $ 8 output values (byte 0)
Assem162 =              $0xA2
"2 bytes Consumed",     $ Name of Connection.
"20 04 24 A2 30 03",    $ Path to I/O Consume Assembly.
2,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
8, Param48,             $ 8 output values (byte 0)
8, Param48;             $ 8 output values (byte 1)
Assem163 =              $0xA3
"3 bytes Consumed",     $ Name of Connection.
"20 04 24 A3 30 03",    $ Path to I/O Consume Assembly.
3,                      $ The size in bytes that this connection produces.
0, , ,                  $ Not editable, not modular.
8, Param48,             $ 8 output values (byte 0)
8, Param48,             $ 8 output values (byte 0)
8, Param48;             $ 8 output values (byte 0)
Assem164 =              $0xA4
"4 bytes Consumed",     $ Name of Connection.
"20 04 24 A4 30 03",    $ Path to I/O Consume Assembly.
4,                      $ The size in bytes that this connection consumes.
0, , ,                  $ Not editable, not modular.
8, Param48,             $ 8 output values (byte 0)
8, Param48,             $ 8 output values (byte 0)
8, Param48,             $ 8 output values (byte 0)
8, Param48;             $ 8 output values (byte 0)


Assem168 =             $0xA8
"Configuration",       $ Name of Connection.
,                      $ Path to Assembly.
10,                    $ The size in bytes.
0, , ,                 $ Not editable, not modular.
1,Param1,              $ Autobaud                  (byte 0 bit 0)
1,Param59,             $ Quick Connect             (byte 0 bit 1)
1, ,                   $ 1 pad bits                (byte 0 bit 2)
1,Param22,             $ Reset Mode                (byte 0 bit 3)
2, ,                   $ 2 pad bits                (byte 0 bit 4,5)
1,Param26,             $ Net Overide               (byte 0 bit 6)
1,Param27,             $ Com Overide               (byte 0 bit 7)
8,Param2,              $ Off to On Input filter    (byte 1,2)
8,Param3,              $ On to Off Input filter    (byte 3,4)
1,Param7,              $ OW Enable In A            (byte 5 bit 0)
1,Param8,              $ OW Enable In B            (byte 5 bit 1)
6, ,                   $ 6 pad bits                (byte 5 )
4,Param9,              $ Fault State               (byte 6)
4, ,   
4,Param10,             $ Fault Value               (byte 7)
4, ,
4,Param11,             $ Idle State 0              (byte 8)
4, ,
4,Param12,             $ Idle Value 0              (byte 9)
4, ,
1,Param17,             $ Fault Enable Out 0        (byte 10 bit 0) 
1,Param18,             $ Fault Enable Out 1        (byte 10 bit 1)
1,Param19,             $ Fault Enable Out 2        (byte 10 bit 2)
1,Param20,             $ Fault Enable Out 3        (byte 10 bit 3)
4, ,
4,Param25,             $ Produced I/O Assembly
4,Param24;             $ Consumed I/O Assembly

VariantExa1 =
    ,,,,,
    Param25,
    0x00, Assem108,
