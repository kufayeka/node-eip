$ Electronic Data Sheet for ArmorBlock MaXum I/O  (1792D-16BVT0D)

[File]
DescText = "1792D-16BVT0D ArmorBlock MaXum I/O EDS File";
CreateDate = 10-19-1998;
CreateTime = 12:00:00;
ModDate = 05-03-2000;
ModTime = 15:00:00;
Revision = 1.32;         $ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1072;
MajRev = 1;
MinRev = 4;
ProdName = "1792D-16BVT0D 16Input";
Catalog="1792D-16BVT0D";
1_KeepMinorRev = "Yes";
1_Icon=0001_ArmorBlkMaXum8.ico;

[IO_Info]
Default = 0x0004;       $ The default I/O type is COS I/O.

PollInfo =
0x000D,			$ Poll connection can be used with COS or Cyclic I/O.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

COSInfo=
0x0005,                 $ COS connection can be used wiht Polled I/O.
1,                      $ Input1 entry is the default input connection.
0;                      $ There is no consuming connection.

CyclicInfo=
0x0009,			$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

Input1 =
4,                      $ The size in bytes that this connection produces.
0,                      $ All bits of this connection are significant.
0x000D,                 $ Polled, COS and Cyclic I/O device.
"16BVT0D Production Data", $ Name of Connection.
6,                      $ Path length.
"20 04 24 72 30 03",    $ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 4 bytes: Byte 1, bits 0-7=Inputs 0-7. Byte 2, bits0-7=Inputs 8-15.\nByte 3, bits 0-7=Input Short Circuit; Connectors A-H respectively. Byte 4, bits\n0-7=Offwire Detect; Connectors A-H respectively.";

[ParamClass]
MaxInst = 21;           $ 11 read-only and 10 configurable parameters.
Descriptor =  0x09;     $ Stub param instances in eeprom.
CfgAssembly = 0x76;     $ Config assembly

