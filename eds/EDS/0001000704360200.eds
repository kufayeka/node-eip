$ Electronic Data Sheet for 1791D CompactBlock I/O   (1791D-0V16P)

[File]
DescText = "CompactBlock I/O 16 Sinking Out EDS File";
CreateDate = 10-13-1998;
CreateTime = 12:00:00;
ModDate = 07-31-2002;
ModTime = 11:00:00;
Revision = 2.53;	$ EDS revision.

HomeURL  = "http://www.ab.com/networks/eds/DN/0001000704360200.eds";

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1078;
MajRev = 2;
MinRev = 2;
ProdName = "1791D-0V16P 16 Sinking Out";
Catalog="1791D-0V16P";
Icon = "CompactBlk.ico";
DNetQC=0w0000000000000001, 200; $ Quick Connect supported at power up. 200ms powerup time

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x000D,			$ Poll connection can be used with COS or cyclic I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

COSInfo=
0x0005,			$ COS connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

CyclicInfo=
0x0009,			$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

Input1 =
1,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x000D,			$ Polled and COS I/O device.
"0V16P Production Data",$ Name of Connection.
7,			$ Path length.
"21 04 00 24 07 30 03",	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains input data.";

Output1 =
2,			$ The size in bytes that this connection consumes.
0,			$ All bits of this connection are significant.
0x000D,			$ Polled, COS, and Cyclic I/O device.
"OV16P Consumption Data",$ Name of Connection.
7,			$ Path length.
"21 04 00 24 25 30 03",	$ Path to I/O Consumption Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains output data.";

[ParamClass]
MaxInst = 11;		$ 8 configurable and 3 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0xA9;	$ The config assembly is instance #169 of assy obj.		

