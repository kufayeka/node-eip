                ,
                0x0000,
                ,,
                16,Param8;

        Assem135 =  $Consumed Data
                "Data",
                "20 04 24 87 30 03",
                ,
                0x0000,
                ,,
                16,Param8,
                16,Param35;

        Assem108 =  $Configuration Data
                "Config",
                "20 04 24 6C 30 03",
                ,
                0x0000,
                ,,
                16,Param19,
                1,Param3,
                1,Param4,
                1,Param5,
                1,Param6,
                3,,
                1,Param18,
                8,;

