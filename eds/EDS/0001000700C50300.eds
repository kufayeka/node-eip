$ Electronic Data Sheet for ArmorPoint  (1738-OW4M12/A)
$ Copyright 2006 by Rockwell Automation
$ Universal version for: DeviceNet, ControlNet, and EthernetIP

$ Revision History
$ Revision	Date		Change
$	1.1	05Jan2004	Started with revision 1.2 of 1734-OW4/C
$	2.1	30Nov2004	Added Assem124 - Changed CNXNs for 3rd Party
$	3.1	26Feb2006	Update to new DeviceNet Premier Integration EDS Guidelines
$	3.2	18Mar2006	Added pading to IO assems

[File]
	DescText    = "ArmorPoint 1738-OW4M12/A";                    
	CreateDate  = 04-24-2003;
	CreateTime  = 15:00:00;
	ModDate     = 03-18-2006;
	ModTime     = 11:00:00;
	Revision    = 3.2;
	HomeURL     = "http://www.ab.com/networks/eds/DN/0001000700C50300.eds";

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 197;                                $ Product Code

	MajRev      = 3;                                  $ Major Rev
	MinRev      = 10;                                 $ Minor Rev
	VendName    = "Rockwell Automation/Allen-Bradley";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "ArmorPoint 4pt DC Relay Output M12";
	Catalog     = "1738-OW4M12/A";
	Icon        = "1738-2M12ORANGE.ico";
	1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
	1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
     Class1 =      DeviceNet;

[IO_Info]
	1_COSetPathNotSupported = 1;                      $ Cnxn Obj does not support direct path setting

	Default     = 0X0004;                           $ COS is default

	PollInfo    = 0X0001,                           $ Compatable with all
                    0,                                  $ no produced connection
                    1;                                  $ output 1

      StrobeInfo =  0X000F,                             $ Compatable with all
                    0,                                  $ no produced connection
                    0;                                  $ no strobe/consumed connection

      COSInfo =     0X0007,                             $ Compatable with all
                    0,                                  $ no produced connection
                    1;                                  $ output 1

      CyclicInfo =  0X000B,                             $ Compatable with all
                    0,                                  $ no produced connection
                    1;                                  $ output 1

	Output1 =   1,                                  $ size = 1 byte
                    4,                                  $ 4 significant bits
                    0X000D,                             $ compatible with polled connection
                    "Data",                             $ name string
                    6,                                  $ path length
                    "20 04 24 21 30 03",                $ assy obj, inst 33d(0x21), attr 3
                    "Consuming connection contains state of the four relay outputs";

[ParamClass]
	MaxInst     = 102;
	Descriptor  = 0x09;                             $ Individual parameters are setable
                                                        $ Automaticly stored in EERPOM
	CfgAssembly = 0x67;                             $ the custom config assembly is 103d (0x67)

[Assembly]
        Assem33=    "Data",
                    "",                                 $ Path is implied (Assy obj attr3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    4, Param30,                         $ # bits, Value for Output
                    4,;                                 $ Pad bits

        Assem103 =  "1738-OW4M12 Configuration Assembly",
                    "",                                 $ Path is implied (Assy obj attr3)
                    4,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    1,Param5,                           $ # bits, Fault State selection for output 0
                    1,Param7,                           $ # bits, Fault State selection for output 1
                    1,Param9,                           $ # bits, Fault State selection for output 2
                    1,Param11,                          $ # bits, Fault State selection for output 3
                    4,,                                 $ pad bits
                    1,Param6,                           $ # bits, Fault Value selection for output 0
                    1,Param8,                           $ # bits, Fault Value selection for output 1
                    1,Param10,                          $ # bits, Fault Value selection for output 2
                    1,Param12,                          $ # bits, Fault Value selection for output 3
                    4,,                                 $ pad bits
                    1,Param13,                          $ # bits, Idle State selection for output 0
                    1,Param15,                          $ # bits, Idle State selection for output 1
                    1,Param17,                          $ # bits, Idle State selection for output 2
                    1,Param19,                          $ # bits, Idle State selection for output 3
                    4,,                                 $ pad bits
                    1,Param14,                          $ # bits, Idle Value selection for output 0
                    1,Param16,                          $ # bits, Idle Value selection for output 1
                    1,Param18,                          $ # bits, Idle Value selection for output 2
                    1,Param20,                          $ # bits, Idle Value selection for output 3
                    4,;                                 $ pad bits

    Assem124 =                  $ Private config in Forward Open, Module
        "3rd Party Private Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param101,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem125 =                  $ Private config in Forward Open, Module
        "Adapter Config Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param102,            $ Non-Logix Header (constant 0x7001)
        16,1_RackSize,          $ number of slots
        16,Param101,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem126 =                  $ O2T (output data)
        "Ouput Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        ,Assem33;               $ Assembly sent to module

    Assem127 =                  $ T2O (input data)
        "Input Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        32,;                    $ Fault bits
                                $ NO Assembly passed from module

      ProxiedAssem1 =
                    "DC Output Rack Configuration Assembly",
                    "01 SLOT 20 04 24 78 30 03",        $ Path to Assy Obj (4) inst 120d attr 3
                    ,                                   $ total length in bytes
                    0x0000,                             $ descriptor
                    ,,                                  $ ",,"= reserved
                    1,Param26,                          $ Group Fault Action
                    1,Param27,                          $ Group Fault Value
                    1,Param28,                          $ Group Idle Action
                    1,Param29,                          $ Group Idle Value
                    4,;                                 $ Pad bit

      ProxiedAssem3 = 
                    "Real Time Input Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,                                   $ ",,"= reserved
                    ;

      ProxiedAssem4 = 
                    "Real Time Output Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem33;

