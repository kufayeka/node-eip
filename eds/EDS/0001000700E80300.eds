$ Electronic Data Sheet for Point I/O  (1734-OB8/C)
$ Copyright 2006 by Rockwell Automation
$ Universal version for: DeviceNet, ControlNet, and EthernetIP

$ Revision History
$ Revision	Date		Change
$	1.1	02Sep2004	Started with 1734-OB8E 1.3 08Jan04
$	1.2	30Nov2004	Added Assem124 - Changed CNXNs for 3rd Party
$	2.1	03Feb2006	Update to new DeviceNet Premier Integration EDS Guidelines
$				Removed Assem124 from Listen Only Connection

[File]
	DescText =    "PointIO 1734-OB8/C";                   
	CreateDate  = 04-23-2003;
	CreateTime  = 12:00:00;
	ModDate     = 02-03-2006;
	ModTime     = 12:00:00;
	Revision    = 2.1;
	HomeURL     = "http://www.ab.com/networks/eds/DN/0001000700E80300.eds";

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 232;                                $ Product Code

	MajRev      = 3;                                  $ Major Rev
	MinRev      = 10;                                 $ Minor Rev
	VendName    = "Rockwell Automation/Allen-Bradley";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "PointIO 8pt 24Vdc Source Output";
	Catalog     = "1734-OB8/C";
	Icon        = "1734green.ico";
	1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
	1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
     Class1 =      DeviceNet;

[IO_Info]
	1_COSetPathNotSupported = 1;                      $ Cnxn Obj does not support direct path setting

	Default =     0X0004;                           $ COS is default

	PollInfo    = 0X000F,                           $ compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ No strobe connection here

      COSInfo =     0X0007,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      CyclicInfo =  0X000B,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      Input1 =      1,                                  $ size = 1 byte
                    8,                                  $ 8 significant bits
                    0X000F,                             $ compatible with all conections
                    "Status",                           $ name string
                    6,                                  $ path length
                    "20 04 24 2C 30 03",                $ assy obj(4), inst 44d(0x2C), attr 3
                    "Producing connection contains the status of the eight outputs";

      Output1 =     1,                                  $ size = 1 byte
                    8,                                  $ 8 significant bits
                    0X000D,                             $ compatible with polled connection
                    "Data",                             $ name string
                    6,                                  $ path length
                    "20 04 24 22 30 03",                $ assy obj(4), inst 34d(0x22), attr 3
                    "Consuming connection contains state of the eight outputs";

[ParamClass]
	MaxInst =     122;
	Descriptor =  0x09;                             $ Individual parameters are setable
                                                      $ Automaticly stored in EERPOM
	CfgAssembly = 0x7B;                             $ the custom config assembly is 123d(0x7B)

[Assembly]
        Assem34=    "Data",
                    "",                                 $ Path is (assy obj.(4), inst 34d(0x22), attr 3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param110;                        $ # bits, Group Value for Output

        Assem44=    "Status",
                    "",                                 $ Path is (assy obj(4), inst 44d(0x2C), attr 3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param111;                        $ Was Status of Output

        Assem123 =  "1734-OB8 Configuration Assembly",
                    "",                                 $ Path is (assy obj.(4) inst 123d(0x7B), attr 3)
                    8,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    1,Param43,                          $ # bits, Fault State selection for output 0
                    1,Param45,                          $ # bits, Fault State selection for output 1
                    1,Param47,                          $ # bits, Fault State selection for output 2
                    1,Param49,                          $ # bits, Fault State selection for output 3
                    1,Param51,                          $ # bits, Fault State selection for output 4
                    1,Param53,                          $ # bits, Fault State selection for output 5
                    1,Param55,                          $ # bits, Fault State selection for output 6
                    1,Param57,                          $ # bits, Fault State selection for output 7

                    1,Param44,                          $ # bits, Fault Value selection for output 0
                    1,Param46,                          $ # bits, Fault Value selection for output 1
                    1,Param48,                          $ # bits, Fault Value selection for output 2
                    1,Param50,                          $ # bits, Fault Value selection for output 3
                    1,Param52,                          $ # bits, Fault Value selection for output 4
                    1,Param54,                          $ # bits, Fault Value selection for output 5
                    1,Param56,                          $ # bits, Fault Value selection for output 6
                    1,Param58,                          $ # bits, Fault Value selection for output 7

                    1,Param59,                          $ # bits, Idle State selection for output 0
                    1,Param61,                          $ # bits, Idle State selection for output 1
                    1,Param63,                          $ # bits, Idle State selection for output 2
                    1,Param65,                          $ # bits, Idle State selection for output 3
                    1,Param67,                          $ # bits, Idle State selection for output 4
                    1,Param69,                          $ # bits, Idle State selection for output 5
                    1,Param71,                          $ # bits, Idle State selection for output 6
                    1,Param73,                          $ # bits, Idle State selection for output 7

                    1,Param60,                          $ # bits, Idle Value selection for output 0
                    1,Param62,                          $ # bits, Idle Value selection for output 1
                    1,Param64,                          $ # bits, Idle Value selection for output 2
                    1,Param66,                          $ # bits, Idle Value selection for output 3
                    1,Param68,                          $ # bits, Idle Value selection for output 4
                    1,Param70,                          $ # bits, Idle Value selection for output 5
                    1,Param72,                          $ # bits, Idle Value selection for output 6
                    1,Param74,                          $ # bits, Idle Value selection for output 7

                    8,,                                 $ was Enable No Load 
                    8,,                                 $ was Reset Mode
                    8,,                                 $ was Enable Latched Alarms 
                    8,;                                 $ pad byte (for word boundary)

    Assem124 =                  $ Private config in Forward Open, Module
        "3rd Party Private Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param121,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem125 =                  $ Private config in Forward Open, Module
        "Adapter Config Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param122,            $ Non-Logix Header (constant 0x7001)
        16,1_RackSize,          $ number of slots
        16,Param121,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem126 =                  $ O2T (output data)
        "Ouput Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        ,Assem34;               $ Assembly sent to module

    Assem127 =                  $ T2O (input data)
        "Input Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        32,,                    $ Fault bits
        ,Assem44;               $ Assembly passed from module

      ProxiedAssem1 =
                    "DC Output Rack Configuration Assembly",
                    "01 SLOT 20 04 24 78 30 03",        $ Path to Assy Obj (4) inst 120d attr 3
                    ,                                   $ total length in bytes
                    0x0000,                             $ descriptor
                    ,,                                  $ ",,"= reserved
                    1,Param106,                         $ Group Fault Action
                    1,Param107,                         $ Group Fault Value
                    1,Param108,                         $ Group Idle Action
                    1,Param109,                         $ Group Idle Value
                    1,,                                 $ was Group No Load Enable
                    1,,                                 $ was Group Reset Mode
                    1,,                                 $ was Group Latch Alarms
                    1,;                                 $ Pad bit

      ProxiedAssem3 = 
                    "Real Time Input Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem44;

      ProxiedAssem4 = 
                    "Real Time Output Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem34;

[Params]
$ Output state
