Param6 =                    $ Module Status
 0,                         $ reserved
 7, "21 04 00 24 B9 30 03", $ Link Path.  
 0x0032,                    $ Value is gettable and Settable.  Enumerated strings are supported.
 1, 2,                      $ Data Type - WORD, Data Size - 2 bytes
 "Module Status",           $ Parameter Name
 "",                        $ Units String
                            $ Help string $$$$$$$$$$$
 "Current Module Status.\n"
 "Byte 0, Bit 0 - Explicit Message Connection Exist (0=No,1=Yes)\n"
 "Byte 0, Bit 1 - Poll Message Connection Exist (0=No,1=Yes)\n"
 "Byte 0, Bit 2 - COS Message Connection Exist (0=No,1=Yes)\n"
 "Byte 0, Bit 3 - Explicit Message Connection Fault (0=No,1=Yes)\n"
 "Byte 0, Bit 4 - Poll Message Connection Fault (0=No,1=Yes)\n"
 "Byte 0, Bit 5 - COS Message Connection Fault (0=No,1=Yes)\n"
 "Byte 0, Bit 6 - Poll Message Connection Idle (0=No,1=Yes)\n"
 "Byte 0, Bit 7 - COS Message Connection Idle (0=No,1=Yes)\n"
 "Byte 1, Bit 0 - Network Fault (0=No,1=Yes)\n"
 "Byte 1, Bit 1 - Minor Fault (0=No,1=Yes)\n"
 "Byte 1, Bit 2 - 24 VDC Power Supply Status (0=Ok,1=Fault)\n",
 0,2047,                   $ Min, Max values
 0,                         $ Default value
 1,1,1,0,                   $ Scaling factors
 0,0,0,0,                   $ Scaling links
 0;                         $ Decimal Places

