      8,                      $ 8 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Network Outputs",      $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B8 30 03", $ Path to Assembly 184.
                              $ Help string follows
      "Contains Produced Network Output Bits";

    Input8 =
