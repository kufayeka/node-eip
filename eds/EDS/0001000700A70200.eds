Param11 =					$ Disable Autobaud
 0,							$ reserved
 7, "21 B4 00 24 01 30 0F",	$ Link Path to disable autobaud attribute.
 0x0002,					$ Value is gettable and Settable.  Enumerated strings are supported.
 4, 1,						$ Data Type - BOOL, Data Size - 1 byte
 "Autobaud Enable",			$ Parameter Name
 "",						$ Units String
							$ Help string $$$$$$$$$$$
 "When enabled, the 800T Pushbutton Station automatically\n"
 "communicates at the network baud rate detected at power-on.\n"
 "When disabled, the baud rate must be set correctly by the\n"
 "user during node commissioning.  This parameter's \n"
 "setting takes effect after a module reset or at power-on.\n"
 "NOTE: Only valid when rotary switch is set between 3-9.",
 0,1,						$ Min, Max values
 1,							$ Default value
 1,1,1,0,					$ Scaling factors
 0,0,0,0,					$ Scaling links
 0;							$ Decimal Places

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param12 =                    $ Input filter Off_to_On Delay selection
 0,                         $ reserved
 7, "21 1D 00 24 01 30 06", $ Link Path. 
 0x0000,                    $ Value is gettable and Settable. Enumerated strings are supported.
 2, 2,                      $ Data Type - UINT, Data Size - 2 bytes
 "Off-to-On Delay",         $ Parameter Name
 "us",                      $ Units String
                            $ Help string $$$$$$$$$$$
 "An input signal must be fully present for this delay period\n"
 "before the 800T Pushbutton Station detects the change.\n"
 "The value must be set in units of microseconds.\n"
 "Valid values are:\n"
 "0:\tNo delay\n"
 "1000:\t1 millisecond delay\n"
 "2000:\t2 millisecond delay\n" 
 "4000:\t4 millisecond delay\n" 
 "8000:\t8 millisecond delay\n" 
 "16000:\t16 millisecond delay",
 0,16000,                   $ Min, Max values
 8000,                      $ Default value
 1,1,1,0,                   $ Scaling factors
 0,0,0,0,                   $ Scaling links
 0;                         $ Decimal Places

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param13 =                    $ Input filter On_to_Off Delay selection
 0,                         $ reserved
 7, "21 1D 00 24 01 30 07", $ Link Path.  
 0x0000,                    $ Value is gettable and Settable.  Enumerated strings are supported.
 2, 2,                      $ Data Type - UINT, Data Size - 2 bytes
 "On-to-Off Delay",         $ Parameter Name
 "us",                      $ Units String
                            $ Help string $$$$$$$$$$$
 "An input signal must be fully absent for this delay period \n"
 "before the 800T Pushbutton Station detects the change.  \n"
 "The value must be set in units of microseconds.\n"
 "Valid values are:\n"
 "0:\tNo delay\n"
 "1000:\t1 millisecond delay\n"
 "2000:\t2 millisecond delay\n" 
 "4000:\t4 millisecond delay\n" 
 "8000:\t8 millisecond delay\n" 
 "16000:\t16 millisecond delay",
 0,16000,                   $ Min, Max values
 8000,                      $ Default value
 1,1,1,0,                   $ Scaling factors
 0,0,0,0,                   $ Scaling links
 0;                         $ Decimal Places

