$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param26 =                	$ Network Override
 0,                      	$ reserved
 7, "21 1E 00 24 01 30 68", $ Link Path.  
 0x0002,                 	$ Value is gettable and Settable.  Enumerated strings are supported.
 4, 1,                   	$ Data Type - BOOL, Data Size - 1 bytes
 "Network Override",      	$ Parameter Name
 "",                   		$ Units String
                         	$ Help string $$$$$$$$$$$
 "Enabling this parameter allows local logic to\n"
 "override normal output behavior in the event\n"
 "of a Network Fault.  Network Faults include,\n"
 "Duplicate MacId failure and Module Bus Off\n"
 "conditions.  The default is Disabled.\n"
 "For more details, consult the product documentation.",
 0,1,                		$ Min, Max values
 0,                      	$ Default value
 1,1,1,0,		  	     	$ Scaling factors
 0,0,0,0,		   	     	$ Scaling links
 0;                      	$ Decimal Places

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param27 =                	$ Comm Override
 0,                      	$ reserved
 7, "21 1E 00 24 01 30 69", $ Link Path.  
 0x0002,                 	$ Value is gettable and Settable.  Enumerated strings are supported.
 4, 1,                   	$ Data Type - BOOL, Data Size - 1 bytes
 "Comm Override",      		$ Parameter Name
 "",                   		$ Units String
                         	$ Help string $$$$$$$$$$$
 "Enabling this parameter allows local logic to override\n"
 "normal output behavior in the event of a Communication\n"
 "Status change.  These events include all states where\n"
 "the module is without an I/O connection in the run state.\n"
 "This can happen if the I/O connection does not exist, \n"
 "has timed out, has been deleted, or is currently idle.\n"
 "The default is Disabled.  For more details, consult the\n"
 "product documentation.",
 0,1,                		$ Min, Max values
 0,                      	$ Default value
 1,1,1,0,		  	     	$ Scaling factors
 0,0,0,0,		   	     	$ Scaling links
 0;                      	$ Decimal Places

