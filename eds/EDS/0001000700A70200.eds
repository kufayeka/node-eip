 0x0000,                    $ Value is gettable and Settable.  Enumerated strings are supported.
 8, 1,                      $ Data Type - USINT, Data Size - 2 bytes
 "Input Assembly",          $ Parameter Name
 "",                        $ Units String
                            $ Help string $$$$$$$$$$$
 "The input assembly produces data to the network.\n"
 "Valid values are:\n"
 "4:\tODVA 8 Input (1 byte)\n"
 "100:\tA-B  Customizable (Uses: In Assy Word 0-3) (0 - 8 bytes)\n"
 "101:\tA-B  8 Inputs & Diagnostic Data (2 bytes)\n"
 "180:\tA-B  DeviceLogix Hardware Inputs (2 bytes)\n"
 "181:\tA-B  Hardware Output Status (2 bytes)\n"
 "182:\tA-B  I/O Fault Status (2 bytes)\n"
 "184:\tA-B  Network Outputs (2 bytes)\n"
 "185:\tA-B  Module Status (2 bytes)\n"
 "186:\tA-B  DeviceLogix Function Block 1-16 Output (2 bytes)\n"
 "187:\tA-B  DeviceLogix Function Block 17-32 Output (2 bytes)\n" 
 "188:\tA-B  DeviceLogix Function Block 33-42 Output (2 bytes)",
 0,188,                     $ Min, Max values
 101,                       $ Default value
 1,1,1,0,                   $ Scaling factors
 0,0,0,0,                   $ Scaling links
 0;                         $ Decimal Places

