[Device]
    VendCode = 1;
    VendName = "Rockwell Automation/Allen Bradley";
    ProdType = 7;
    ProdTypeStr = "General Purpose Discrete I/O";
    ProdCode = 167;
    MajRev = 2;
    MinRev = 1;
    ProdName = "800T Pushbutton Station";
    Catalog = "800T-XXXXXXXXX";
    Icon = "800T_PB.ico";	

    1_RSNetWorx_DNetTool = "LeoApp.LeoDevice";
    1_RSNetWorx_DNetToolEx = "1.00.00", "LeoApp.LeoDevice",
			"7.00","RSI.DeviceNet.EDSApplet.1";
    1_DNetEDSAppletPlugIn = "7.00.00", "DeviceLogixPlugIn.EDSAppletPlugIn.1";

[IO_Info]

    1_COSetSizeNotSupported = 1;
    
    Default = 0x0004;         $ The default I/O type is COS I/O.

    PollInfo =
      0x000D,                 $ OK to combine Poll and COS or Poll and Cyclic.
      1,                      $ Input1 entry is the default input connection.
      1;                      $ Output1 entry is the default output connection.

    COSInfo =
      0x0005,                 $ OK to combine Poll and COS.
      1,                      $ Input1 entry is the default input connection.
      1;                      $ Output1 entry is the default output connection.

    CyclicInfo =
      0x0009,                 $ OK to combine Poll and Cyclic.
      1,                      $ Input1 entry is the default input connection.
      1;                      $ Output1 entry is the default output connection.

    Input1 =
      2,                      $ The size in bytes that this connection produces.
      13,                     $ 13 bits of this connection are significant.
      0x000D,                 $ OK for Poll and/or COS. Default COS
      "Status",               $ Name of Connection.
      7,                      $ Path length.
      "21 04 00 24 65 30 03", $ Path to I/O Production Assembly 101.
                              $ Help string $$$$$$$$$$$
      "Contains default input data ";

    InputExa1 =
      ,                       $ Size from AssemN.
      ,                       $ Bits determined by AssemN member list
      0x000D,                 $ OK for Poll, COS or Cyclic.
      ,                       $ Name String from AssemN.
      ,                       $ Path Size not applicable
      VariantExa1,            $ Variant for choosing Input Assem
      ;                       $ Help string not applicable

    Input2 =
      1,                      $ The size in bytes that this connection produces.
      0,                      $ all bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "ODVA Status",          $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 03 30 03", $ Path to Assembly 4.
                              $ Help string follows
      "Contains hardware input data at bits 0-7";

    InputExa2 =
      1,                      $ The size in bytes that this connection produces.
      0,                      $ All bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "ODVA Status",          $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 04 30 03", $ Path to Assembly 4.
                              $ Help string follows
      "Contains hardware input data at bits 0-7";

    Input3 =
      8,                      $ 8 bytes
      64,                     $ 64 bits are significant
      0x000D,                 $ Poll, COS, Cyclic
      "Parameter Based",      $ Name String
      7,                      $ Path Size
      "21 04 00 24 64 30 03", $ Path to Assembly 100.
                              $ Help string follows
      "Contents determined by params 15-18";

    InputExa3 =
      8,                      $ 8 bytes
      64,                     $ 64 bits are significant
      0x000D,                 $ Poll, COS, Cyclic
      "Parameter Based",      $ Name String
      7,                      $ Path Size
      "21 04 00 24 64 30 03", $ Path to Assembly 100.
                              $ Help string follows
      "Contents determined by params 15-18";

    Input4 =
      2,                      $ The size in bytes that this connection produces.
      8,                      $ First 8 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Hdw Inputs",           $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B4 30 03", $ Path to Assembly 180.
                              $ Help string follows
      "Contains hardware input data at bits 0-7";

    InputExa4 =
      2,                      $ The size in bytes that this connection produces.
      8,                      $ First 8 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Hdw Inputs",           $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B4 30 03", $ Path to Assembly 180.
                              $ Help string follows
      "Contains hardware input data at bits 0-7";

    Input5 =
      2,                      $ The size in bytes that this connection consumes.
      4,                      $ Only the 4 least significant bits of this connection are used.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Hdw Outputs",          $ Name of Connection.
      7,                      $ Path length.
      "21 04 00 24 B5 30 03", $ Path to Assembly 181.
                              $ Help string follows
      "Contains value status data for four hardware outputs.";

    InputExa5 =
      2,                      $ The size in bytes that this connection consumes.
      4,                      $ Only the 4 least significant bits of this connection are used.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Hdw Outputs",          $ Name of Connection.
      7,                      $ Path length.
      "21 04 00 24 B5 30 03", $ Path to Assembly 181.
                              $ Help string follows
      "Contains value status data for four hardware outputs.";

    Input6 =
      2,                      $ The size in bytes that this connection produces.
      5,                      $ First 5 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "IO Flt Status",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B6 30 03", $ Path to Assembly 182.
                              $ Help string follows
      "Contains input fault status.";

    InputExa6 =
      2,                      $ The size in bytes that this connection produces.
      5,                      $ First 5 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "IO Flt Status",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B6 30 03", $ Path to Assembly 182.
                              $ Help string follows
      "Contains input fault status.";

    Input7 =
