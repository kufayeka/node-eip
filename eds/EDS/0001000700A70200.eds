Param63 =					$ Enable POT
 0,							$ reserved
 7, "21 0A 00 24 01 30 64",	$ Link Path to disable autobaud attribute.
 0x0002,					$ Value is gettable and Settable.  Enumerated strings are supported.
 4, 1,						$ Data Type - BOOL, Data Size - 1 byte
 "Pot Enable",				$ Parameter Name
 "",						$ Units String
							$ Help string $$$$$$$$$$$
 "When enabled, the potentiometer value will be read by\n"
 "the 800T Push Button Station.  When Disabled, the\n"
 "potentiometer value will not be read but the Out 3 Status\n"
 "bit will be.  \n"
 "\n"
 "NOTE: Default setting is Disabled, and a fault on Out 3 Status bit\n"
 "will cause a minor fault on the 800T Push Button Station\n",
 0,1,						$ Min, Max values
 1,							$ Default value
 1,1,1,0,					$ Scaling factors
 0,0,0,0,					$ Scaling links
 0;							$ Decimal Places

