      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Module Status",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B9 30 03", $ Path to Assembly 185.
                              $ Help string follows
      "Contains module status bits";

    InputExa8 =
      2,                      $ The size in bytes that this connection produces.
      11,                     $ 11 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "Module Status",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 B9 30 03", $ Path to Assembly 185.
                              $ Help string follows
      "Contains module status bits";

    Input9 =
      2,                      $ The size in bytes that this connection produces.
      0,                      $ All bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "FB Outs 1-16",         $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 BA 30 03", $ Path to Assembly 186.
                              $ Help string follows
      "Contains the output of function blocks 1-16";

    InputExa9 =
      2,                      $ The size in bytes that this connection produces.
      0,                      $ All bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "FB Outs 1-16",         $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 BA 30 03", $ Path to Assembly 186.
                              $ Help string follows
      "Contains the output of function blocks 1-16";

    Input10 =
      2,                      $ The size in bytes that this connection produces.
      0,                      $ All bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "FB Outs 17-32",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 BB 30 03", $ Path to Assembly 187.
                              $ Help string follows
      "Contains the output of function blocks 17-32";

    InputExa10 =
      2,                      $ The size in bytes that this connection produces.
      0,                      $ All bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "FB Outs 17-32",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 BB 30 03", $ Path to Assembly 187.
                              $ Help string follows
      "Contains the output of function blocks 17-32";

    Input11 =
      2,                      $ The size in bytes that this connection produces.
      10,                     $ 10 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "FB Outs 33-42",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 BB 30 03", $ Path to Assembly 188.
                              $ Help string follows
      "Contains the output of function blocks 33-42";

    InputExa11 =
      2,                      $ The size in bytes that this connection produces.
      10,                     $ 10 bits of this assembly are significant.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "FB Outs 33-42",        $ Name of Assembly.
      7,                      $ Path length.
      "21 04 00 24 BB 30 03", $ Path to Assembly 188.
                              $ Help string follows
      "Contains the output of function blocks 33-42";


    Output1 =
      1,                      $ The size in bytes that this connection consumes.
      0,                      $ All bits of this connection are used.
      0x000D,                 $ OK for Poll and/or COS. Default COS
      "Consumption Data",     $ Name of Connection.
      7,                      $ Path length.
      "21 04 00 24 21 30 03", $ Path to I/O Consumption Assembly 33.
                              $ Help string $$$$$$$$$$$
      "Contains default output data ";

     OutputExa1 =
      ,                       $ Size from AssemN
      ,                       $ Bits determined by AssemN member list
      0x000D,                 $ OK for Poll, COS or Cyclic.
      ,                       $ Name String from AssemN
      ,                       $ Path Size not applicable
      VariantExa2,            $ Variant for choosing Output Assem
      ;                       $ Help string not applicable

   Output2 =
      2,                      $ The size in bytes that this connection consumes.
      0,                      $ All bits of this connection are used.
      0x000D,                 $ OK for Poll, COS or Cyclic.
      "DeviceLogix Cmd",      $ Name of Connection.
      7,                      $ Path length.
      "21 04 00 24 B7 30 03", $ Path to I/O Consumption Assembly 183.
                              $ Help string follows
