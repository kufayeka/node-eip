$ Electronic Data Sheet for Powermonitor 3000 - M8 - ControlNet - Class 0.5 accuracy
$ Covers bulletin 1404-M8***-CNT devices
$ ControlNet PM3000 does not support any parameter objects or configuration assemblies

[File]
   DescText = "EDS for PM3000 - M8 - ControlNet - Class 0.5 accuracy";
   CreateDate = 03-21-2003;
   CreateTime = 09:00:00;
   ModDate = 06-07-2011;
   ModTime = 14:47:00;
   Revision = 1.7;              $ revision of this EDS file
   HomeURL = "http://www.ab.com/networks/eds/EN/00010073009B0403.eds";  $ where EDS and other files can be found

[Device]
   VendCode = 1;
   VendName = "Rockwell Automation - Allen-Bradley";
   ProdType = 115;
   ProdTypeStr = "Rockwell Automation Miscellaneous";
   ProdCode = 0x9B;             $ M8 - ControlNet - Class 0.5 accuracy
   MajRev = 4;                  $ Device Major Revision
   MinRev = 3;                 $ Device Minor Revision
   ProdName = "PM3000 M8 w/ControlNet, Class 0.5";
   Catalog = "1404-M8xxx-CNT";
   Icon = "Pm3000IconRev1.ico";

[Device Classification]
   Class1 = ControlNet;
 
[Port]
    Port2 = ControlNet_Redundant,   $ Port type
            "ControlNet",           $ Port name
            "20 F0 24 01",          $ Path to Port object, The CNet object for PV
            2;                      $ Port Number

[ParamClass]
        MaxInst = 23;
        Descriptor = 0x0000;
        CfgAssembly = 0;

