[File]
	DescText =    "ArmorPoint 1738-OB16E25DS/A";                   
	CreateDate  = 08-25-2006;
	CreateTime  = 12:00:00;
	ModDate     = 10-17-2006;
	ModTime     = 12:00:00;
	Revision    = 1.1;
	HomeURL    = "http://www.ab.com/networks/eds/DN/0001000701360300.eds";

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 310;                                $ Product Code  0xEC

	MajRev      = 3;                                  $ Major Rev
	MinRev      = 10;                                  $ Minor Rev
	VendName    = "Allen-Bradley Company, Inc.";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "1738-OB16E25DS/A 16pt DC Output";
	Catalog     = "1738-OB16E25DS/A";
	Icon	    = "1738-1DB25GREEN_16.ico";
	1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
	1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
     Class1 =      DeviceNet;

[IO_Info]
	Default =     0X0004;                           $ COS is default

	PollInfo    = 0X000F,                           $ compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

    StrobeInfo =  0X000F,                               $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ No strobe connection here

    COSInfo =     0X0007,                               $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

    CyclicInfo =  0X000B,                               $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

	Input1 =    1,                                  $ size = 1 bytes
                    8,                                  $ 8 significant bits
                    0X000F,                             $ compatible with all conections
                    "1738-OB16E25DS Produce Connection",       $ name string
                    6,                                  $ path length
                    "20 04 24 65 30 03",                $ assy obj, inst 44d(0x2C), attr 3
                    "Producing connection contains the status of the sixteen outputs";

	Output1 =   2,                                  $ size = 2 bytes
                    16,                                 $ 16 significant bits
                    0X000D,                             $ compatible with polled connection
                    "1738-OB16E25DS Consuming Connection",     $ name string
                    6,                                  $ path length
                    "20 04 24 25 30 03",                $ assy obj, inst 34d(0x22), attr 3
                    "Consuming connection contains state of the sixteen outputs";

[ParamClass]
	MaxInst =     52;
	Descriptor =  0x09;                             $ Individual parameters are setable
                                                        $ Automaticly stored in EERPOM
	CfgAssembly = 0x7B;                             $ the custom config assembly is 123d

[Assembly]
        Assem37=    "1738-OB16E25DS Consume Assembly",
                    "",                                 $ Path is Assy Obj Class 4 Inst 25 Attr3)
                    2,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    1, Param1,                          $ # bits, Value for Output #0
                    1, Param2,                          $ # bits, Value for Output #1
                    1, Param3,                          $ # bits, Value for Output #2
                    1, Param4,                          $ # bits, Value for Output #3
                    1, Param5,                          $ # bits, Value for Output #4
                    1, Param6,                          $ # bits, Value for Output #5
                    1, Param7,                          $ # bits, Value for Output #6
                    1, Param8,                          $ # bits, Value for Output #7
		    1, Param9,                          $ # bits, Value for Output #8
                    1, Param10,                         $ # bits, Value for Output #9
                    1, Param11,                         $ # bits, Value for Output #10
                    1, Param12,                         $ # bits, Value for Output #11
                    1, Param13,                         $ # bits, Value for Output #12
                    1, Param14,                         $ # bits, Value for Output #13
                    1, Param15,                         $ # bits, Value for Output #14
                    1, Param16,                         $ # bits, Value for Output #15
                    0,;                                 $ Pad bits none, all used

        Assem101=   "1738-OB16E25DS Produce Assembly",
                    "",                                 $ Path is Assy Obj Class 4 Inst 65 Attr3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    1, Param33,                         $ Status of Outputs 0-3
                    1, Param34,                         $ Status of Outputs 4-7
                    1, Param35,                         $ Status of Outputs 8-11
                    1, Param36,                         $ Status of Outputs 12-15
                    1, Param37,                         $ Status Fault LED
                    3,;                                 $ Pad bits                               

        Assem123 =  "1738-OB16E25DS Configuration Assembly",
                    "",                                 $ Path is implied (Assy obj attr3)
                    2,                                  $ total length in bytes
                    0,,,                                $ changes, ",,"= reserved
                    1,Param45,                          $ # bits, Fault State selection 
                    1,Param46,                          $ # bits, Fault Value selection 
                    1,Param47,                          $ # bits, Idle State selection 
                    1,Param48,                          $ # bits, Idle Value selection 
                    1,Param42,                          $ # bits, Output Latch selection  
                    3,,                                 $ pad bits none, all used
                    8,;                                 $ pad bits

 
    Assem124 =                  $ Private config in Forward Open, Module
        "3rd Party Private Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param121,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem125 =                  $ Private config in Forward Open, Module
        "Adapter Config Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param122,            $ Non-Logix Header (constant 0x7001)
        16,1_RackSize,          $ number of slots
        16,Param121,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem126 =                  $ O2T (output data)
        "Ouput Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        ,Assem37;               $ Assembly sent to module

    Assem127 =                  $ T2O (input data)
        "Input Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        32,,                    $ Fault bits
        ,Assem101;              $ Assembly passed from module


      ProxiedAssem3 = 
                    "Real Time Input Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem101;

      ProxiedAssem4 = 
                    "Real Time Output Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem37;

