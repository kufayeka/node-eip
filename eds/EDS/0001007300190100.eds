                    0x0032,                             $ No support for: settable path, scaling, scaling links.
                                                        $ Real time update of value.  Value is gettable only.
                    4,                                  $ Data boolean
                    1,                                  $ Data Size
                    "Bad Cal Status #1",                $ Parameter Name
                    "",                                 $ Units String
                    "This bit shows the current status of calibration for this channel.\n'Good Calibration' means the data stored in EEPROM is within tollerances.\n'Calibration Fault' means the module is not calibrated and is using default values.\n\nNote:  While in Calibration Mode, the status will be 'Bad Calibration.'",
                    0,1,0,                              $ Min, Max (max enumeration #), and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

$ Autobaud
      Param36 =     $ Disable Autobaud
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 03 24 01 30 64",                $ Link Path to disable autobaud attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    4,                                  $ Data Type - boolean
                    1,                                  $ Data Size
                    "Autobaud",                         $ Parameter Name
                    "",                                 $ Units String
                    "Autobaud allows module to match the baud rate of existing devices on a network.\n\nChanges to this attribute take effect after next powerup.\nIf 'enabled', the Baud Rate Attribute can not be set.",
                    0,1,1,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

$Parameter Objects
      Param37 =     $ Cal Mask
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 0F 24 01 30 01",                $ Link Path to Cal Mask attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
