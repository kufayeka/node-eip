                    0x0000,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are Not supported.
                    11,                                 $ Data Type - byte
                    4,                                  $ Data Size
                    "Channel 1 High Value",             $ Parameter Name
                    "mA",                               $ Units String
                    "Enter the measured value at the output terminal after issuing the 'Ouput High Reference' command.\nEnter the value in milliamps (e.g. 20.022).",
                    -3.402823E+38,3.402823E+38,0,       $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Param42 =     $ Cal Service
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 0F 24 06 30 01",                $ Link Path to Cal Service attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    8,                                  $ Data Type - byte
                    1,                                  $ Data Size
                    "Calibration Command",              $ Parameter Name
                    "",                                 $ Units String
                    "This command puts the module in different calibration modes.\n\nBegin Calibration - Initializes the module for calibration.\nOutput Low Reference - Generates approximately 4 mA at the selected output(s).\nOutput High Reference - Generates approximately 20 mA at the selected output(s).\nFinish Calibration - Uses the measured values to compensate the output(s).\nAbort Calibration - Immeadately terminates calibration process and uses previous calibration.\n\nNote: Module must be stand-alone or in Idle/Program mode.\nFurther Note: The Low and High measured values must be sent to the module before issuing the 'Finish Calibration' command.",
                    0,5,0,                              $ Min, Max, and Default values 
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Param43 =     $ reset Service
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 0F 24 07 30 01",                $ Link Path to reset Service attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    8,                                  $ Data Type - byte
                    1,                                  $ Data Size
                    "Reset Latched Alarms",             $ Parameter Name
                    "",                                 $ Units String
                    "This parameter clears any latched alarms in the selected channel(s).\nIf alarm condition still exists, the fault will not be cleared.",
                    0,3,0,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

$Point Object stuff
      Param44 =     $ AutoAddress
                    0,                                  $ reserved
                    7,                                  $ Link Path Size
                    "21 12 03 24 01 30 03",             $ Link Path to AutoAddress attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    4,                                  $ Data Type - boolean
                    1,                                  $ Data Size
                    "Sequential AutoAddress",           $ Parameter Name
                    "",                                 $ Units String
                    "Sequential AutoAddress will re-assign the node address of ever module to the right.\nEach module will change it's node address to one greater than then it's neighbor.\n\nMAKE SURE THE NODE ADDRESS OF THIS MODULE IS THE DESIRED VALUE BEFORE ISSUING THIS COMMAND.\n\nWhen this command is set, each module to the right will get a new address one greater than it's neighbor.\nThe address will ripple through a line of Point I/O modules.\n\nSteps to Auto Address a line of Point I/O modules:\n 1.) Set the address of the first module (next to PDN or adapter).\n 2.) Send the Auto Address command to 'Sequential Address.'\n 3.) All modules in line will reset with new sequential addresses.\n\nExample:\nIf there are 5 Point modules in a line, and the address of the first module is 10.\nAfter the 'Sequential Address' command is sent to the first module, the node address of the line will be:\n 10, 11, 12, 13, and 14.",
                    0,1,0,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Param45 =     $ Baud Rate
                    0,                                  $ reserved
                    7,                                  $ Link Path Size
                    "21 12 03 24 01 30 05",             $ Link Path to Baud Rate attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    8,                                  $ Data Type - byte
                    1,                                  $ Data Size
                    "Broadcast Baud Rate",              $ Parameter Name
                    "",                                 $ Units String
                    "This command will change the baud rate of this and every module to the right\nto the value indicated.\nIf AutoBaud is ENABLED, this command will not change the operation of the module at power up.",
                    0,2,0,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Param46 =     $ Set Disable AutoBaud
                    0,                                  $ reserved
                    7,                                  $ Link Path Size
                    "21 12 03 24 01 30 06",             $ Link Path to Disable AutoBaud attribute.
                    0x0002,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are supported.
                    8,                                  $ Data Type - byte
                    1,                                  $ Data Size
                    "Broadcast AutoBaud",               $ Parameter Name
                    "",                                 $ Units String
                    "This command will change the AutoBaud attribute of this and every module to the right\nto the value indicated.\nIf AutoBaud is 'disabled,' the Baud Rate parameter will set the baud rate next time the module is powered up.",
                    0,1,0,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

[EnumPar]
      Param1 =      "Idle","Run";                       $ Run/Idle command
      Param4 =      "Normal Operation", "FAULT";        $ status 0
      Param5 =      "Normal Operation", "FAULT";        $ status 1
      Param6 =      "4mA to 20mA",                      $ range 0
                    "0 V to 10 V (Invalid)",
                    "0mA to 20mA",
                    "-10 V to 10 V (Invalid)",
                    "0 V to  5 V (Invalid)",
                    "-5 V to  5 V (Invalid)",
                    "1 V to  5 V (Invalid)",
                    "-15mV to 75mV (Invalid)",
                    "-15mV to 30mV (Invalid)",
                    "0mA to 50mA (Invalid)";
      Param7 =      "4mA to 20mA",                      $ range 1
                    "0 V to 10 V (Invalid)",
                    "0mA to 20mA",
                    "-10 V to 10 V (Invalid)",
                    "0 V to  5 V (Invalid)",
                    "-5 V to  5 V (Invalid)",
                    "1 V to  5 V (Invalid)",
                    "-15mV to 75mV (Invalid)",
                    "-15mV to 30mV (Invalid)",
                    "0mA to 50mA (Invalid)";
      Param8 =      "Signed Integer", "Real",           $ type 0
                    "Unsigned Integer";
      Param9 =      "Signed Integer", "Real",           $ type 1
                    "Unsigned Integer";
      Param10 =     "Hold Last State","Go to Low Clamp",$ fault state 0
                    "Go to High Clamp","Go to Fault Value";
      Param11 =     "Hold Last State","Go to Low Clamp",$ fault state 1
                    "Go to High Clamp","Go to Fault Value";
      Param12 =     "Hold Last State","Go to Low Clamp",$ idle state 0
                    "Go to High Clamp","Go to Idle Value";
      Param13 =     "Hold Last State","Go to Low Clamp",$ idle state 1
                    "Go to High Clamp","Go to Idle Value";
      Param26 =     "Disable","Enable Latching Alarms"; $ latch alarms 0
      Param27 =     "Disable","Enable Latching Alarms"; $ latch alarms 1
      Param28 =     "Alarms Enabled","Alarms Disabled"; $ disable alarms 0
      Param29 =     "Alarms Enabled","Alarms Disabled"; $ disable alarms 1
      Param30 =     "No Fault","Low Clamp FAULT";       $ low Clamp 0
      Param31 =     "No Fault","Low Clamp FAULT";       $ low Clamp 1
      Param32 =     "No Fault","High Clamp FAULT";      $ high Clamp 0
      Param33 =     "No Fault","High Clamp FAULT";      $ high Clamp 1
      Param34 =     "Good Calibration",                 $ bad cal 0
                    "Calibration FAULT";
      Param35 =     "Good Calibration",                 $ bad cal 1
                    "Calibration FAULT";
      Param36 =     "Enable","Disable";                 $ Autobaud
      Param37 =     "None","Channel 0","Channel 1",     $ Cal Mask
                    "Both Channels";
      Param42 =     "Do Nothing","Begin Calibration",   $ calservice
                    "Output Low Reference","Output High Reference",
                    "Finish Calibration","Abort Calibration";
      Param43 =     "Do Nothing","Channel 0",           $ Reset Service
                    "Channel 1","Both Channels";
      Param44 =     "Do Nothing","Sequential Address";  $ Auto address
      Param45 =     "125 kHz","250 kHz","500 kHz";      $ baud rate
      Param46 =     "Enable","Disable";                 $ Autobaud

