                    -3.402823E+38,3.402823E+38,0,       $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Param40 =     $ Chan1Lo
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
                    "20 0F 24 04 30 01",                $ Link Path to Chan1Lo attribute.
                    0x0000,                             $ No support for: settable path, scaling, scaling links, or
                                                        $ real time update of value.  Value is gettable and 
                                                        $ Settable.  Enumerated strings are Not supported.
                    11,                                 $ Data Type - byte
                    4,                                  $ Data Size
                    "Channel 1 Low Value",              $ Parameter Name
                    "mA",                               $ Units String
                    "Enter the measured value at the output terminal after issuing the 'Ouput Low Reference' command.\nEnter the value in milliamps (e.g. 4.041).",
                    -3.402823E+38,3.402823E+38,0,       $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Param41 =     $ Chan1Hi
                    0,                                  $ reserved
                    6,                                  $ Link Path Size
