$ Electronic Data Sheet for Point I/O  (1734-OE2C)

[File]
	DescText    = "PointIO 1734-OE2C";                    
	CreateDate  = 06-30-1999;                            
	CreateTime  = 16:09:35;                         
	ModDate     = 03-15-2006;                               
	ModTime     = 06:50:00;                            
	Revision    = 1.3;                              

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 115;                                $ Product Type
	ProdCode    = 25;                                 $ Product Code

	MajRev      = 1;                                  $ Major Rev
	MinRev      = 2;                                  $ Minor Rev
	VendName    = "Allen-Bradley Company, Inc.";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "PointIO 2pt 24Vdc Analog Current Output";
	Catalog     = "1734-OE2C";

[IO_Info]
	Default =     0X0001;                             $ Poll is default

	PollInfo =    0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      COSInfo =     0X0007,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      CyclicInfo =  0X000B,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

	Input1 =      2,                                  $ size = 2 byte
                    0,                                  $ All significant bits
                    0X000F,                             $ compatible with polled connection
                    "1734-OE2C Produce Connection",     $ name string
                    6,                                  $ path length
                    "20 04 24 65 30 03",                $ assy obj, inst 101d, attr 3
                    "Producing connection contains status of the two outputs.";

	Output1 =     4,                                  $ size = 4 byte
                    0,                                  $ All significant bits
                    0X000D,                             $ compatible with polled connection
                    "1734-OE2C Consume Connection",     $ name string
                    6,                                  $ path length
                    "20 04 24 66 30 03",                $ assy obj, inst 102d, attr 3
                    "Consume connection contains value of the two outputs.";


[ParamClass]
	MaxInst     = 46;
	Descriptor  = 0x09;                               $ Individual parameters are setable
