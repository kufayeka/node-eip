                    8,                                  $ Data Type - byte
                    1,                                  $ Data Size
                    "Calibration Channel Select",       $ Parameter Name
                    "",                                 $ Units String
                    "Choose which channel or channels to calibrate.",
                    0,3,0,                              $ Min, Max, and Default values
                    1,1,1,0,0,0,0,0,0;                  $ Not Used

      Param38 =     $ Chan0Lo
                    0,                                  $ reserved
