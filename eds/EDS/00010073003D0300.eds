[File]
        DescText = "PointIO 1734-ARM";
        CreateDate = 10-10-2004;
        CreateTime = 16:09:35;
        ModDate = 03-14-2011;
        ModTime = 11:31:00;
        Revision = 1.03;
        HomeURL = "http://www.ab.com/networks/eds/DN/00010073003D0300.eds";

[Device]
        VendCode = 1;                   $ Vendor Code
        VendName = "Allen-Bradley Company, Inc.";
        ProdType = 115;                 $ Product Type 0x73
        ProdTypeStr = "Miscellaneous";
        ProdCode = 61;                  $ Product Code 0x3D

        MajRev = 3;                     $ Major Rev
        MinRev = 13;                    $ Minor Rev
        ProdName = "PointIO Address Reserve Module";
        Catalog = "1734-ARM/C";
        Icon = "1734grey.ico";
        1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
        1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
        Class1 = DeviceNet;

[IO_Info]

        Default = 0x0004;       $ COS is default

        PollInfo =
                0x000F,         $ Compatable with all
                1,              $ no input
                0;              $ no consumed connection

        StrobeInfo =
                0x000F,         $ Compatable with all
                1,              $ no input
                0;              $ no consumed connection

        COSInfo =
                0x0007,         $ Compatable with all
                1,              $ no input
                0;              $ no consumed connection

        CyclicInfo =
                0x000B,         $ Compatable with all
                1,              $ no input
                0;              $ no consumed connection

        Input1 =
                1,                      $ size = 1 byte
                0,                      $ 0 significant bits
                0x000F,                 $ compatible with all connection
                "1734-ARM Produce Connection",    $ name string
                6,                      $ path length
                "20 04 24 02 30 03",    $ assy obj, inst 2, attr 3
                "Producing connection contains no usable data";
        1_COSetPathNotSupported = 1;    $ Cnxn Obj does not support direct path setting


[ParamClass]
        MaxInst = 4;
        Descriptor = 0x0009;            $ Individual parameters are setable
                                        $ Automaticly stored in EERPOM
        CfgAssembly = 0;


[Params]

    $ Autobaud
        Param1 =                        $ Disable Autobaud
                0,                      $ reserved
                6,"20 03 24 01 30 64",  $ Link Path Size
                                        $ Link Path to disable autobaud attribute.
                0x000E,                 $ No support for: settable path, scaling, scaling links, or
                                        $ real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
                0xC1,                   $ Data Type - boolean
                1,                      $ Data Size
                "Autobaud",             $ Parameter Name
                "",                     $ Units String
                "Autobaud allows module to match the baud rate of existing devices on a network.\n"
                "\n"
                "Changes to this attribute take effect after next powerup.\n"
                "If 'enabled', the Baud Rate Attribute can not be set.",
                0,1,1,                  $ Min, Max, and Default values
                1,1,1,0,
                0,0,0,0,
                0;                      $ Not Used

    $ Point Object stuff
        Param2 =                        $ AutoAddress
                0,                      $ reserved
                7,"21 12 03 24 01 30 03",    $ Link Path Size
                                             $ Link Path to AutoAddress attribute.
                0x000E,                 $ No support for: settable path, scaling, scaling links, or
                                        $ real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
                0xC1,                   $ Data Type - boolean
                1,                      $ Data Size
                "Sequential AutoAddress",    $ Parameter Name
                "",                     $ Units String
                "Sequential AutoAddress will re-assign the node address of ever module to the right.\n"
                "Each module will change it's node address to one greater than then it's neighbor.\n"
                "\n"
                "MAKE SURE THE NODE ADDRESS OF THIS MODULE IS THE DESIRED VALUE BEFORE ISSUING THIS COMMAND.\n"
                "\n"
                "When this command is set, each module to the right will get a new address one greater than it's neighbor.\n"
                "The address will ripple through a line of Point I/O modules.\n"
                "\n"
                "Steps to Auto Address a line of Point I/O modules:\n"
                " 1.) Set the address of the first module (next to PDN or adapter).\n"
                " 2.) Send the Auto Address command to 'Sequential Address.'\n"
                " 3.) All modules in line will reset with new sequential addresses.\n"
                "\n"
                "Example:\n"
                "If there are 5 Point modules in a line, and the address of the first module is 10.\n"
                "After the 'Sequential Address' command is sent to the first module, the node address of the line will be:\n"
                " 10, 11, 12, 13, and 14.",
                0,1,0,                  $ Min, Max, and Default values
                1,1,1,0,
                0,0,0,0,
                0;                      $ Not Used

        Param3 =                        $ Baud Rate
                0,                      $ reserved
                7,"21 12 03 24 01 30 05",    $ Link Path Size
                                             $ Link Path to Baud Rate attribute.
                0x000E,                 $ No support for: settable path, scaling, scaling links, or
                                        $ real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
                0xC6,                   $ Data Type - usint
                1,                      $ Data Size
                "Broadcast Baud Rate",  $ Parameter Name
                "",                     $ Units String
                "This command will change the baud rate of this and every module to the right\n"
                "to the value indicated.\n"
                "If AutoBaud is ENABLED, this command will not change the operation of the module at power up.",
                0,2,0,                  $ Min, Max, and Default values
                1,1,1,0,
                0,0,0,0,
                0;                      $ Not Used

        Param4 =                        $ Set Disable AutoBaud
                0,                      $ reserved
                7,"21 12 03 24 01 30 06",    $ Link Path Size
                                             $ Link Path to Disable AutoBaud attribute.
                0x000E,                 $ No support for: settable path, scaling, scaling links, or
                                        $ real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are supported.
                0xC6,                   $ Data Type - using
                1,                      $ Data Size
                "Broadcast AutoBaud",   $ Parameter Name
                "",                     $ Units String
                "This command will change the AutoBaud attribute of this and every module to the right\n"
                "to the value indicated.\n"
                "If AutoBaud is 'disabled,' the Baud Rate parameter will set the baud rate next time the module is powered up.",
                0,1,0,                  $ Min, Max, and Default values
                1,1,1,0,
                0,0,0,0,
                0;                      $ Not Used

[EnumPar]
        Param1 =
                "Enable",
                "Disable";              $ Autobaud
        Param2 =
                "Do Nothing",
                "Sequential Address";   $ Auto address
        Param3 =
                "125 kHz",
                "250 kHz",
                "500 kHz";              $ baud rate
        Param4 =
                "Enable",
                "Disable";              $ Autobaud

[Port]
        Port1 =
                DeviceNet,              $ or maybe 1_Virtual_Backplane
                "PointIO Backplane",    $ Name of backplane
                "20 03 24 01",          $ Path to DeviceNet Object Instance 1
                1;                      $ Port number 1

