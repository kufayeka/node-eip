$ Electronic Data Sheet for ArmorBlock MaXum I/O  (1792D-8BVT8D)

[File]
DescText = "1792D-8BVT8D ArmorBlock MaXum I/O EDS File";
CreateDate = 10-19-1998;
CreateTime = 12:00:00;
ModDate = 05-03-2000;
ModTime = 15:00:00;
Revision = 1.33;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1075;
MajRev = 1;
MinRev = 4;
ProdName = "1792D-8BVT8D 8Input/8Output";
Catalog = "1792D-8BVT8D";
1_KeepMinorRev = "Yes";
1_Icon=0001_ArmorBlkMaXum8.ico;

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x000D,			$ Poll connection can be used with COS or Cyclic I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ COS connection can be used wiht Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,			$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

Input1 =
4,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x000D,			$ Polled, COS and Cyclic I/O device.
"8BVT8D Production Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 6F 30 03",	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 4 bytes: Byte 1, bits 0-7=Inputs 0-7.\nByte 2, bits 0-3=Input Short Circuit; Connectors A-D.\nBits 4-7=Off Wire Detect; Connectors A-D.\nByte 3, bits 0-7=Output Faults 0-7. Byte 4, bit 6=Output Power.";
			
Output1 =
1,			$ The size in bytes that this connection consumes.
0,			$ All bits of this connection are significant. 
0x000D,			$ Polled, COS and Cyclic I/O device.
"8BVT8D Consumption Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 22 30 03",	$ Path to I/O Consumption Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-7 (Outputs 0-7 respectively).";
			 
[ParamClass]
MaxInst = 35;		$ 21 configurable and 14 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x78;	$ Config assembly.		

