$ Electronic Data Sheet for ArmorBlock MaXum I/O  (1792D-2BV0D)

[File]
DescText = "1792D-2BV0D ArmorBlock MaXum I/O EDS File";
CreateDate = 10-19-1998;
CreateTime = 12:00:00;
ModDate = 05-03-2000;
ModTime = 15:00:00;
Revision = 1.13;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1074;
MajRev = 1;
MinRev = 1;
ProdName = "1792D-2BV0D 2Input";
Catalog = "1792D-2BV0D";
1_KeepMinorRev = "Yes";
1_Icon=0001_ArmorBlkMaXum4.ico;

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x000D,			$ Poll connection can be used with COS or Cyclic I/O.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

COSInfo=
0x0005,                 $ COS connection can be used wiht Polled I/O.
1,                      $ Input1 entry is the default input connection.
0;                      $ There is no consuming connection.

CyclicInfo=
0x0009,			$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

Input1 =
1,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x000D,			$ Polled, COS and Cyclic I/O device.
"2BV0D Production Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 6B 30 03",	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 1 byte: bits 0&1=Inputs 0&1. Bits 2&3=Reserved.\nBits 4&5=Input Short Circuit; Connectors A&D respectively.\nBits 6&7=Offwire Detect; Connectors A&D respectively.";
			
		 
[ParamClass]
MaxInst = 8;		$ 5 configurable and 3 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x76;	$ Config assembly.		

[Params]
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param1 =		$ Disable Autobaud
0,			$ reserved
6,			$ Link Path Size
"20 03 24 01 30 64",	$ Link Path to disable autobaud attribute.
0x0002,			$ No support for settable path, scaling, scaling links, or
			$ real time update of value.  Value is gettable and 
			$ Settable.  Enumerated strings are supported.
4,			$ Data Type - boolean
1,			$ Data Size
"Autobaud",		$ Parameter Name
"",			$ Units String
	$$$$$$$$$$ Help string $$$$$$$$$$$
"Setting this parameter ON disables the Autobaud feature in the block.\nThe change occures after the next power up. Default is Enabled.",
0,1,0,			$ Min, Max, and Default values
1,1,1,0,0,0,0,0,0;		$ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
