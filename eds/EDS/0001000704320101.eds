0,			$ reserved
6,			$ Link Path Size
"20 0F 24 02 30 01",	$ Link Path to param instance.  The param instance decodes
			$ the enumerated parameter into engineering units (micro seconds).
0x0002,			$ No support for settable path, scaling, scaling links,
			$ or real time update of value.  Value is gettable and
			$ Settable.  Enumerated strings are supported.
2,			$ Data Type - unsigned int
2,			$ Data Size - (in bytes)
"Off-to-On Delay",	$ Parameter Name
"ms",			$ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"The input must be ON for the delay period specified (0,2,4,8,16ms)\nbefore the module detects the change.",
0,4,1,			$ Min, Max (max enumeration #), and Default values
1,1,1,0,0,0,0,0,0;		$ Not Used

