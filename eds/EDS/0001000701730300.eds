$ Electronic Data Sheet for Point I/O (1734-8CFG) with Zone Interlocking Parameters

[File]
	DescText    = "PointIO 1734-8CFG/C";
	CreateDate  = 01-01-2008;
	CreateTime  = 12:00:00;
	ModDate     = 02-24-2009;
	ModTime     = 18:00:00;
	Revision    = 3.0;
	HomeURL     = "http://www.ab.com/networks/eds/DN/0001000701730300.eds";

[Device]
    VendCode = 1;                       $ Vendor Code
    ProdType = 7;                       $ Product Type
    ProdCode = 371;                     $ Product Code (0x0173)
    
    MajRev = 3;                         $ Major Rev
    MinRev = 4;                         $ Minor Rev
    
    VendName    = "Rockwell Automation/Allen-Bradley";        
    ProdTypeStr = "General Purpose Discrete I/O";
    ProdName    = "PointIO 24Vdc 8pt Config";
    Catalog     = "1734-8CFG/C";
    Icon        = "1734bluegreen.ico";

    1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
    Class1 = DeviceNet;

[IO_Info]
                                       
    Default  =  0x0004;                 $ The default I/O type is COS I/O.
                                        
    PollInfo =  0x000F,                 $ Poll connection can be used with all connection.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.
                                        
    StrobeInfo= 0x000F,                 $ Strobe connection can be used with all connection.
                1,                      $ Input1 entry is the default input connection.
                0;                      $ No strobe connection here                  
                                        
    COSInfo  =  0x0007,                 $ COS connection can be used with Polled I/O & Strobe I/O.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.

    CyclicInfo =0x000B,                 $ Cyclic connection can be used with Polled I/O & Strobe I/O.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.


    Input1 =    1,                      $ The size in bytes that this connection produces.
                8,                      $ 8 bits of this connection are significant.
                0x000F,                 $ Compatible with all conections
                "Data",                 $ Name of Connection.
                7,                      $ Path length.
                "21 04 00 24 04 30 03", $ Assy obj(4), inst 04d(0x04), attr 3
                "Producing connection contains the status of the eight inputs, eight produced network bits, two produced network words, and the Zone Control Security Key";

    Output1 =   1,                      $ The size in bytes that this connection consumes.
                8,                      $ 8 bits of this connection are significant.
                0x000D,                 $ Compatible with Polled and COS I/O connection
                "Data",                 $ Name of Connection.
                7,                      $ Path length.
                "21 04 00 24 22 30 03", $ Assy obj(4), inst 34d(0x22), attr 3
                "Consuming connection contains state of the eight outputs, eight consumed network bits, and two consumed network words.";

$
$ This section will need to be changed to add additional assemblies
$
	1_COSetPathNotSupported = 1;        $ Cnxn Obj does not support direct path setting
    1_COSetSizeNotSupported = 1;        $ Cnxn Obj does not support direct size setting	
                                         
                                        
[ParamClass]                            
    MaxInst         = 45;               $ Max number of parameters.
    Descriptor      = 0x0009;           $ Individual parameters are settable,Automaticly stored in EERPOM
    CfgAssembly     = 0;                $ 
    1_CfgAssembly   = 0x67;             $ The custom config assembly is 103d(0x67)    

[Params]

        $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
        Param2 =                        $ Input filter Off_to_On Delay selection
                0,                      $ reserved
                7,                      $ Link Path Size
                "21 0F 00 24 02 30 01", $ Link Path to Param Obj Off2On Filter attribute.
                0x0000,                 $ No support for settable path, scaling, scaling links,
                                        $ or real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are NOT supported.
                0xC7,                   $ Data Type - unsigned short int
                2,                      $ Data Size - (in bytes)
                "Off-to-On Delay",      $ Parameter Name
                "us",                   $ Units String
                                        $ $$$$$$$$$ Help string $$$$$$$$$$$
                "OFF to ON transition filter constant.\nA high signal must be present for this amount of time\n"
                "before the module will report an ON.\nValue entered in microseconds (us).\nDefault is 1000 us.",
                0,65535,1000,           $ Min, Max (max enumeration #), and Default values
                ,,,,
                ,,,,
                0;                      $ Not Used
 
        $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
        Param3 =                        $ Input filter On_to_Off Delay selection
                0,                      $ reserved
                7,                      $ Link Path Size
                "21 0F 00 24 03 30 01", $ Link Path to Param Obj On2Off Filter attribute.
                0x0000,                 $ No support for settable path, scaling, scaling links,
                                        $ or real time update of value.  Value is gettable and
                                        $ Settable.  Enumerated strings are NOT supported.
                0xC7,                   $ Data Type - unsigned short int
                2,                      $ Data Size - (in bytes)
                "On-to-Off Delay",      $ Parameter Name
                "us",                   $ Units String
                                        $ $$$$$$$$$ Help string $$$$$$$$$$$
                "ON to OFF transition filter constant.\nA low signal must be present for this amount of time\n"
                "before the module will report an OFF.\nValue entered in microseconds (us).\nDefault is 1000 us.",
                0,65535,1000,           $ Min, Max, and Default values
                ,,,,
                ,,,,
                0;                      $ Not Used

