                7,                      $ Link Path Size
                "21 0F 00 24 04 30 01", $ Link Path to Param instance 04
                0x0032,                 $ No support for settable path, scaling, or scaling links.
                                        $ Value is gettable only. Enumerated strings are supported.
                0xD1,                   $ Data Type - string
                1,                      $ Data Size - (in bytes)
                "Data - Input/Output",  $ Parameter Name
                "",                     $ Units String
                                        $ $$$$$$$$$ Help string $$$$$$$$$$$
                "This parameter is the current value of Inputs/Outputs 0-7, either On(1) or Off(0).",
                0,255,0,                $ Min, Max, and Default values
                ,,,,
                ,,,,
                0;                      $ Not Used
                
