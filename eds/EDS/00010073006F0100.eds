$ Description:	Safeshield Light Curtain Interface Ser A, 1.01
$ Last Changes:	2.01	PAH	11/10/05	Cfg Assy added, updated naming, vendor name,
$						IO Assy added, diagnostic enumeration, data types
$ Note: !!! Not compatible with old .dnt files !!!
$ Note: Compatible with Revision 02.19 of EDS Checker utility
$ Edit History: 0.01	PAH	08/29/01	Created
$		0.02	PAH	01/30/02	Attributes clean up,
$						added groups, added enumerations
$		1.01	PAH	03/20/02	Release for marketing samples
$						Converted from development EDS
$						First rev of help
$		1.02	PAH	07/28/02	Qualification testing, spellcheck
$		1.03	PAH	08/12/02	Beam data numbering, icon stuff
$		1.04	PAH	09/30/02	Help Update, renumbering
$		1.05	PAH	10/10/02	Help and Comments
$		2.01	PAH	11/10/05	

[File]
	DescText    = "442L Light Curtain Interface";     
	CreateDate  = 07-01-2001;
	CreateTime  = 17:22:00;                         
	ModDate     = 10-10-2002;      
	ModTime     = 13:02:00;                            
	Revision    = 2.01;
	HomeURL     = "http://www.ab.com/networks/eds/DN/00010073006F0100.eds";

[Device]
	VendCode    = 0001;
	VendName    = "Rockwell Automation/Allen-Bradley";
	ProdType    = 115;					$Generic 
	ProdTypeStr = "Generic";
	ProdCode    = 111;
	MajRev      = 1;					$ Device Major Revision
	MinRev      = 1;					$ Device Minor Revision
	ProdName    = "Safeshield DeviceNet Interface";
	Catalog     = "442L-MDNET";
	Icon        = "442LMDNET.ico";

$	DNetQC = 0b0000000000000000, 1500; $ Quick Connect Not supported at powerup, 1.5 sec Power up delay

$ Configurationby = 2, EDS, CDS
$ BaudRateSwitch = False
$ Baud Rates supported = 4, 125, 250, 500, auto
$ MACIDSwitch = True
$ MACID supported = 2, 0-63, Setable
$ Faulted Address Recovery = False
$ CCV = True

$ ADR = True
$ AppNVFlash = Flip
$ UCMM = False

$ Node Power = From network
$ Operating Current = 35 ma

$ Response Time = .020 seconds
$ Indicators = 3, Mod/Net LED, Diagnostic, OSSD


[Device Classification]
Class1 = DeviceNet;

[IO_Info]
	1_COSetPathNotSupported = 1;							$ no setting of connection path

	Default     = 0x0004;					$ COS perferred
	PollInfo    = 0x0001, 0, 0;				$ Not supported
	StrobeInfo  = 0x0002, 1, 0;				$ Strobe is  Input1
	COSInfo     = 0x0004, 1, 0;				$ COS is Input1

	PollInfoExa	= 0x0001, 0, 0;				$ Not supported
	StrobeInfoExa	= 0x0002, 1, 0;			$ Strobe is  Input1
	COSInfoExa	= 0x0004, 1, 0;				$ COS is Input1


$ -- Input Connections --

	Input1 = 1,
		8,
		0x0006,           						$ Strobe or COS connection
		"Standard Mode",
		6,
		"20 04 24 01 30 03", 						$ Assembly Object, Instance 1, Attr 3
		"The COS and strobe assembly byte format follows: \n"
		"DB0  OSSD - State of the Relay Output\n"
		"DB1  Reserved\n"
		"DB2  Reserved\n"
		"DB3  Reserved\n"
		"DB4  Fault - Lockout\n"
		"DB5  Warning - diagnostic condition\n"
		"DB6  Signal Strength\n"
		"DB7  Restart Input\n"
		"See specific parameters for more information. \n";

	InputExa1=									$ All
		,									$ data size in bytes, determined based on Assem size
		0,									$ num of significant bits, determined based on Assem 													definition
		0x0006,								$ IO Type mask
		"Variant",									$ name, determined based on Assem name
		,									$ link path size, not required
		VariantExa1, 							$ link path, obtained from Assem
		" ";									$ help string


[ParamClass]
	MaxInst		= 51;
	Descriptor		= 0x0B;
 	1_CfgAssembly  	= 140;						$ Null configuration Assy
	CfgAssembly  	= 0;							$ Null configuration Assy

