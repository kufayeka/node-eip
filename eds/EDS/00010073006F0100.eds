 	Param34 =			$ Autobaud
		"Enable",			$ For value = 0
		"Disable";			$ For value = 1

	Param35 =			$ MACID Switch
		"Not Changed",			$ For value = 0
		"Changed";			$ For value = 1

	Param37 =
		"Status",			$ For value = 0
		"Modes",
		"Diagnostic",
		"Beams";


[Groups]
Group1 = "DNet Configuration",5,		34,35,36,37,38;
Group2 = "Monitoring",4,			1,2,3,4;
Group3 = "Unit Config",11,			7,8,17,18,19,20,21,22,33,5,6;
Group4 = "Diagnotistics",12,			7,8,2,4,9,10,11,13,14,12,15,16;
Group5 = "Beam Data",14,			7,8,23,24,25,26,27,28,29,30,31,10,32,33;

[Assembly]

	VariantExa1 = 				$ variant used for POLL assembly selection
		"Variant",,,,,
		Param37,
		0x00, Assem1,
		0x01, Assem2,
		0x02, Assem3,
		0x03, Assem4;

	Assem1 =    "Status",
		"20 04 24 01 30 03",	$ Path is implied (Assy obj attr3)
		1,			$ total length in bytes
		0,			$ descriptor
		, ,			$ 
		1, Param48,		$ # bits, OSSD
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param41,		$ # bits, Fault - Lockout
		1, Param40,		$ # bits, Warning - diagnostic condition
		1, Param9,		$ # bits, sBeam Strength
		1, Param51;		$ # bits, sRestart Input


	Assem2 =    "Modes",
		"20 04 24 02 30 03",	$ Path is implied (Assy obj attr3)
		2,			$ total length in bytes
		0,			$ descriptor
		, ,
		1, Param48,		$ # bits, OSSD
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param41,		$ # bits, Fault - Lockout
		1, Param40,		$ # bits, Warning - diagnostic condition
		1, Param9,		$ # bits, sBeam Strength
		1, Param51,		$ # bits, sRestart Input
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param42,		$ # bits, EDM Mode
		1, Param43,		$ # bits, Reduced Resolution Mode
		1, Param44,		$ # bits, Fixed Blanking Mode
		1, Param45,		$ # bits, Floating Blanking Mode
		1, Param46,		$ # bits, Range Mode
		1, Param47;		$ # bits, Restart Mode
		

	Assem3 =    "Diagnostic",
		"20 04 24 03 30 03",	$ Path is implied (Assy obj attr3)
		3,			$ total length in bytes
		0,			$ descriptor
		, ,
		1, Param48,		$ # bits, OSSD
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param41,		$ # bits, Fault - Lockout
		1, Param40,		$ # bits, Warning - diagnostic condition
		1, Param9,		$ # bits, sBeam Strength
		1, Param51,		$ # bits, sRestart Input
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param42,		$ # bits, EDM Mode
		1, Param43,		$ # bits, Reduced Resolution Mode
		1, Param44,		$ # bits, Fixed Blanking Mode
		1, Param45,		$ # bits, Floating Blanking Mode
		1, Param46,		$ # bits, Range Mode
		1, Param47,		$ # bits, Restart Mode
		8, Param11;		$ sDiagnostic State

	
	Assem4 =    "Beams",
		"20 04 24 04 30 03",	$ Path is implied (Assy obj attr3)
		4,			$ total length in bytes
		0,			$ descriptor
		, ,
		1, Param48,		$ # bits, OSSD
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param41,		$ # bits, Fault - Lockout
		1, Param40,		$ # bits, Warning - diagnostic condition
		1, Param9,		$ # bits, sBeam Strength
		1, Param51,		$ # bits, sRestart Input
		1, Param52,		$ # bits, Reserved
		1, Param52,		$ # bits, Reserved
		1, Param42,		$ # bits, EDM Mode
		1, Param43,		$ # bits, Reduced Resolution Mode
		1, Param44,		$ # bits, Fixed Blanking Mode
		1, Param45,		$ # bits, Floating Blanking Mode
		1, Param46,		$ # bits, Range Mode
		1, Param47,		$ # bits, Restart Mode
		8, Param11,		$ sDiagnostic State
		8, Param10;		$ # bits, sCount of Beam Data


	Assem140 =    "Config Assembly",
		,                 $ Path is Null
		3,			$ total length in bytes
		0x0010,		$ not directly addressable
		,,			$ ",,"= reserved
		8,  Param8,		$ sUnit Select
		1,  Param23,	$ uBeam Data Mode 
		8,  Param37,	$ Input Assembly Type
		7,  ;			$ Pad bit 
