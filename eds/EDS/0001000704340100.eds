$ Electronic Data Sheet for 1791D Block I/O  (1791D-16B0)

[File]
DescText = "1791D Block I/O 16 Sink Input EDS File";
CreateDate = 06-16-1998;
CreateTime = 12:00:00;
ModDate = 10-31-2000;
ModTime = 15:35:00;
Revision = 1.021;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1076;
MajRev = 1;
MinRev = 1;
ProdName = "1791D-16B0 16 Sinking Input";
Catalog="1791D-16B0";
1_Icon=0001_CompactBlk.ico;

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x000D,			$ Poll connection can be used with COS or cyclic I/O.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

COSInfo=
0x0005,			$ COS connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

CyclicInfo=
0x0009,			$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
0;			$ There is no consuming connection.

Input1 =
2,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x000D,			$ Polled, COS, and Cyclic I/O device.
"16B0 Production Data",	$ Name of Connection.
6,			$ Path length.
"20 04 24 07 30 03",	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains the input data.";

[ParamClass]
MaxInst = 9;		$ 7 configurable and 2 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x7E;	$ The config assembly is instance #126 of assy obj.		

