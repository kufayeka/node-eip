                                        $ 29      = T->O priority: HIGH
                                        $ 30      = T->O priority: SCHEDULED
                                        $ 31      = T->O priority: reserved
                ,32,Assem150,           $ O->T RPI, size, format
                ,156,Assem104,          $ T->O RPI, size, format
                ,,                      $ proxy config size, format
                ,,                      $ target config size, format
                "Input Only Channel Based I/O w/Timestamps",    $ Connection Name
                "Non Aggregated, channel based I/O with input timestamps",    $ help string
                "20 04 24 7A 2C 96 2C 68";    $ Path









