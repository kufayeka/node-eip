$ Electronic Data Sheet for Point I/O  (1734-OB2E)
[File]

	DescText =    "PointIO 1734-OB2E";                   
	CreateDate =  06-15-1999;                            
	CreateTime =  14:25:38;                         
	ModDate     = 03-15-2006;
	ModTime     = 06:50:00;                            
	Revision =    1.4;                              

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 133;                                $ Product Code

	MajRev      = 1;                                  $ Major Rev
	MinRev      = 3;                                  $ Minor Rev
	VendName    = "Allen-Bradley Company, Inc.";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "PointIO 2pt 24Vdc Source Output Enhanced";
	Catalog     = "1734-OB2E";

[IO_Info]
	Default     = 0X0001;

	PollInfo    = 0X000F,                             $ compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ no consumed connection

      COSInfo =     0X0007,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      CyclicInfo =  0X000B,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

	Input1 =      1,                                  $ size = 1 byte
                    2,                                  $ 2 significant bits
                    0X000F,                             $ compatible with all conections
                    "1734-OB2E Produce Connection",     $ name string
                    6,                                  $ path length
                    "20 04 24 2A 30 03",                $ assy obj, inst 42d, attr 3
                    "Producing connection contains the status of the outputs";

	Output1 =     1,                                  $ size = 1 byte
                    2,                                  $ 2 significant bits
                    0X000D,                             $ compatible with polled connection
                    "1734-OB2E Consuming Connection",   $ name string
                    6,                                  $ path length
                    "20 04 24 20 30 03",                $ assy obj, inst 32d(0x20), attr 3
                    "Consuming connection contains state of the two outputs";

[ParamClass]
	MaxInst =     31;
	Descriptor =  0x09;                               $ Individual parameters are setable
                                                        $ Automaticly stored in EERPOM
	CfgAssembly = 0x67;                               $ the custom config assembly is 103d

[Params]
