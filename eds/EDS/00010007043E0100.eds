$ Electronic Data Sheet for ArmorBlock MaXum I/O  (1792D-0B4D)

[File]
DescText = "1792D-0B4D ArmorBlock MaXum I/O EDS File";
CreateDate = 06-11-1999;
CreateTime = 10:15:00;
ModDate = 08-09-1999;
ModTime = 15:00:00;
Revision = 1.1;     	$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1086;
MajRev = 1;
MinRev = 4;
ProdName = "1792D-0B4D 4Output";
Catalog = "1792D-0B4D";
1_Icon=0001_ArmorBlkMaXum4.ico;

[IO_Info]
Default = 0x0004;   	$ The default I/O type is COS I/O.

PollInfo =
0x000D,         	$ Poll connection can be used with COS or Cyclic I/O.
1,          		$ Input1 entry is the default input connection.
1;          		$ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ COS connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,         	$ Cyclic connection can be used with Polled I/O.
1,          		$ Input1 entry is the default input connection.
1;          		$ Output1 entry is the default output connection.

Input1 =
1,          		$ The size in bytes that this connection produces.
0,          		$ All bits of this connection are significant.
0x000D,         	$ Polled, COS and Cyclic I/O device
"0B4D Production Data",  $ Name of Connection.
6,          		$ Path length.
"20 04 24 73 30 03",    $ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 1 byte: bits 0-3=Output Faults 0-3,\nbits 4-5=reserved, 6=Output Power, bit 7=reserved.";

Output1 =
1,          		$ The size in bytes that this connection consumes.
4,          		$ Only the least 4 bits of this connection are significant.
0x000D,         	$ Polled, COS and Cyclic I/O device
"0B4D Consumption Data",  $ Name of Connection.
6,          		$ Path length.
"20 04 24 21 30 03",    $ Path to I/O Consumption Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-3 (Outputs 0-3 respectively).";
			 
[ParamClass]
MaxInst = 16;       	$ 11 configurable and 5 read-only parameters.
Descriptor =  0x09; 	$ Stub param instances in eeprom.
CfgAssembly = 0x77; 	$ Config assembly.      

[Params]
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param1 =        	$ Disable Autobaud
0,          		$ reserved
6,          		$ Link Path Size
"20 03 24 01 30 64",    $ Link Path to disable autobaud attribute.
0x0002,         	$ No support for settable path, scaling, scaling links, or
			$ real time update of value.  Value is gettable and 
			$ Settable.  Enumerated strings are supported.
4,          		$ Data Type - boolean
1,          		$ Data Size
"Autobaud",     	$ Parameter Name
"",         		$ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"Setting this parameter ON disables the Autobaud feature in the block. The\nchange occures after the next power up. Default is Enabled.",
0,1,0,          	$ Min, Max, and Default values
1,1,1,0,0,0,0,0,0;      $ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param2 =        	$ Output Fault State (group)
0,          		$ reserved
6,          		$ Link Path Size
"20 0F 24 02 30 01",    $ Link Path to DOG status attribute.
0x0002,         	$ No support for settable path, scaling, or scaling links.
			$ Value is gettable and settable. Enumerated strings are supported.
24,         		$ Data Type - 8 bit string
1,          		$ Data Size - (in bytes)
"Output Fault State",   $ Parameter Name
"",         		$ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"Checking these boxes causes the outputs to Hold Last State during a\ncommunications fault. Leaving them blank lets Parameter 3 determine whether\nthe outputs should be forced ON or OFF during a communications fault.",
0,15,0,         	$ Min, Max (max enumeration #), and Default values
1,1,1,0,0,0,0,0,0;      $ Not Used

