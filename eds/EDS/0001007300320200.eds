	Param3 = 0,
		6,"20 0A 24 01 30 71",	$ Link Path Size, Link Path
		0x0002,	 $ Descriptor
		8, 1,	$ Data Type, Data Size
		"RTD Type #0",
		"",
		"Select the RTD type that the input will be using.\nSome of the types are not valid and saved for future use.\n\nValid types are:\n - 100 Ohm Pt 385\n - 200 Ohm Pt 385\n - 100 Ohm Pt 3916\n - 200 Ohm Pt 3916\n - 10 Ohm Cu 427\n - 120 Ohm Ni 672\n - 100 Ohm Ni 618\n - 120 Ohm Ni 618",
		0,12,1,
		,,,,
		,,,,
		;

	Param4 = 0,
		6,"20 0A 24 02 30 71",	$ Link Path Size, Link Path
		0x0002,	 $ Descriptor
		8, 1,	$ Data Type, Data Size
		"RTD Type #1",
		"",
		"Select the RTD type that the input will be using.\nSome of the types are not valid and saved for future use.\n\nValid types are:\n - 100 Ohm Pt 385\n - 200 Ohm Pt 385\n - 100 Ohm Pt 3916\n - 200 Ohm Pt 3916\n - 10 Ohm Cu 427\n - 120 Ohm Ni 672\n - 100 Ohm Ni 618\n - 120 Ohm Ni 618",
		0,12,1,
		,,,,
		,,,,
		;

	Param5 = 0,
		6,"20 0A 24 01 30 8D",	$ Link Path Size, Link Path
		0x0002,	 $ Descriptor
		8, 1,	$ Data Type, Data Size
		"Temperature Scale #0",
		"",
		"Use the Temperature Scale parameter to select a predefined scale or a custom scale.\n'Custom Scale' allows the user to enter the scaling endpoint values.\nIf using 'Ohms' RTD Type, this parameter is ignored\n\nPredefined Scales: Celsius(C), Fahrenheit(F), Kelvin(K), and Rankine(R)\nScaling Endpoints for 'Custom Scale' (low & high):\n Ohms: 100 Ohms & 500 Ohms\n Pt RTDs: 0'C & 500 'C\n Cu RTD: 0'C & 250'C\n Ni RTDs: 0'C & 250'C",
		0,4,1,
		,,,,
		,,,,
		;

	Param6 = 0,
		6,"20 0A 24 02 30 8D",	$ Link Path Size, Link Path
		0x0002,	 $ Descriptor
		8, 1,	$ Data Type, Data Size
		"Temperature Scale #1",
		"",
		"Use the Temperature Scale parameter to select a predefined scale or a custom scale.\n'Custom Scale' allows the user to enter the scaling endpoint values.\nIf using 'Ohms' RTD Type, this parameter is ignored\n\nPredefined Scales: Celsius(C), Fahrenheit(F), Kelvin(K), and Rankine(R)\nScaling Endpoints for 'Custom Scale' (low & high):\n Ohms: 100 Ohms & 500 Ohms\n Pt RTDs: 0'C & 500 'C\n Cu RTD: 0'C & 250'C\n Ni RTDs: 0'C & 250'C",
		0,4,1,
		,,,,
		,,,,
		;

	Param7 = 0,
		6,"20 0A 24 01 30 04",	$ Link Path Size, Link Path
		0x0032,	 $ Descriptor
		4, 1,	$ Data Type, Data Size
		"Status #0",
		"",
		"Status of input channel.  This bit is used to indicate a general channel fault.\n\nPossible faults:\n- Over/Under Range\n- Level Alarm violation\n- Bad Calibration\n- Loss of Communications to the A/D.\n- Hardware Fault",
		0,1,0,
		,,,,
		,,,,
		;

