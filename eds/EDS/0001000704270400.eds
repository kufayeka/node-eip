   "On-to-Off Delay",      $ Parameter Name
   "",                     $ Units String
                           $ Help string follows
   "Input signal must be absent for this delay period before module detects the change.",
   0,4,                    $ Min, Max (max enumeration #) values
   0,                      $ Default value
   1,1,1,0,                $ Scaling factors
   0,0,0,0,                $ Scaling links
