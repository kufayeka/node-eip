$ Electronic Data Sheet for DeviceNet Starter Auxiliary

[File]
    DescText = "DSA 2 24V In / 1 Relay Out 22.5mm EDS File";
    CreateDate = 03-27-1998;
    CreateTime = 11:00:00;
    ModDate = 12-14-2005;
    ModTime = 14:30:00;
    Revision = 4.6;
    HomeURL = "http://www.ab.com/networks/eds/DN/0001000704270400.eds";

[Device]
    VendCode = 1;
    VendName = "Rockwell Automation/Allen-Bradley";
    ProdType = 7;
    ProdTypeStr = "General Purpose Discrete I/O";
    ProdCode = 1063;
    MajRev = 4;
    MinRev = 5;
    ProdName = "DSA 2/1 (100-DNY22R) 22.5 mm";
    Catalog = "100-DNY22R";
    Icon = "DSA_225.ico";

[IO_Info]
    1_COSetPathNotSupported = 1;
    1_COSetSizeNotSupported = 1;

    Default = 0x0001;      $ The default I/O type is polled I/O.

    PollInfo =
      0x0005,                $ OK to combine Poll and COS.
      1,                     $ Input1 entry is the default input connection.
      1;                     $ Output1 entry is the default output connection.

    COSInfo =
      0x0005,                $ OK to combine Poll and COS.
      1,                     $ Input1 entry is the default input connection.
      1;                     $ Output1 entry is the default output connection.

    Input1 =
      1,                     $ The size in bytes that this connection produces.
      0,                     $ All bits of this connection are significant.
      0x0005,                $ OK for Poll and/or COS
      "Status",              $ Name of Connection.
      6,                     $ Path length.
      "20 04 24 6A 30 03",   $ Path to I/O Production Assembly.
                             $ Help string follows
      "Contains input data at bits 0-1, output status at bit 2, and sensor source voltage status at bit 7.";
			
    Output1 =
      1,                     $ The size in bytes that this connection consumes.
      1,                     $ Only the least significant bit of this connection is used.
      0x0005,                $ OK for Poll and/or COS
      "Command",             $ Name of Connection.
      6,                     $ Path length.
      "20 04 24 1F 30 03",   $ Path to I/O Consumption Assembly.
                             
      "Contains data for one output.";   $ Help string
			 
[ParamClass]
    MaxInst = 11;          $ 6 configurable and 4 read-only parameters.
    Descriptor =  0x09;    $ Stub param instances in eeprom.
    CfgAssembly = 0x68;    $ The config assembly is instance #104 of assy obj.		

[Params]

Param1 =
   0,                      $ reserved
   6, "20 03 24 01 30 64", $ Link Path
   0X0002,                 $ Value is gettable and Settable.  Enumerated strings are supported.
   4, 1,                   $ Data Type - boolean, Data Size - 1 byte
   "Autobaud",             $ Parameter Name
   "",                     $ Units String
                           $ Help string follows
   "When ENABLED, allows the DSA to automatically detect\n"
   "and connect using the current network baud rate.\n"
   "When DISABLED, the DSA uses the baud rate selected in\n"
   "the DeviceNet object's baud rate attribute.\n"
   "This parameter's setting only takes effect after a\n"
   "module reset or at power-on.",
   0,1,                    $ Min, Max values
   0,                      $ Default value
   1,1,1,0,                $ Scaling factors
   0,0,0,0,                $ Scaling links
   0;                      $ Decimal Places

Param2 =
   0,                      $ reserved
   6, "20 0F 24 02 30 01", $ Link Path. 
   0X0002,                 $ Value is gettable and Settable. Enumerated strings are supported.
   2, 2,                   $ Data Type - unsigned int, Data Size - 2 bytes
   "Off-to-On Delay",      $ Parameter Name
   "",                     $ Units String
                           $ Help string follows
   "Input signal must be present for this delay period before module detects the change.",
   0,4,                    $ Min, Max (max enumeration #) values
   0,                      $ Default value
   1,1,1,0,                $ Scaling factors
   0,0,0,0,                $ Scaling links
   0;                      $ Decimal Places

