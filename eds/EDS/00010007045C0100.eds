[IO_Info]
	1_COSetPathNotSupported = 1;              $ Cnxn Obj does not support direct 

	Default    = 0x0004;                      $ default is COS

	PollInfo   = 0x000F, 1, 1;

	StrobeInfo = 0x000F, 1, 0;

	COSInfo    = 0x000F, 1, 1;

	CyclicInfo = 0x000F, 1, 1;

	Input1= 
	1,                                        $ size = 1 bytes
      0,                                        $ all bits significant
      0x000F,                                   $ compatible with all conections
	"Data",                                   $ name string
	6,                                        $ path length
      "20 04 24 04 30 03",                      $ assy obj, inst 04, attr 3
	"8 bits input points of the 1734D-IA8xOA8";

	Output1= 
	1,                                        $ size = 1 byte
      0,                                        $ all bits significant
      0x000D,                                   $ not compatable with strobe
	"Data",                                   $ name string
	6,                                        $ path length
      "20 04 24 22 30 03",                      $ assy obj, inst 34, attr 3
	"8 bits output points of the 1734D-IA8xOA8";

