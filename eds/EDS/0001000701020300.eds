$ Revision History
$ Revision	Date		Change
$	1.1	05Jan2004	From Terry's 1.0 which was likely a developed from the
$				OB4E in Neal's Series C release (1734-OB4E EDS rev 1.3?)
$				Added all things for CNet and ENet
$	1.2	06Jan2004	MINor REVision to 10
$	1.3	08Jan2004	IdleAction#6 was not in config group
$	2.1	30Nov2004	Added Assem124 - Changed CNXNs for 3rd Party
$	3.1	05May2007	Update to new DeviceNet Premier Integration EDS Guidelines
$				Removed Assem124 from Listen Only Connection

[File]
	DescText =    "PointIO 1734-OV8E/C";                   
	CreateDate  = 04-23-2003;
	CreateTime  = 12:00:00;
	ModDate     = 05-29-2007;
	ModTime     = 12:00:00;
	Revision    = 3.1;
	HomeURL     = "http://www.ab.com/networks/eds/DN/0001000701020300.eds";

[Device]
	VendCode    = 1;                                  $ Vendor Code
	ProdType    = 7;                                  $ Product Type
	ProdCode    = 258;                                $ Product Code

	MajRev      = 3;                                  $ Major Rev
	MinRev      = 15;                                 $ Minor Rev
	VendName    = "Allen-Bradley Company, Inc.";
	ProdTypeStr = "General Purpose Discrete I/O";
	ProdName    = "PointIO 8pt 24Vdc Sink Output Enhanced";
	Catalog     = "1734-OV8E/C";
	Icon        = "1734green.ico";
	1_RSNetWorx_DNetTool = "RSI.DeviceNet.EDSApplet";
	1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
     Class1 =      DeviceNet;

[IO_Info]
	1_COSetPathNotSupported = 1;                    $ Cnxn Obj does not support direct path setting

	Default =     0X0004;                           $ COS is default

	PollInfo    = 0X000F,                           $ compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      StrobeInfo =  0X000F,                             $ Compatable with all
                    1,                                  $ input 1
                    0;                                  $ No strobe connection here

      COSInfo =     0X0007,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      CyclicInfo =  0X000B,                             $ Compatable with all
                    1,                                  $ input 1
                    1;                                  $ output 1

      Input1 =      1,                                  $ size = 1 byte
                    8,                                  $ 8 significant bits
                    0X000F,                             $ compatible with all conections
                    "Status",			        $ name string
                    6,                                  $ path length
                    "20 04 24 2C 30 03",                $ assy obj(4), inst 44d(0x2C), attr 3
                    "Producing connection contains the status of the eight outputs";

      Output1 =     1,                                  $ size = 1 byte
                    8,                                  $ 8 significant bits
                    0X000D,                             $ compatible with polled connection
                    "Data",			        $ name string
                    6,                                  $ path length
                    "20 04 24 22 30 03",                $ assy obj(4), inst 34d(0x22), attr 3
                    "Consuming connection contains state of the eight outputs";

[ParamClass]
	MaxInst =     122;
	Descriptor =  0x09;                             $ Individual parameters are setable
                                                        $ Automaticly stored in EERPOM
	CfgAssembly = 0x7B;                             $ the custom config assembly is 123d(0x7B)

[Assembly]
        Assem34=    "Data",
                    "",                                 $ Path is (assy obj.(4), inst 34d(0x22), attr 3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param94;                        $ # bits, Group Value for Output

        Assem44=    "Status",
                    "",                                 $ Path is (assy obj(4), inst 44d(0x2C), attr 3)
                    1,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    8, Param95;                        $ # bits, Group Status of Output

        Assem123 =  "1734-OV8E Configuration Assembly",
                    "",                                 $ Path is (assy obj.(4) inst 123d(0x7B), attr 3)
                    8,                                  $ total length in bytes
                    0,,,                                $ no changes, ",,"= reserved
                    1,Param35,                          $ # bits, Fault State selection for output 0
                    1,Param37,                          $ # bits, Fault State selection for output 1
                    1,Param39,                          $ # bits, Fault State selection for output 2
                    1,Param41,                          $ # bits, Fault State selection for output 3
                    1,Param43,                          $ # bits, Fault State selection for output 4
                    1,Param45,                          $ # bits, Fault State selection for output 5
                    1,Param47,                          $ # bits, Fault State selection for output 6
                    1,Param49,                          $ # bits, Fault State selection for output 7

                    1,Param36,                          $ # bits, Fault Value selection for output 0
                    1,Param38,                          $ # bits, Fault Value selection for output 1
                    1,Param40,                          $ # bits, Fault Value selection for output 2
                    1,Param42,                          $ # bits, Fault Value selection for output 3
                    1,Param44,                          $ # bits, Fault Value selection for output 4
                    1,Param46,                          $ # bits, Fault Value selection for output 5
                    1,Param48,                          $ # bits, Fault Value selection for output 6
                    1,Param50,                          $ # bits, Fault Value selection for output 7

                    1,Param51,                          $ # bits, Idle State selection for output 0
                    1,Param53,                          $ # bits, Idle State selection for output 1
                    1,Param55,                          $ # bits, Idle State selection for output 2
                    1,Param57,                          $ # bits, Idle State selection for output 3
                    1,Param59,                          $ # bits, Idle State selection for output 4
                    1,Param61,                          $ # bits, Idle State selection for output 5
                    1,Param63,                          $ # bits, Idle State selection for output 6
                    1,Param65,                          $ # bits, Idle State selection for output 7

                    1,Param52,                          $ # bits, Idle Value selection for output 0
                    1,Param54,                          $ # bits, Idle Value selection for output 1
                    1,Param56,                          $ # bits, Idle Value selection for output 2
                    1,Param58,                          $ # bits, Idle Value selection for output 3
                    1,Param60,                          $ # bits, Idle Value selection for output 4
                    1,Param62,                          $ # bits, Idle Value selection for output 5
                    1,Param64,                          $ # bits, Idle Value selection for output 6
                    1,Param66,                          $ # bits, Idle Value selection for output 7

                    1,Param67,                          $ # bits, Enable Latched Alarms for output 0
                    1,Param68,                          $ # bits, Enable Latched Alarms for output 1
                    1,Param69,                          $ # bits, Enable Latched Alarms for output 2
                    1,Param70,                          $ # bits, Enable Latched Alarms for output 3
                    1,Param71,                          $ # bits, Enable Latched Alarms for output 4
                    1,Param72,                          $ # bits, Enable Latched Alarms for output 5
                    1,Param73,                          $ # bits, Enable Latched Alarms for output 6
                    1,Param74,                          $ # bits, Enable Latched Alarms for output 7
	  
	  	    1,Param75,                          $ # bits, Reset Mode for output 0
                    1,Param76,                          $ # bits, Reset Mode for output 1
                    1,Param77,                          $ # bits, Reset Mode for output 2
                    1,Param78,                          $ # bits, Reset Mode for output 3
                    1,Param79,                          $ # bits, Reset Mode for output 0
                    1,Param80,                          $ # bits, Reset Mode for output 1
                    1,Param81,                          $ # bits, Reset Mode for output 2
                    1,Param82,                          $ # bits, Reset Mode for output 3

                    8,;                                 $ pad byte (for word boundary)

    Assem124 =                  $ Private config in Forward Open, Module
        "3rd Party Private Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param121,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem125 =                  $ Private config in Forward Open, Module
        "Adapter Config Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        16,Param122,            $ Non-Logix Header (constant 0x7001)
        16,1_RackSize,          $ number of slots
        16,Param121,            $ configuration revision (only valid value is 1)
        16,;                    $ reserved - zeros

    Assem126 =                  $ O2T (output data)
        "Ouput Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        ,Assem34;               $ Assembly sent to module

    Assem127 =                  $ T2O (input data)
        "Input Data Assembly",
        ,                       $ Path
        ,                       $ Length in bytes
        ,                       $ descriptor
        ,,                      $ reserved
        32,,                    $ Fault bits
        ,Assem44;               $ Assembly passed from module

      ProxiedAssem1 =
                    "DC Output Rack Configuration Assembly",
                    "01 SLOT 20 04 24 78 30 03",        $ Path to Assy Obj (4) inst 120d attr 3
                    ,                                   $ total length in bytes
                    0x0000,                             $ descriptor
                    ,,                                  $ ",,"= reserved
                    1,Param88,                          $ Group Fault Action
                    1,Param89,                          $ Group Fault Value
                    1,Param90,                          $ Group Idle Action
                    1,Param91,                          $ Group Idle Value
                    1,Param92,                          $ Group Reset Mode
                    1,Param93,                          $ Group Latch Alarms
                    2,;                                 $ Pad bit

      ProxiedAssem3 = 
                    "Real Time Input Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem44;

      ProxiedAssem4 = 
                    "Real Time Output Format",
                    ,                                   $ No Path
                    ,                                   $ Length
                    0x0000,                             $ Descriptor
                    ,,                                  $ ",,"= reserved
                    8,Assem34;

