Group2="Input Configuration",2,3,4;
Group3="Output Configuration",4,6,7,8,9;
Group4="Inputs",1,5;
Group5="Outputs",1,10;


[EnumPar]
Param1="Enabled","Disabled";
Param2="Disabled","Enabled";
Param6="Use Fault Value","Hold Last State";
Param7="All Outputs Off","All Outputs On";
Param8="Use Idle Value","Hold Last State";
Param9="All Outputs Off","All Outputs On";



