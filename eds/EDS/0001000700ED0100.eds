[Assembly]
Revision = 2;

Assem5 = 
"Data",			$ Name of Connection.
"20 04 24 05 30 03", 	$ Path to I/O Production Assembly.
2,                      $ The size in bytes that this connection produces.
0, , ,			$ Not editable, not modular.
16, Param12;		$ 16 input values (byte 0, 1)

Assem35 = 
"Data",			$ Name of Connection.
"20 04 24 23 30 03", 	$ Path to I/O Production Assembly.
2,                      $ The size in bytes that this connection produces.
0, , ,			$ Not editable, not modular.
16, Param11;		$ 16 output values (byte 1, 2)

Assem126 = 
"Configuration Data",	$ Name of Connection.
,				$ Path to I/O Production Assembly.
,                      	$ The size in bytes that this connection produces.
0, , ,			$ Not editable, not modular.
,Param1,			$ Autobaud 					(bit 0, byte 0)
,Param2,			$ Quick Connect 				(bit 1, byte 0)
,Param9,			$ Idle Value 				(bit 4 byte 0)
,Param8,			$ Idle State 				(bit 5 byte 0)
,Param7,			$ Fault Value				(bit 6 byte 0)
,Param6,			$ Fault State				(bit 7 byte 0)
,Param3,			$ 16 bit Off to On Input filter 	(byte 1,2)
,Param4;			$ 16 bit On to Off Input filter 	(byte 3,4)



[Groups]
