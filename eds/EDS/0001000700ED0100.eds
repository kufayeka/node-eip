
[File]
DescText = "1732D 24Vdc 16 Config M12";
CreateDate = 10-19-2005;
CreateTime = 12:00:00;
ModDate = 10-19-2005;
ModTime = 12:00:00;
Revision = 1.004;         $ EDS revision.
HomeURL    = "http://www.ab.com/networks/eds/DN/0001000700ED0100.eds";

[Device]
VendCode = 1;
VendName = "Rockwell Automation/Allen-Bradley";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 237;		   
MajRev = 1;
MinRev = 9;
ProdName = "ArmorBlock 16 Input / 16 Output 24VDC M12 M12";
Catalog="1732D-16CFGM12M12";
Icon = "1732D_M12.ico";	
DNetQC=0b0000000000000001, 200; 	$ Quick Connect supported at power up. 200ms powerup time


[Device Classification]
Class1 = DeviceNet;


[IO_Info]
Default = 0x0004;       $ The default I/O type is COS I/O.

1_COSetPathNotSupported = 1;	$Paths not settable.
1_COSetSizeNotSupported = 1;	$Paths not settable.

PollInfo =
0x000D,                 $ Poll connection can be used with COS or Cyclic I/O.
1,                     	$ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ COS connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,                 $ Cyclic connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

Input1 =
2,                      $ The size in bytes that this connection produces.
0,                      $ All bits of this connection are significant.
0x000D,                 $ Polled, COS and Cyclic I/O device.
"Data",			$ Name of Connection.
6,                      $ Path length.
"20 04 24 05 30 03", 	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Input data in bits 0-15 (Inputs 0-15 respectively).";

Output1 =
2,                      $ The size in bytes that this connection consumes.
0,                      $ All bits of this connection are significant.
0x000D,                 $ Polled, COS and Cyclic I/O device.
"Data", 			$ Name of Connection.
6,                      $ Path length.
"20 04 24 23 30 03", 	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-15 (Outputs 0-15 respectively).";


[ParamClass]
MaxInst = 12;		$ 8 configurable, 2 non-displayable, and 2 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0;		$ Config assembly.
1_CfgAssembly = 0x7E;	$ Config assembly.

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
[Params]
Param1 =                $ Autobaud
0,                      $ reserved
6,                      $ Link Path Size
"20 03 24 01 30 64", 	$ Link Path to disable autobaud attribute.
0x0002,                 $ No support for settable path, scaling, or scaling links.
				$ Value is gettable and settable. Enumerated strings are supported.
0xC1,                   $ Data Type - boolean
1,                      $ Data Size - (in bytes)
"Autobaud",             $ Parameter Name
"",                     $ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"Setting this parameter ON disables the Autobaud feature in the block. The change occurs after the next power up. The default is Enabled.",
0,1,0,                  $ Min, Max, and Default values
1,1,1,0,0,0,0,0,0;      $ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param2 =                $ Quick Start
0,                      $ reserved
6,                      $ Link Path Size
"20 03 24 01 30 66", 	$ Link Path to disable quick start attribute.
0x0002,                 $ No support for settable path, scaling, or scaling links.
				$ Value is gettable and settable. Enumerated strings are supported.
0xC1,                   $ Data Type - boolean
1,                      $ Data Size - (in bytes)
"Quick Connect",        $ Parameter Name
"",                     $ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"Setting this parameter ON Enables the Quick Connect feature in the block. The change occurs after the next power up. The default is Disabled.",
0,1,0,                  $ Min, Max, and Default values
1,1,1,0,0,0,0,0,0;      $ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param3 = 	        	$ Input filter Off_to_On Delay selection
0,        			$ reserved
6,          		$ Link Path Size
"20 1D 24 01 30 06", 	$ Link Path to param instance.  The param instance decodes
				$ the enumerated parameter into engineering units (micro seconds).
0x0000,			$ No support for settable path, scaling, scaling links,
				$ or real time update of value.  Value is gettable and
				$ Settable.  Enumerated strings are supported.
0xC7,        		$ Data Type - unsigned int
2,        			$ Data Size - (in bytes)
"Off-To-On Delay",      $ Parameter Name
"us",				$ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"The input must be ON for the delay period specified in microseconds before the module detects the change. The minimum delay time is 0uS while the maximum delay time is 16000uS.",
0,16000,1000,          	$ Min, Max (max enumeration #), and Default values
1,1,1,0,0,0,0,0,0;	$ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param4 =      		$ Input filter On_to_Off Delay selection
0,          		$ reserved
6,        			$ Link Path Size
"20 1D 24 01 30 07", 	$ Link Path to param instance.  The param instance decodes
				$ the enumerated parameter into engineering units (micro seconds).
0x0000,     	      $ No support for settable path, scaling, scaling links,
				$ or real time update of value.  Value is gettable and
				$ Settable.  Enumerated strings are supported.
0xC7,        		$ Data Type - unsigned int
2,         			$ Data Size - (in bytes)
"On-To-Off Delay", 	$ Parameter Name
"us",           		$ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$

"The input must be OFF for the delay period specified in microseconds before the module detects the change. The minimum delay time is 0uS while the maximum delay time is 16000uS.",
0,16000,1000,          	$ Min, Max (max enumeration #), and Default values
1,1,1,0,0,0,0,0,0;  	$ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param5 =			$ Input  Values (0-15) for use by RSNetworx Parameter tab.
0,				$ reserved
6,				$ Link Path Size
"20 04 24 05 30 03",	$ Link Path to DIP Input values attribute.
0x0030,			$ No support for settable path, scaling, or scaling links.
				$ Value is gettable only. Enumerated strings are not
				$ supported.
0xD2,				$ Data Type - 16 bit string
2,				$ Data Size - (in bytes)
"Input Data (15-0)",	$ Parameter Name
"",				$ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This parameter is the current value of all Inputs, either On(1) or Off(0).",
0,65535,0,			$ Min, Max, and Default values
1,1,1,0,0,0,0,0,0;	$ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
Param6 =			$ Output Fault State (group)
0,				$ reserved
6,          		$ Link Path Size
"20 1E 24 01 30 07", 	$ Link Path to Discrete Input Group status attribute.
0x0002,			$ No support for settable path, scaling, or scaling links.
				$ Value is gettable and settable. Enumerated strings are supported.
0xC1,				$ Data Type - BOOL
1,				$ Data Size - (in bytes)
"Output Fault State",	$ Parameter Name
"",				$ Units String
			$$$$$$$$$$ Help string $$$$$$$$$$$
"Using the drop-down box, outputs can be set for hold last state or use the Output Fault Value parameter to determine whether the outputs should be forced ON or OFF during a communications fault.",
0,1,0,			$ Min, Max (max enumeration #), and Default values
1,1,1,0,0,0,0,0,0;	$ Not Used

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
