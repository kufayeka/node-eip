$ Electronic Data Sheet for Armor Block  (1792-OB8PLP)

[File]
DescText = "1792-OB8PLP Armor Block EDS File";
CreateDate = 09-19-97;
CreateTime = 12:00:00;
ModDate = 04-07-98;
ModTime = 12:00:00;
Revision = 1.2;     $ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1050;
MajRev = 1;
MinRev = 1;
ProdName = "1792-OB8PLP 8Output";
Catalog="1792-OB8PLP";
1_Icon=0001_Armorlp.ico;

[IO_Info]
Default = 0x0004;   $ The default I/O type is COS I/O.

PollInfo =
0x0007,     $ Polled, Strobed and COS I/O device.
1,          $ Input1 entry is the default input connection.
1;          $ Output1 entry is the default output connection.

StrobeInfo=
0x0007,     $ Polled, Strobed and COS I/O device.
1,          $ Input1 entry is the default input connection.
0;          $ There is no consuming connection.

COSInfo=
0x0007,     $ Polled, Strobed and COS I/O device.
1,          $ Input1 entry is the default input connection.
1;          $ Output1 entry is the default output connection.


Input1 =
1,                      $ The size in bytes that this connection produces.
0,                      $ All bits of this connection are significant.
0x0007,                 $ Polled, Strobed and COS I/O device.
"OB8PLP Production Data",$ Name of Connection.
6,                      $ Path length.
"20 04 24 64 30 03",    $ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains input data in byte 0 and status in  byte 1.";


Output1 = 
1,          $ The size in bytes that this connection consumes.
0,          $ All bits of this connection are significant.
0x0007,     $ Polled, Strobed and COS I/O device.
"OB8PLP Consumption Data",$ Name of Connection.
6,          $ Path length.
"20 04 24 22 30 03",    $ Path to I/O Consumption Assembly.
    $$$$$$$$$$ Help string $$$$$$$$$$$
"This connection contains data for eight outputs.";
             
[ParamClass]
MaxInst = 33;       $ 32 configurable and 1 read-only parameters.
Descriptor =  0x09; $ Stub param instances in eeprom.
CfgAssembly = 0x00; $ The config assembly is not supported.     

