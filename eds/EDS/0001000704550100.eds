$ Electronic Data Sheet for ArmorBlock MaXum I/O  (1792D-12BVT4D)

[File]
DescText = "1792D-12BVT4D ArmorBlock MaXum I/O EDS File";
CreateDate = 03-29-2000;
CreateTime = 14:30:00;
ModDate = 11-20-2000;
ModTime = 14:30:00;
Revision = 1.002;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1109;
MajRev = 1;
MinRev = 1;
ProdName = "1792D-12BVT4D 12Input/4Output";
Catalog = "1792D-12BVT4D";
1_Icon = "ArmorBlkMaXum8.ico";


[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x000D,			$ Poll connection can be used with COS or Cyclic I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ COS connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,			$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

Input1 =
4,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x000D,			$ Polled, COS and Cyclic I/O device.
"12BVT4D Production Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 6C 30 03",	$ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 4 bytes: Byte 1, bits 0-7=Inputs 0-7. Byte 2, Bits 0-3=Inputs 8-11. Bits 4-7=Input Short Circuit; Connectors A-D. Byte 3, bits 0&1=Input Short Circuit; Connectors E&F. Bits 2-7=Off Wire Detect; Connectors A-F. Byte 4, bits 0-3=Output Faults 0-3, bit 6=Output Power.";
			
Output1 =
1,			$ The size in bytes that this connection consumes.
0,			$ Only the least 4 significant bits of this 
			$ connection are used.
0x000D,			$ Polled, COS and Cyclic I/O device
"12BVT4D Consumption Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 21 30 03",	$ Path to I/O Consumption Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-3 (Outputs 0-3 respectively).";
			 
[ParamClass]
MaxInst = 32;		$ 19 configurable and 13 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x78;	$ Config assembly.		

