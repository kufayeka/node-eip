1,Param16,              $ Fault Enable Out 2        (byte 5 bit 2)
1,Param17,              $ Fault Enable Out 3        (byte 5 bit 3)
1,Param18,              $ Fault Enable Out 4        (byte 5 bit 0) 
1,Param19,              $ Fault Enable Out 5        (byte 5 bit 1)
1,Param20,              $ Fault Enable Out 6        (byte 5 bit 2)
1,Param21,              $ Fault Enable Out 7        (byte 5 bit 3)
4,Param26,              $ Produced I/O assembly selection             
4,Param25;              $ Consumed I/O assembly selection

                

