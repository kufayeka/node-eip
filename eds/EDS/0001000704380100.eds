[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1080;
MajRev = 1;
MinRev = 4;
ProdName = "1792D-8BIO8E 8In/8Out w/o Diags";
Catalog="1792D-8BIO8E";
1_Icon=0001_ArmorBlkMaXum8.ico;

[IO_Info]
Default = 0x0004;       $ The default I/O type is COS I/O.

PollInfo =
0x000D,                 $ Poll connection can be used with COS or Cyclic I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ COS connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,                 $ Cyclic connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

Input1 =
2,                      $ The size in bytes that this connection produces.
0,                      $ All bits of this connection are significant.
0x000D,                 $ Polled, COS and Cyclic I/O device.
"8BIO8E Production Data",  $ Name of Connection.
6,                      $ Path length.
"20 04 24 71 30 03",    $ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 2 bytes: Byte 1, bits 0-7=Inputs 0-7. Byte 2, bits 0-3 are\nreserved. Bit 4=Output Faults. Bits 5 and 6 are reserved. Bit 7=Input Short Circuit.";

Output1 =
1,                      $ The size in bytes that this connection consumes.
0,                      $ All bits of this connection are significant.
0x000D,                 $ Polled, COS and Cyclic I/O device.
"8BIO8E Consumption Data",  $ Name of Connection.
6,                      $ Path length.
"20 04 24 22 30 03",    $ Path to I/O Production Assembly.
			$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-7 (Outputs 0-7 respectively).";

[ParamClass]
MaxInst = 10;		$ 7 configurable and 3 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x7F;	$ Config assembly.

