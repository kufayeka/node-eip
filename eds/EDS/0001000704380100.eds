0,                      $ reserved
6,                      $ Link Path Size
"20 03 24 01 30 64",    $ Link Path to disable autobaud attribute.
0x0002,                 $ No support for settable path, scaling, or scaling links.
			$ Value is gettable and settable. Enumerated strings are
			$ supported.
4,                      $ Data Type - boolean
1,                      $ Data Size - (in bytes)
"Autobaud",             $ Parameter Name
"",                     $ Units String
