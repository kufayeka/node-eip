	VendName = "Allen-Bradley Company, Inc.";
	ProdType = 115;
	ProdTypeStr = "Miscellaneous I/O";
	ProdCode= 55;
	MajRev = 2;
	MinRev = 5;
	ProdName = "PointIO 2pt Analog Voltage Input";
