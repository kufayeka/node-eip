$ Electronic Data Sheet for Block I/O (1799D-24B8EMMC)

[File]
DescText = "1799D-24B8EMMC Block I/O EDS File";
CreateDate = 07-1-1998;
CreateTime = 12:00:00;
ModDate = 08-10-1999;
ModTime = 11:16:00;
Revision = 1.3;		$ EDS revision.

[Device]
VendCode = 1;
VendName = "Allen-Bradley Company, Inc.";
ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1084;
MajRev = 1;
MinRev = 1;

ProdName = "24 IN / 8 OUT, 24VDC";
Catalog = "1799D-24B8EMMC";

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x0005,			$ Polled and COS I/O device.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ Polled and COS I/O device.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

Input1 =
3,		        $ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x0005,			$ Polled and COS I/O device.
"24B8EMMC Production Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 73 30 03",	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 3 bytes: Byte 1, bits 0-7=Inputs 0-7.\nByte 2, bits 8-15=Inputs 8-15.\nByte 3, bits 16-23=Inputs 16-23.";
			
Output1 =
1,			$ The size in bytes that this connection consumes.
0,			$ All bits of this connection are significant. 
0x0005,			$ Polled and COS I/O device.
"24B8EMMC Consumption Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 22 30 03",	$ Path to I/O Consumption Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0-7 (Outputs 0-7 respectively).";
			 
[ParamClass]
MaxInst = 10;		$ 7 configurable and 3 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x68;	$ The config assembly is instance #104 of assy obj.		

