$ Electronic Data Sheet for CompactLogix (1769-L16ER/L18ER/L18ERM)

$ Revision History
$ Revision	Date		Change
$ 1.1		26Aug2010	Initial Release
$ 1.2		31May2011	ProdName,Catalog,IO_Info
$ 1.3		8July2011	Remove Input1 & Output1 help string
$ 1.4		29July2011	Remove Modular session
$ 1.5		23May2012	Replace Catalog from NULL to 1769-L1 IB16XOB16

[File]
    DescText    = "Embedded Discrete Combo 16PT Input & 16PT Output";
    CreateDate  = 08-20-2010;
    CreateTime  = 12:00:00;
    ModDate     = 07-29-2011;
    ModTime     = 12:00:00;
    Revision    = 1.4;
    HomeURL     = "http://www.ab.com/networks/eds/XX/0001000704741500.eds";

[Device]
    VendCode = 1;                       $ Vendor Code
    ProdType = 7;                       $ Product Type
    ProdCode = 0x0474;                  $ Product Code (0x0474)

    MajRev = 21;  $ Major Rev
    MinRev = 1;                         $ Minor Rev

    VendName    = "Rockwell Automation/Allen-Bradley";
    ProdTypeStr = "General Purpose Discrete I/O";
    ProdName    = "1769-L1y Embedded 16PT Combo I/O";
    Catalog     = "1769-L1 IB16XOB16";
    Icon	    = "1769-L1yEIO.ico";

    1_RSNetWorx_NoAutoEnter = "Yes";

[Device Classification]
    Class1 = DeviceNet;

[IO_Info]

    Default  =  0x0004;                 $ The default I/O type is COS I/O.

    PollInfo =  0x000F,                 $ Poll connection can be used with all connection.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.

    StrobeInfo= 0x000F,                 $ Strobe connection can be used with all connection.
                1,                      $ Input1 entry is the default input connection.
                0;                      $ No strobe connection here

    COSInfo  =  0x0007,                 $ COS connection can be used with Polled I/O & Strobe I/O.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.

    CyclicInfo =0x000B,                 $ Cyclic connection can be used with Polled I/O & Strobe I/O.
                1,                      $ Input1 entry is the default input connection.
                1;                      $ Output1 entry is the default output connection.


    Input1 =    2,                      $ The size in bytes that this connection produces.
                16,                     $ 16 bits of this connection are significant.
                0x000F,                 $ Compatible with all conections
                "Data",                 $ Name of Connection.
                7,                      $ Path length.
                "21 04 00 24 05 30 03", $ Assy obj(4), inst 05d(0x05), attr 3
		"";                             $ Help String 

    Output1 =   2,                      $ The size in bytes that this connection consumes.
                16,                     $ 16 bits of this connection are significant.
                0x000D,                 $ Compatible with Polled and COS I/O connection
                "Data",                 $ Name of Connection.
                7,                      $ Path length.
                "21 04 00 24 23 30 03", $ Assy obj(4), inst 35d(0x23), attr 3
		"";                             $ Help String
