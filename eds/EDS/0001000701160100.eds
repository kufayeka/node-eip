                2,                      $ Data Size - (in bytes)
                "Off-to-On Delay",      $ Parameter Name
                "us",                   $ Units String
                                        $ $$$$$$$$$ Help string $$$$$$$$$$$
                "Signal must be present for this delay period before module detects the change.",
                0,65535,2000,                  $ Min, Max , and Default values
                ,,,,
