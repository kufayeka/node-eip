$ Electronic Data Sheet for Embedded I/O (1799-D16U16VAGL)

[File]
        DescText = "1799-D16U16VAGL Embedded I/O EDS File";
        CreateDate = 03-09-2006;
        CreateTime = 12:00:00;
        ModDate = 01-09-2008;
        ModTime = 14:50:00;
        Revision = 1.03;
        HomeURL = "http://www.ab.com/networks/eds/DN/0001000701160100.eds";

[Device]
        VendCode = 1;
        VendName = "Rockwell Automation/Allen-Bradley";
        ProdType = 7;
        ProdTypeStr = "General Purpose Discrete I/O";
        ProdCode = 278;
        MajRev = 1;
        MinRev = 1;

        ProdName = "1799-D16U16VAGL 16 IN / 16 SNK OUT w/Analog";
        Catalog = "1799-D16U16VAGL";
        Icon = "circuitboard.ico";
        DNetQC = 0B0000000000000001,200;            $ Quick Connect supported at power up. 200ms powerup time.

        1_RSNetWorx_DNetTool = "LeoApp.LeoDevice";
        1_RSNetWorx_DNetToolEx = "1.00.00", "LeoApp.LeoDevice", "7.00.00", "RSI.DeviceNet.EDSApplet.1";
        1_DNetEDSAppletPlugIn = "7.00.00", "DeviceLogixPlugIn.EDSAppletPlugIn.1";

[Device Classification]
        Class1 = DeviceNet;

[IO_Info]
        Default = 0x0004;       $ The default I/O type is COS I/O.

        PollInfo =
                0x000D,         $ Poll connection can be used with COS or cyclic I/O.
                1,              $ Input1 entry is the default input connection.
                1;              $ Output1 entry is the default output connection.

        COSInfo =
                0x0005,         $ COS connection can be used with Polled I/O.
                1,              $ Input1 entry is the default input connection.
                1;              $ Output1 entry is the default output connection.

        CyclicInfo =
                0x0009,         $ Cyclic connection can be used with Polled I/O.
                1,              $ Input1 entry is the default input connection.
                1;              $ Output1 entry is the default output connection.

        Input1 =
                11,                     $ The size in bytes that this connection produces.
                0,                      $ All bits of this connection are significant.
                0x000D,                 $ Polled and COS I/O device.
                "Data",     		    $ Name of Connection.
                7,
                "21 04 00 24 9B 30 03", $ Path length, Path to I/O Production Assembly.
                "This contains 11 bytes: Byte 1, bits 0-7=Inputs 0-7. Byte 2, bits 0-7=Inputs 8-15.\n"
                "Byte 3, bit 0=Output Fault 0, bit 1= Output Fault 1, bit 2 = Output Open Wire 0, \n"
                "bit 3 = Output Open Wire 1, bit 6 = Logic Enabled.  Byte 4=Analog Input Channel 0 data(LSB). \n"
                "Byte 5=Analog Input Channel 0 data(MSB). Byte 6=Analog Input Channel 1 data(LSB). \n"
                "Byte 7=Analog Input Channel 1 data(MSB). Byte 8=Analog Input Channel 0 Status. \n"
                "Byte 9=Analog Input Channel 1 Status. Byte 10=Analog Output Channel 0 Status. \n"
                "Byte 11=Analog Output Channel 1 Status."
                "";    $ Help String

        InputExa1 =
                ,                       $ Size from AssemN
                ,                       $ Bits determined by AssemN member list
                0x000D,                 $ Poll, COS, Cyclic
                ,                       $ Name String  from AssemN
                ,                       $ Path Size not applicable
                VariantExa1,            $ Variant for choosing Output Assem
                ;                       $ Help string not applicable

        Output1 =
                6,                      $ The size in bytes that this connection consumes.
                0,                      $ All bits of this connection are significant.
                0x000D,                 $ Polled and COS I/O device.
                "Data",           		$ Name of Connection.
                7,
                "21 04 00 24 9F 30 03", $ Path length, Path to I/O Consumption Assembly.
                "This contains 6 bytes: Byte 1, bits 0-7=Outputs 0-7. Byte 2, bits 0-7=Outputs 8-15.\n"
                "Byte 3=Analog Output Channel 0 data(LSB). Byte 4=Analog Output Channel 0 data(MSB). \n"
                "Byte 5=Analog Output Channel 1 data(LSB). Byte 6=Analog Output Channel 1 data(MSB).\n"
                "";    $ Help string

        OutputExa1 =
                ,                       $ Size from AssemN
                ,                       $ Bits determined by AssemN member list
                0x000D,                 $ Poll, COS, Cyclic
                ,                       $ Name String  from AssemN
                ,                       $ Path Size not applicable
                VariantExa2,            $ Variant for choosing Output Assem
                ;                       $ Help string not applicable

        1_COSetPathNotSupported = 1;    $ Paths not settable.
        1_COSetSizeNotSupported = 1;    $ Paths not settable.

[ParamClass]
        MaxInst = 110;                  $ ?? configurable and ? read-only parameters.
        Descriptor = 0x0009;            $ Bit 0: 1= parameter instances exist
                                        $ Bit 1: 0= not full
                                        $ Bit 2: 0= NVS command not needed
                                        $ Bit 3: 1= Automaticly stored in EERPOM

        CfgAssembly = 0;                $ The config assembly is instance #176 of assy obj.
        1_CfgAssembly = 0xB0;           $ Config assembly.

[Params]
    $ $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
        Param1 =                        $ Disable Autobaud
                0,                      $ Reserved
                7,"21 03 00 24 01 30 64",    $ Link Path Size, Link Path
                0x0002,                 $ Descriptor
                0xC1,                   $ Data Type - Boolean
                1,                      $ Data Size
                "Autobaud",             $ Parameter Name
                "",                     $ Units String
                "Setting this parameter ON disables the Autobaud feature in the block. The\n"
                "change occures after the next power up. Default is Enabled.",    $ Help String
                0,1,0,                  $ Min, Max, and Default values
                ,,,,
                ,,,,
                0;                      $ Not Used
        Enum1 =
                0,"AutoBaud Active",
                1,"AutoBaud Inactive";

