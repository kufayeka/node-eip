	Param5 = 0,
		6,"20 0A 24 01 30 8D",	$ Link Path Size, Link Path
		0x0002,	 $ Descriptor
		0xC6, 1,	$ Data Type, Data Size
		"Temperature Scale #0",
		"",
		"Use the Temperature Scale parameter to select a predefined scale or a custom scale.\n'Custom Scale' allows the user to enter the scaling endpoint values.\nIf using 'Ohms' RTD Type, this parameter is ignored\n\nPredefined Scales: Celsius(C), Fahrenheit(F), Kelvin(K), and Rankine(R)\nScaling Endpoints for 'Custom Scale' (low & high):\n Ohms: 100 Ohms & 500 Ohms\n Pt RTDs: 0'C & 500 'C\n Cu RTD: 0'C & 250'C\n Ni RTDs: 0'C & 250'C",
		0,4,1,
		,,,,
		,,,,
		;

	Enum5 =	0,"Custom Scale",
		1,"Deg C",
		2,"Deg F",
		3,"Deg K",
		4,"Deg R";

	Param6 = 0,
		6,"20 0A 24 02 30 8D",	$ Link Path Size, Link Path
		0x0002,	 $ Descriptor
		0xC6, 1,	$ Data Type, Data Size
		"Temperature Scale #1",
		"",
		"Use the Temperature Scale parameter to select a predefined scale or a custom scale.\n'Custom Scale' allows the user to enter the scaling endpoint values.\nIf using 'Ohms' RTD Type, this parameter is ignored\n\nPredefined Scales: Celsius(C), Fahrenheit(F), Kelvin(K), and Rankine(R)\nScaling Endpoints for 'Custom Scale' (low & high):\n Ohms: 100 Ohms & 500 Ohms\n Pt RTDs: 0'C & 500 'C\n Cu RTD: 0'C & 250'C\n Ni RTDs: 0'C & 250'C",
		0,4,1,
		,,,,
		,,,,
		;

	Enum6 =	0,"Custom Scale",
