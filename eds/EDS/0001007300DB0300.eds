		0x0032,	 $ Descriptor
		0xC1, 1,	$ Data Type, Data Size
		"Status #0",
		"",
		"Status of input channel.  This bit is used to indicate a general channel fault.\n\nPossible faults:\n- Over/Under Range\n- Level Alarm violation\n- Bad Calibration\n- Loss of Communications to the A/D.\n- Hardware Fault",
		0,1,0,
		,,,,
		,,,,
		;

	Enum7 = 0,"Normal Operation", 1,"CHANNEL FAULT";

