		6,"20 0A 24 01 30 71",	$ Link Path Size, Link Path
		0x0002,	 $ Descriptor
		0xC6, 1,	$ Data Type, Data Size
		"RTD Type #0",
		"",
		"Select the RTD type that the input will be using.\nSome of the types are not valid and saved for future use.\n Valid types are ohms and 100 Ohm Pt 385",
		0,1,1,
		,,,,
		,,,,
		;

	Enum3 =	0, "Ohms",
		1, "100ohm Pt 385";

	Param4 = 0,
