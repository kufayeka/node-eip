	Catalog     = "1734D-IB8XOB8E";
	Icon	    = "1734blue-green.ico";

[IO_Info]
	1_COSetPathNotSupported = 1;              $ Cnxn Obj does not support direct 

	Default    = 0x0004;                      $ default is COS

	PollInfo   = 0x000F, 1, 1;

	StrobeInfo = 0x000F, 1, 0;

	COSInfo    = 0x0007, 1, 1;

	CyclicInfo = 0x000B, 1, 1;

Input1 = 
	2,                                        $ size = 2 bytes
      0,                                        $ all bits significant
      0x000F,                                   $ compatible with all conections
	"Data - with Status",                     $ name string
	6,                                        $ path length
      "20 04 24 65 30 03",                      $ assy obj, inst 65, attr 3
	"8 bits input points and 8 bits output Status of the 1734D-IB8XOB8E";

Output1 = 
	1,                                        $ size = 1 byte
      0,                                        $ all bits significant
      0x000D,                                   $ not compatable with strobe
	"Data",                                   $ name string
	6,                                        $ path length
      "20 04 24 22 30 03",                      $ assy obj, inst 34, attr 3
	"8 bits output points of the 1734D-IB8XOB8E";

