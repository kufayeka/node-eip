ProdType = 7;
ProdTypeStr = "General Purpose Discrete I/O";
ProdCode = 1071;
MajRev = 1;
MinRev = 1;
ProdName = "1792D-2BVA2D 2In w/2Alarms/2Out";
Catalog = "1792D-2BVA2D";
1_KeepMinorRev = "Yes";
1_Icon=0001_ArmorBlkMaXum4.ico;

[IO_Info]
Default = 0x0004;	$ The default I/O type is COS I/O.

PollInfo =
0x000D,			$ Polled connection can be used with COS or Cyclic I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

COSInfo=
0x0005,                 $ COS connection can be used with Polled I/O.
1,                      $ Input1 entry is the default input connection.
1;                      $ Output1 entry is the default output connection.

CyclicInfo=
0x0009,			$ Cyclic connection can be used with Polled I/O.
1,			$ Input1 entry is the default input connection.
1;			$ Output1 entry is the default output connection.

Input1 =
2,			$ The size in bytes that this connection produces.
0,			$ All bits of this connection are significant.
0x000D,			$ Polled, COS and Cyclic I/O device.
"2BVA2D Production Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 6A 30 03",	$ Path to I/O Production Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains 2 bytes: Byte 1, bits 0&1=Inputs 0&1. Bits 2&3=Alarms 0&1.\nBits 4&5=Input Short Circuit; Connectors A&B.\nBits 6&7=Off Wire Detect: Connectors A&B.\nByte 2, bits 0&1=Output Faults 0&1. Bit 6=Output Power.";
			
Output1 =
1,			$ The size in bytes that this connection consumes.
0,			$ Only the least 2 significant bits of this 
			$ connection are used.
0x000D,			$ Polled, COS and Cyclic I/O device.
"2BVA2D Consumption Data",  $ Name of Connection.
6,			$ Path length.
"20 04 24 20 30 03",	$ Path to I/O Consumption Assembly.
	$$$$$$$$$$ Help string $$$$$$$$$$$
"This contains Output data in bits 0&1 (Outputs 0&1 respectively).";
			 
[ParamClass]
MaxInst = 22;		$ 13 configurable and 9 read-only parameters.
Descriptor =  0x09;	$ Stub param instances in eeprom.
CfgAssembly = 0x78;	$ Config assembly.		

