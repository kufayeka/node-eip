Param1 =			$ Disable Autobaud
0,					$ reserved
7,					$ Link Path Size
"21 03 00 24 01 30 64",	$ Link Path to disable autobaud attribute.
0x0002,				$ No support for settable path, scaling, scaling links, or
					$ real time update of value.  Value is gettable and 
					$ Settable.  Enumerated strings are supported.
0xC1,				$ Data Type - boolean
1,					$ Data Size
"Autobaud",			$ Parameter Name
"",					$ Units String
	$$$$$$$$$$ Help string $$$$$$$$$$$
"Setting this parameter ON disables the Autobaud feature in the block. The\nchange occures after the next power up. Default is Enabled.",
0,1,0,				$ Min, Max, and Default values
,,,,,,,,;			$ Not Used

