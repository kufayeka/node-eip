[Groups]
Group1="Configuration",8,1,2,3,6,7,8,9,10;
Group2="Monitoring",3,4,5,11;


[EnumPar]
Param1="AutoBaud Active","AutoBaud Inactive";
Param2="0 ms","2 ms","4 ms","8 ms","16 ms";
Param3="0 ms","2 ms","4 ms","8 ms","16 ms";
Param6="Input data with Fault Status","Input Data ONLY";
Param7="Use Fault Value","Hold Last State";
Param8="Reset Outputs","Turn Outputs On";
Param9="Use Idle Value","Hold Last State";
Param10="Reset Outputs","Turn Outputs On";
Param11="Output Group 0 Fault","Output Group 1 Fault";
Param12="Quick Connect Disabled","Quick Connect Enabled";

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$


[Assembly]
Revision = 1;

Assem148 = 
"Data - with Status",       $ Name of Connection.
"20 04 24 94 30 03", 	                        $ Path to I/O Production Assembly.
3,                          $ The size in bytes that this connection produces.
0, , ,			            $ Not editable, not modular.
8, Param4,			        $ 8 input values (byte 0)
8, Param5,			        $ 8 input values (byte 0)
1, Param40,					$ Output Fault Status 0
1, Param41,					$ Output Fault Status 1
6, ;			        	$

Assem5 = 
"Data",                     $ Name of Connection.
"20 04 24 05 30 03", 	    $ Path to I/O Production Assembly.
2,                          $ The size in bytes that this connection produces.
0, , ,			            $ Not editable, not modular.
8, Param4,			        $ 8 input values (byte 0)
8, Param5;			        $ 8 input values (byte 0)

Assem37 =               $0x25
"Data",			        $ Name of Connection.
"21 04 00 24 25 30 03", $ Path to I/O Consume Assembly.
2,                      $ The size in bytes that this connection consumes.
0, , ,			        $ Not editable, not modular.
8, Param48,			    $ 8 output values (byte 0)
8, Param48;			    $ 8 output values (byte 0)
 
Assem169 =              $0xA8
"Configuration Data",	$ Name of Connection.
,			        	$ Path to Assembly.
6,                      $ The size in bytes.
0, , ,			        $ Not editable, not modular.
1,Param1,			    $ Autobaud 					(byte 0 bit 0)
1,Param12,			    $ Quick Connect 			(byte 0 bit 1)
2,,			    		
1,Param7,			    $ Fault State 	    		(byte 0 bit 4)
1,Param8,			    $ Fault Value 	    		(byte 0 bit 5)
1,Param9,			    $ Idle State 0	    		(byte 0 bit 6)
1,Param10,			    $ Idle Value 0	    		(byte 0 bit 7)
16,Param49,			    $ Off to On Input filter 	(byte 1,2)
16,Param50,			    $ On to Off Input filter 	(byte 3,4)
8,Param56;			    $ Assemblies 		        (byte 5)

VariantExa1 =
    ,,,,,
    Param6,
    0x00, Assem148,
    0x01, Assem5;
 

